[Unit]
Description=Sadeem Capture Resident Pre-warmed Daemon
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/share/sadeem-capture/app.py --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
