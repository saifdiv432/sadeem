[org/gnome/desktop/interface]
font-name='Vazirmatn 11'
document-font-name='Noto Sans Arabic 11'
accent-color='red'
color-scheme='default'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/sadeem/sadeem-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/sadeem/sadeem-dark.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/sadeem/sadeem-dark.jpg'
picture-options='zoom'

[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['adwaita-lock-clock@saifeldin.osama', 'rumman-helper@rumman.app', 'arcmenu@arcmenu.com', 'clipboard-indicator@tudmotu.com', 'dash-to-panel@jderose9.github.com', 'emoji-copy@felipeftn', 'sadeem-desktop-helper@sadeem.os', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'light-style@gnome-shell-extensions.gcampax.github.com']

[org/gnome/shell/extensions/user-theme]
name='Saifdora-Burgundy'

[org/gnome/desktop/sound]
theme-name='sadeem'
event-sounds=true
input-feedback-sounds=false

[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'

[org/gnome/shell/keybindings]
toggle-message-tray=['<Super>m']
show-screenshot-ui=['Print']
screenshot=@as []

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record]
name='Stop Screen Recording'
command='/usr/bin/sadeem-capture --stop-recording'
binding='<Shift>Print'
