[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/sadeem/sadeem-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/sadeem/sadeem-dark.jpg'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/sadeem/sadeem-dark.jpg'

[org.gnome.desktop.wm.preferences]
button-layout=':minimize,maximize,close'

[org.gnome.shell]
enabled-extensions=['adwaita-lock-clock@saifeldin.osama', 'rumman-helper@rumman.app', 'sadeem-menu@sadeem.os', 'clipboard-indicator@tudmotu.com', 'dash-to-panel@jderose9.github.com', 'emoji-copy@felipeftn', 'sadeem-desktop-helper@sadeem.os', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'light-style@gnome-shell-extensions.gcampax.github.com']

[org.gnome.shell.extensions.dash-to-panel]
panel-element-positions-monitors-sync=true
show-apps-icon-file=''

[org.gnome.shell.keybindings]
toggle-message-tray=['<Super>m']
show-screenshot-ui=['Print']
screenshot=@as []
screenshot-window=@as []

[org.gnome.settings-daemon.plugins.media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record/']

[org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record/]
name='Stop Screen Recording'
command='/usr/bin/sadeem-capture --stop-recording'
binding='<Shift>Print'

[org.gnome.shell.extensions.clipboard-indicator]
enable-keybindings=true
open-at-cursor=true
toggle-menu=['<Super>v']

[org.gnome.shell.extensions.emoji-copy]
active-keybind=true
emoji-keybind=['<Super>period']
window-location='cursor'
