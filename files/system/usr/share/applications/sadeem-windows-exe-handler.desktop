[Desktop Entry]
Type=Application
Name=Windows App Runner
Name[ar]=مشغّل برامج ويندوز — سديم
Name[en]=Windows App Runner (Sadeem)
Name[fr]=Exécuteur d'applications Windows (Sadeem)
