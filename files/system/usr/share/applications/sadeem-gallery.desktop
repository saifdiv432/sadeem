[Desktop Entry]
Name=Sadeem Gallery
Name[ar]=معرض سديم
GenericName=Media Gallery & Photo Editor
GenericName[ar]=معرض وسائط ومحرر صور
Comment=Chronological media gallery, fast image & RAW viewer, and built-in photo editor
Comment[ar]=معرض وسائط زمني ومستعرض صور وملفات RAW ومحرر صور مدمج لنظام سديم
Exec=/usr/bin/sadeem-gallery %F
Icon=sadeem-gallery
Terminal=false
Type=Application
Categories=Graphics;Photography;Viewer;2DGraphics;RasterGraphics;
Keywords=photos;gallery;viewer;editor;raw;exif;crop;markup;pictures;معرض;وسائط;صور;تعديل;محرر;خام;سديم;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/heif;image/heic;image/avif;image/jxl;image/svg+xml;image/tiff;image/bmp;image/x-icon;image/x-dcraw;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-sony-arw;image/x-adobe-dng;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;
StartupNotify=true
StartupWMClass=org.sadeem.Gallery
X-Purism-FormFactor=Workstation;Mobile;
