#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Sadeem Updater (sadeem-updater)
Lightweight graphical system, Flatpak, and container updater for Sadeem 45.
Built with Python 3, GTK 4, and Libadwaita.
"""

import sys
import os
import subprocess
import threading
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio, Pango

