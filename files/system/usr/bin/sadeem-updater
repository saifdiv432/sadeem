def get_locale_code():
    raw = os.environ.get("LANG", "en").strip()
    code = raw.split(".")[0].split("_")[0].lower()
    return code if code in TRANSLATIONS else "en"

class SadeemUpdaterWindow(Adw.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.lang = get_locale_code()
        self.t = TRANSLATIONS.get(self.lang, TRANSLATIONS["en"])

        self.set_title(self.t["title"])
        self.set_default_size(580, 680)

        self.reboot_required = False
        self.is_running = False

        self.build_ui()
        self.check_box_availability()

    def build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        # Header Bar
        header = Adw.HeaderBar()
        main_box.append(header)

        # Scrolled container
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        main_box.append(scrolled)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(600)
        clamp.set_tightening_threshold(450)
        scrolled.set_child(clamp)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        content_box.set_margin_top(16)
        content_box.set_margin_bottom(24)
        content_box.set_margin_start(20)
        content_box.set_margin_end(20)
        clamp.set_child(content_box)

        # App banner header
        banner_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        banner_box.set_halign(Gtk.Align.CENTER)

        icon_image = Gtk.Image.new_from_icon_name("sadeem-updater")
        icon_image.set_pixel_size(72)
        banner_box.append(icon_image)

        title_lbl = Gtk.Label(label=self.t["title"])
        title_lbl.add_css_class("title-1")
        title_lbl.set_wrap(True)
        banner_box.append(title_lbl)

        desc_lbl = Gtk.Label(label=self.t["desc"])
        desc_lbl.add_css_class("dim-label")
        desc_lbl.set_wrap(True)
        desc_lbl.set_justify(Gtk.Justification.CENTER)
        banner_box.append(desc_lbl)

        content_box.append(banner_box)

        # Target Switches Group
        pref_group = Adw.PreferencesGroup()
        pref_group.set_title(self.t["group_targets"])
        content_box.append(pref_group)

        # 1. System Row
        self.sys_row = Adw.SwitchRow()
        self.sys_row.set_title(self.t["sys_title"])
        self.sys_row.set_subtitle(self.t["sys_desc"])
        self.sys_row.set_active(True)
        pref_group.add(self.sys_row)

        # 2. Flatpak Row
        self.flatpak_row = Adw.SwitchRow()
        self.flatpak_row.set_title(self.t["flatpak_title"])
        self.flatpak_row.set_subtitle(self.t["flatpak_desc"])
        self.flatpak_row.set_active(True)
        pref_group.add(self.flatpak_row)

        # 3. Sadeem Box Row
        self.box_row = Adw.SwitchRow()
        self.box_row.set_title(self.t["box_title"])
        self.box_row.set_subtitle(self.t["box_desc"])
        self.box_row.set_active(True)
        pref_group.add(self.box_row)

        # Progress area
        self.progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.status_label = Gtk.Label(label=self.t["status_ready"])
        self.status_label.add_css_class("body")
        self.status_label.set_halign(Gtk.Align.START)
        self.progress_box.append(self.status_label)

        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_fraction(0.0)
        self.progress_box.append(self.progress_bar)
        content_box.append(self.progress_box)

        # Actions area
        self.actions_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        self.btn_start = Gtk.Button(label=self.t["btn_start"])
        self.btn_start.add_css_class("suggested-action")
        self.btn_start.add_css_class("pill")
        self.btn_start.set_size_request(-1, 48)
        self.btn_start.connect("clicked", self.on_start_clicked)
        self.actions_box.append(self.btn_start)

        self.btn_reboot = Gtk.Button(label=self.t["btn_reboot"])
        self.btn_reboot.add_css_class("destructive-action")
        self.btn_reboot.add_css_class("pill")
        self.btn_reboot.set_size_request(-1, 48)
        self.btn_reboot.set_visible(False)
        self.btn_reboot.connect("clicked", self.on_reboot_clicked)
        self.actions_box.append(self.btn_reboot)

        content_box.append(self.actions_box)

        # Details Expander
        self.expander = Gtk.Expander(label=self.t["details_title"])
        self.expander.set_expanded(False)

        scrolled_text = Gtk.ScrolledWindow()
        scrolled_text.set_min_content_height(160)
        scrolled_text.set_max_content_height(300)
        scrolled_text.add_css_class("card")

        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_cursor_visible(False)
        self.text_view.set_monospace(True)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.text_view.set_top_margin(10)
        self.text_view.set_bottom_margin(10)
        self.text_view.set_left_margin(10)
        self.text_view.set_right_margin(10)
        scrolled_text.set_child(self.text_view)

        self.expander.set_child(scrolled_text)
        content_box.append(self.expander)

    def check_box_availability(self):
        def _check():
            try:
                res = subprocess.run(["distrobox", "list"], capture_output=True, text=True, timeout=5)
                has_box = "sadeem-box" in res.stdout
            except Exception:
                has_box = False

            def _update_ui():
                if not has_box:
                    self.box_row.set_active(False)
                    self.box_row.set_sensitive(False)
                return False
            GLib.idle_add(_update_ui)

        threading.Thread(target=_check, daemon=True).start()

    def append_log(self, text):
        def _append():
            buf = self.text_view.get_buffer()
            end_iter = buf.get_end_iter()
            buf.insert(end_iter, text + "\n")
            # Auto-scroll to bottom
            mark = buf.create_mark(None, buf.get_end_iter(), False)
            self.text_view.scroll_to_mark(mark, 0.05, False, 0.0, 1.0)
            return False
        GLib.idle_add(_append)

    def on_start_clicked(self, btn):
        if self.is_running:
            return

        run_sys = self.sys_row.get_active()
        run_flatpak = self.flatpak_row.get_active()
        run_box = self.box_row.get_active()

        if not (run_sys or run_flatpak or run_box):
            return

        self.is_running = True
        self.btn_start.set_sensitive(False)
        self.btn_start.set_label(self.t["btn_updating"])
        self.sys_row.set_sensitive(False)
        self.flatpak_row.set_sensitive(False)
        self.box_row.set_sensitive(False)
        self.progress_bar.set_fraction(0.0)

        # Clear logs
        buf = self.text_view.get_buffer()
        buf.set_text("")
        self.expander.set_expanded(True)

        threading.Thread(target=self.run_updates, args=(run_sys, run_flatpak, run_box), daemon=True).start()

    def run_command(self, cmd, desc):
        self.append_log(f"=== {desc} ===")
        self.append_log(f"$ {' '.join(cmd)}")
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
            output_lines = []
            for line in proc.stdout:
                line_str = line.rstrip()
                self.append_log(line_str)
                output_lines.append(line_str)
            proc.wait()
            self.append_log("")
            return proc.returncode, "\n".join(output_lines)
        except Exception as e:
            err_msg = f"Error executing {cmd[0]}: {str(e)}"
            self.append_log(err_msg)
            return 1, err_msg

    def run_updates(self, do_sys, do_flatpak, do_box):
        tasks = []
        if do_sys:
            tasks.append("sys")
        if do_flatpak:
            tasks.append("flatpak")
        if do_box:
            tasks.append("box")

        total_steps = len(tasks)
        step = 0
        overall_success = True

        for task in tasks:
            if task == "sys":
                GLib.idle_add(lambda: self.status_label.set_text(self.t["status_sys"]))
                GLib.idle_add(lambda s=step, tot=total_steps: self.progress_bar.set_fraction(s / tot))
                # Execute pkexec rpm-ostree upgrade
                code, out = self.run_command(["pkexec", "rpm-ostree", "upgrade"], "rpm-ostree upgrade")
                if code == 0:
                    out_lower = out.lower()
                    if "upgraded:" in out_lower or "changes:" in out_lower or "staged" in out_lower:
                        self.reboot_required = True
                else:
                    overall_success = False

            elif task == "flatpak":
                GLib.idle_add(lambda: self.status_label.set_text(self.t["status_flatpak"]))
                GLib.idle_add(lambda s=step, tot=total_steps: self.progress_bar.set_fraction(s / tot))
                code, out = self.run_command(["flatpak", "update", "-y", "--noninteractive"], "flatpak update")
                if code != 0:
                    overall_success = False

            elif task == "box":
                GLib.idle_add(lambda: self.status_label.set_text(self.t["status_box"]))
                GLib.idle_add(lambda s=step, tot=total_steps: self.progress_bar.set_fraction(s / tot))
                code, out = self.run_command(["distrobox", "upgrade", "sadeem-box"], "distrobox upgrade sadeem-box")
                if code != 0:
                    overall_success = False

            step += 1
            GLib.idle_add(lambda s=step, tot=total_steps: self.progress_bar.set_fraction(s / tot))

        GLib.idle_add(self.on_updates_finished, overall_success)

    def on_updates_finished(self, success):
        self.is_running = False
        self.progress_bar.set_fraction(1.0)
        self.btn_start.set_sensitive(True)
        self.btn_start.set_label(self.t["btn_start"])
        self.sys_row.set_sensitive(True)
        self.flatpak_row.set_sensitive(True)
        self.check_box_availability()

        if self.reboot_required:
            self.status_label.set_text(self.t["status_reboot"])
            self.btn_reboot.set_visible(True)
        elif success:
            self.status_label.set_text(self.t["status_done"])
        else:
            self.status_label.set_text(self.t["status_error"])

        return False

    def on_reboot_clicked(self, btn):
        subprocess.run(["systemctl", "reboot"])

class SadeemUpdaterApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.sadeem.updater",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = SadeemUpdaterWindow(application=self)
        win.present()

def main():
    app = SadeemUpdaterApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
