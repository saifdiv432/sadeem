#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "/usr/share/sadeem-video-editor/app.py" ]; then
    exec /usr/bin/python3 /usr/share/sadeem-video-editor/app.py "$@"
elif [ -f "${SCRIPT_DIR}/../share/sadeem-video-editor/app.py" ]; then
    exec /usr/bin/python3 "${SCRIPT_DIR}/../share/sadeem-video-editor/app.py" "$@"
else
    exec /usr/bin/python3 /usr/share/sadeem-video-editor/app.py "$@"
fi
