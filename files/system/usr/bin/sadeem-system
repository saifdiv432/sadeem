def get_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG"):
        val = os.environ.get(var, "")
        if val:
            code = val.split(":")[0].split(".")[0].split("_")[0].split("@")[0].lower()
            if code in TRANSLATIONS:
                return code
    return "en"


LANG = get_language()


def t(key, **kwargs):
    entry = TRANSLATIONS.get(LANG, {})
    val = entry.get(key)
    if val is None or val == "":
        val = TRANSLATIONS.get("en", {}).get(key, key)
    if kwargs and isinstance(val, str):
        try:
            return val.format(**kwargs)
        except Exception:
            return val
    return val


class TranslationProxy:
    def __getitem__(self, key):
        return t(key)

    def get(self, key, default=None):
        val = t(key)
        return val if val != key else default


def setup_icon_theme():
    display = Gdk.Display.get_default()
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        search_paths = [
            "/usr/share/icons/hicolor/scalable/apps",
            "/usr/share/icons/hicolor/256x256/apps",
            "/usr/share/icons/hicolor/128x128/apps",
            "/usr/share/icons/hicolor/64x64/apps",
            "/usr/share/icons/hicolor/48x48/apps",
            "/usr/share/pixmaps",
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "scalable", "apps")),
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "256x256", "apps")),
        ]
        for p in search_paths:
            if os.path.isdir(p):
                theme.add_search_path(p)


def safe_icon(icon_names, fallback="application-x-executable-symbolic"):
    if isinstance(icon_names, str):
        icon_names = [icon_names]
    display = Gdk.Display.get_default()
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        for name in icon_names:
            if name and theme.has_icon(name):
                return name
    for name in icon_names:
        if name:
            if os.path.isabs(name) and os.path.exists(name):
                return name
            for prefix in ("/usr/share/icons/hicolor/scalable/apps",
                           "/usr/share/icons/hicolor/256x256/apps",
                           "/usr/share/pixmaps"):
                for ext in (".svg", ".png"):
                    p = os.path.join(prefix, f"{name}{ext}")
                    if os.path.exists(p):
                        return name
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        if theme.has_icon(fallback):
            return fallback
        for fb in ("application-x-executable-symbolic", "system-run-symbolic", "image-missing-symbolic"):
            if theme.has_icon(fb):
                return fb
    return fallback


def create_badge(icon_names, size=64, icon_size=28, fallback="application-x-executable-symbolic"):
    badge = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    badge.set_halign(Gtk.Align.CENTER)
    badge.set_valign(Gtk.Align.CENTER)
    badge.set_size_request(size, size)
    badge.add_css_class("sadeem-gradient-badge")

    icon = safe_icon(icon_names, fallback=fallback)
    img = Gtk.Image.new_from_icon_name(icon)
    img.set_pixel_size(icon_size)
    img.set_halign(Gtk.Align.CENTER)
    img.set_valign(Gtk.Align.CENTER)
    img.set_hexpand(True)
    img.set_vexpand(True)
    badge.append(img)
    return badge


def build_page_header(icon_names, title, subtitle):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.set_halign(Gtk.Align.CENTER)
    box.set_margin_bottom(6)

    badge = create_badge(icon_names, size=64, icon_size=28)
    badge.set_halign(Gtk.Align.CENTER)
    box.append(badge)

    title_lbl = Gtk.Label(label=title)
    title_lbl.add_css_class("sadeem-header-title")
    title_lbl.set_wrap(True)
    title_lbl.set_justify(Gtk.Justification.CENTER)
    box.append(title_lbl)

    sub_lbl = Gtk.Label(label=subtitle)
    sub_lbl.add_css_class("sadeem-header-subtitle")
    sub_lbl.set_wrap(True)
    sub_lbl.set_justify(Gtk.Justification.CENTER)
    sub_lbl.set_max_width_chars(54)
    box.append(sub_lbl)

    return box



def has_pending_reboot():
    """Check rpm-ostree status --json for staged deployments awaiting reboot."""
    try:
        res = subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True, check=False)
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            deployments = data.get("deployments", [])
            if deployments and deployments[0].get("booted") is False:
                return True
    except Exception:
        pass
    return False


def get_current_booted_digest():
    """Extract current active (booted) image digest from rpm-ostree status."""
    try:
        res = subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True, timeout=15, check=False)
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            for d in data.get("deployments", []):
                if d.get("booted"):
                    digest = d.get("container-image-reference-digest") or d.get("base-commit-meta", {}).get("ostree.manifest-digest")
                    if digest:
                        return digest.strip()
    except Exception:
        pass

    # Fallback to parsing text output under the booted bullet (●)
    try:
        res = subprocess.run(["rpm-ostree", "status"], capture_output=True, text=True, timeout=15, check=False)
        if res.returncode == 0 and res.stdout.strip():
            in_booted = False
            for line in res.stdout.splitlines():
                if line.startswith("●"):
                    in_booted = True
                elif in_booted:
                    if line and not line.startswith(" ") and not line.startswith("\t"):
                        break
                    m = re.search(r"Digest:\s*(sha256:[a-f0-9]+)", line, re.IGNORECASE)
                    if m:
                        return m.group(1).strip()
    except Exception:
        pass
    return ""


def trigger_system_reboot():
    """Trigger a safe, graceful GNOME session reboot with systemctl fallback."""
    try:
        res = subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "org.gnome.SessionManager",
            "--object-path", "/org/gnome/SessionManager",
            "--method", "org.gnome.SessionManager.Reboot"
        ], capture_output=True, text=True, check=False)
        if res.returncode == 0:
            return True
    except Exception:
        pass

    try:
        subprocess.Popen(["systemctl", "reboot"])
        return True
    except Exception as e:
        print(f"Error triggering system reboot: {e}", file=sys.stderr)
        return False

def launch_boxbuddy():
    for cmd in [
        ["gtk-launch", "io.github.dvlv.boxbuddyrs"],
        ["boxbuddy-rs"],
        ["boxbuddy"],
        ["flatpak", "run", "io.github.dvlv.boxbuddyrs"]
    ]:
        try:
            subprocess.Popen(cmd)
            return
        except Exception:
            pass


def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip("#")
    if len(hex_str) == 3:
        hex_str = "".join(c * 2 for c in hex_str)
    r = int(hex_str[0:2], 16) / 255.0
    g = int(hex_str[2:4], 16) / 255.0
    b = int(hex_str[4:6], 16) / 255.0
    return r, g, b


def rgb_to_hex(r, g, b):
    r_int = max(0, min(255, round(r * 255)))
    g_int = max(0, min(255, round(g * 255)))
    b_int = max(0, min(255, round(b * 255)))
    return f"#{r_int:02x}{g_int:02x}{b_int:02x}"


def compute_color_palette(hex_str):
    if hex_str.lower() == "#7a1c33":
        return {
            "hex": "#7a1c33",
            "accent_fg": "#ffffff",
            "accent_color": "#c44564",
            "hover": "#5e1426",
            "arrow": "#4a0f1d",
        }
    r, g, b = hex_to_rgb(hex_str)
    h, l, s = colorsys.rgb_to_hls(r, g, b)

    luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b
    accent_fg = "#ffffff" if luminance < 0.55 else "#1e1e1e"

    accent_l = max(l, 0.65)
    r_acc, g_acc, b_acc = colorsys.hls_to_rgb(h, accent_l, s)
    accent_color = rgb_to_hex(r_acc, g_acc, b_acc)

    hov_l = min(1.0, max(0.0, l + 0.06))
    r_hov, g_hov, b_hov = colorsys.hls_to_rgb(h, hov_l, s)
    hover_color = rgb_to_hex(r_hov, g_hov, b_hov)

    arr_l = min(1.0, max(0.0, l - 0.06))
    r_arr, g_arr, b_arr = colorsys.hls_to_rgb(h, arr_l, s)
    arrow_color = rgb_to_hex(r_arr, g_arr, b_arr)

    return {
        "hex": hex_str.lower(),
        "accent_fg": accent_fg,
        "accent_color": accent_color,
        "hover": hover_color,
        "arrow": arrow_color,
    }


def detect_nvidia_gpus():
    gpus = []
    try:
        res = subprocess.run(
            ["lspci", "-nn", "-d", "10de:"],
            capture_output=True,
            text=True,
            check=False
        )
        for line in res.stdout.strip().splitlines():
            line = line.strip()
            if not line:
                continue
            match = re.search(r'\[10de:([0-9a-fA-F]{4})\]', line)
            if match:
                dev_id = match.group(1).lower()
                raw_name = line
                if ":" in line:
                    parts = line.split(":", 2)
                    if len(parts) >= 3:
                        raw_name = parts[2].strip()
                raw_name = re.sub(r'\(rev\s+[0-9a-fA-F]+\)', '', raw_name).strip()
                gpus.append({
                    "slot": line.split()[0] if line.split() else "",
                    "device_id": dev_id,
                    "raw_name": raw_name
                })
    except Exception:
        pass
    return gpus


def get_layered_nvidia_packages():
    layered = []
    try:
        res = subprocess.run(
            ["rpm-ostree", "status", "--json"],
            capture_output=True,
            text=True,
            check=False
        )
        if res.returncode == 0:
            import json
            data = json.loads(res.stdout)
            for dep in data.get("deployments", []):
                for pkg in dep.get("requested-packages", []) + dep.get("packages", []):
                    if ("akmod-nvidia" in pkg or "xorg-x11-drv-nvidia" in pkg) and pkg not in layered:
                        layered.append(pkg)
    except Exception:
        pass

    if not layered:
        for pkg in ["akmod-nvidia", "akmod-nvidia-580xx", "akmod-nvidia-470xx"]:
            try:
                res = subprocess.run(["rpm", "-q", pkg], capture_output=True, text=True, check=False)
                if res.returncode == 0 and "not installed" not in res.stdout:
                    layered.append(pkg)
            except Exception:
                pass
    return layered


def is_nouveau_loaded():
    if os.path.exists("/sys/module/nouveau"):
        return True
    try:
        res = subprocess.run(["lsmod"], capture_output=True, text=True, check=False)
        return "nouveau" in res.stdout
    except Exception:
        return False


def is_nvidia_driver_active():
    try:
        res = subprocess.run(["nvidia-smi"], capture_output=True, text=True, check=False)
        if res.returncode == 0:
            return True
    except Exception:
        pass
    if os.path.exists("/sys/module/nvidia") and not is_nouveau_loaded():
        return True
    return False


def is_driver_installed():
    layered = get_layered_nvidia_packages()
    return len(layered) > 0 and is_nvidia_driver_active() and not is_nouveau_loaded()


def get_secure_boot_state():
    sb_enabled = False
    needs_enrollment = False
    try:
        res = subprocess.run(
            ["mokutil", "--sb-state"],
            capture_output=True,
            text=True,
            check=False
        )
        if "SecureBoot enabled" in res.stdout:
            sb_enabled = True
            key_path = "/etc/pki/akmods/certs/public_key.der"
            if os.path.exists(key_path):
                test_res = subprocess.run(
                    ["mokutil", "--test-key", key_path],
                    capture_output=True,
                    text=True,
                    check=False
                )
                if test_res.returncode != 0:
                    needs_enrollment = True
            else:
                needs_enrollment = True
    except Exception:
        pass
    return sb_enabled, needs_enrollment


def load_database():
    try:
        req = urllib.request.Request(
            REMOTE_DB_URL,
            headers={"User-Agent": "SadeemSystem/1.0"}
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode('utf-8'))
                if "categories" in data:
                    return data
    except Exception:
        pass

    for p in LOCAL_DB_PATHS:
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if "categories" in data:
                        return data
            except Exception:
                pass

    return {"categories": {}}


def classify_gpu(gpu, db):
    dev_id = gpu["device_id"].lower()
    categories = db.get("categories", {})

    for cat_key in ["modern", "legacy_580xx", "unsupported"]:
        cat_data = categories.get(cat_key, {})
        devices = cat_data.get("devices", {})
        if dev_id in devices:
            return cat_key, devices[dev_id], cat_data

    try:
        val = int(dev_id, 16)
        if val >= 0x1E00:
            cat_data = categories.get("modern", {
                "branch": "akmod-nvidia",
                "driver_package": "akmod-nvidia",
                "userspace_package": "xorg-x11-drv-nvidia",
                "cuda_package": "xorg-x11-drv-nvidia-cuda",
            })
            return "modern", gpu["raw_name"], cat_data
        elif val >= 0x1340:
            cat_data = categories.get("legacy_580xx", {
                "branch": "akmod-nvidia-580xx",
                "driver_package": "akmod-nvidia-580xx",
                "userspace_package": "xorg-x11-drv-nvidia-580xx",
                "cuda_package": "xorg-x11-drv-nvidia-580xx-cuda",
            })
            return "legacy_580xx", gpu["raw_name"], cat_data
        else:
            cat_data = categories.get("unsupported", {
                "branch": None,
            })
            return "unsupported", gpu["raw_name"], cat_data
    except Exception:
        return "unsupported", gpu["raw_name"], categories.get("unsupported", {})


