FINGERPRINT_VIDS = {"06cb", "27c6", "138a", "04f3", "1c7a", "2808"}
DEDICATED_FINGERPRINT_VIDS = {"138a", "1c7a", "2808"}
INTEL_IPU6_DEVICE_IDS = {"9a19", "465d", "a75d", "7d19", "4e19", "645d", "8a19", "1919"}


def get_loaded_modules():
    modules = set()
    try:
        with open("/proc/modules", "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                parts = line.split()
                if parts:
                    mod = parts[0].strip()
                    modules.add(mod)
                    modules.add(mod.replace("-", "_"))
                    modules.add(mod.replace("_", "-"))
    except Exception:
        try:
            res = subprocess.run(["lsmod"], capture_output=True, text=True, check=False, timeout=5)
            for line in res.stdout.splitlines()[1:]:
                parts = line.split()
                if parts:
                    mod = parts[0].strip()
                    modules.add(mod)
                    modules.add(mod.replace("-", "_"))
                    modules.add(mod.replace("_", "-"))
        except Exception:
            pass
    return modules


def get_installed_and_staged_packages():
    pkgs = set()
    try:
        res = subprocess.run(
            ["rpm", "-qa", "--qf", "%{NAME}\n"],
            capture_output=True,
            text=True,
            check=False,
            timeout=10
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                name = line.strip()
                if name:
                    pkgs.add(name)
    except Exception:
        pass

    try:
        res = subprocess.run(
            ["rpm-ostree", "status", "--json"],
            capture_output=True,
            text=True,
            check=False,
            timeout=10
        )
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            for dep in data.get("deployments", []):
                for p in dep.get("requested-packages", []) + dep.get("packages", []):
                    pkgs.add(p.strip())
    except Exception:
        pass
    return pkgs


def _read_sysfs_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return f.read().strip()
    except Exception:
        return ""


def _read_sysfs_driver(dev_path):
    drv_link = os.path.join(dev_path, "driver")
    try:
        if os.path.islink(drv_link):
            return os.path.basename(os.readlink(drv_link))
    except Exception:
        pass
    return ""


def is_standard_bridge_or_hub(dev):
    bus = dev.get("bus", "")
    if bus == "usb":
        vid = dev.get("vendor_id", "").lower()
        dclass = dev.get("device_class", "").lower()
        iclasses = dev.get("interface_classes", set())
        if vid == "1d6b" or dclass == "09" or (iclasses and iclasses == {"09"}):
            return True
        return False

    if bus == "pci":
        cid = dev.get("class_id", "").lower()
        name_l = dev.get("name", "").lower()
        # Keep Intel IPU6/MIPI cameras and ISH/SFH sensor hubs visible even if class is 0480/0880/1180/0780
        if any(k in name_l for k in ("ipu", "imaging", "camera", "mipi", "sensor hub", "ish", "sfh")):
            return False
        if dev.get("vendor_id", "").lower() == "8086" and dev.get("device_id", "").lower() in INTEL_IPU6_DEVICE_IDS:
            return False
        # Standard bridges, RAM controllers, USB/SMBus host controllers, generic system peripherals
        if cid.startswith(("05", "06")):
            return True
        if cid in ("0c03", "0c05", "0c80", "0800", "0801", "0802", "0803", "0804", "0880", "0780", "1180"):
            return True
        return False

    return False


def classify_hardware_device(dev):
    bus = dev.get("bus", "")
    cid = dev.get("class_id", "").lower()
    vid = dev.get("vendor_id", "").lower()
    did = dev.get("device_id", "").lower()
    name_l = dev.get("name", "").lower()
    drv_l = dev.get("driver", "").lower()
    iclasses = dev.get("interface_classes", set())

    if bus == "iio" or bus == "input":
        return "sensors"

    if bus == "spi":
        if any(k in name_l for k in ("fp", "finger", "gxfp", "syna", "elan", "fpc", "goodix")):
            return "fingerprint"
        return "sensors"

    if bus == "pci":
        if cid.startswith("03"):
            return "gpu"
        if cid.startswith("02"):
            return "network"
        if (vid == "8086" and did in INTEL_IPU6_DEVICE_IDS) or any(k in name_l for k in ("ipu6", "ipu ", "imaging", "mipi", "camera")):
            return "camera"
        if cid in ("0403", "0401") or (cid == "0480" and any(k in name_l for k in ("audio", "sound", "sof", "dsp", "acp", "hda"))):
            return "audio"
        if drv_l in ("snd_hda_intel", "snd_sof_pci_intel_tgl", "snd_sof_pci_intel_cnl", "snd_sof_pci_intel_icl", "snd_sof_pci_intel_mtl", "snd_sof_pci_amd_acp") or drv_l.startswith("snd_"):
            return "audio"
        if drv_l in ("intel-ish-ipc", "ish_ipc", "amd_sfh", "hid_sensor_hub") or any(k in name_l for k in ("sensor hub", "integrated sensor", "ish", "sfh")):
            return "sensors"
        if "bluetooth" in name_l or drv_l in ("btusb", "hci_uart"):
            return "bluetooth"
        if "fingerprint" in name_l or "biometric" in name_l:
            return "fingerprint"
        return "other"

    if bus == "usb":
        is_pure_hid = bool(iclasses) and iclasses == {"03"}
        is_touch_or_input = any(k in name_l for k in ("touchpad", "trackpad", "mouse", "keyboard", "touchscreen", "digitizer", "stylus", "pen", "tablet"))

        # Fingerprint detection with guard against Synaptics/Elan/Goodix touchpads & touchscreens
        if "fingerprint" in name_l or "biometric" in name_l or vid in DEDICATED_FINGERPRINT_VIDS:
            return "fingerprint"
        if vid in FINGERPRINT_VIDS:
            if any(k in name_l for k in ("finger", "fp", "bio", "print")):
                return "fingerprint"
            if not is_pure_hid and not is_touch_or_input:
                return "fingerprint"

        # Bluetooth
        if drv_l in ("btusb", "ath3k", "btrtl", "btintel", "btbcm") or "bluetooth" in name_l or "e0" in iclasses:
            if "bluetooth" in name_l or drv_l.startswith("bt") or dev.get("is_bt_iface", False):
                return "bluetooth"

        # Camera
        if "0e" in iclasses or drv_l == "uvcvideo" or any(k in name_l for k in ("webcam", "camera", "cam ", "uvc", "ir cam")):
            return "camera"

        # Audio
        if "01" in iclasses or drv_l in ("snd-usb-audio", "snd_usb_audio") or any(k in name_l for k in ("audio", "headset", "microphone", "speaker", "dac")):
            return "audio"

        # Network / Wi-Fi
        if "02" in iclasses or "0a" in iclasses or drv_l in ("r8152", "cdc_ether", "cdc_ncm", "ax88179_178a", "rtl8xxxu", "rtw88_8822bu", "mt76x2u", "ath9k_htc", "rndis_host") or any(k in name_l for k in ("wi-fi", "wifi", "wireless", "wlan", "ethernet", "802.11", "lan adapter")):
            return "network"

        # Touchscreen / Sensors
        if any(k in name_l for k in ("touchscreen", "wacom", "digitizer", "sensor", "accelerometer", "gyro")):
            return "sensors"

        return "other"

    return "other"


def scan_pci_devices():
    devices = []
    seen_slots = set()
    try:
        res = subprocess.run(["lspci", "-nnk"], capture_output=True, text=True, check=False, timeout=8)
        current = None
        for raw_line in res.stdout.splitlines():
            if not raw_line.strip():
                continue
            if not raw_line.startswith(("\t", " ")):
                if current:
                    devices.append(current)
                m = re.match(
                    r'^([0-9a-fA-F:.]+)\s+([^\[]+)\[([0-9a-fA-F]{4})\]:\s+(.+?)\s+\[([0-9a-fA-F]{4}):([0-9a-fA-F]{4})\]',
                    raw_line.strip()
                )
                if m:
                    slot = m.group(1).strip()
                    class_name = m.group(2).strip()
                    class_id = m.group(3).lower()
                    dev_name = re.sub(r'\(rev\s+[0-9a-fA-F]+\)', '', m.group(4)).strip()
                    vendor_id = m.group(5).lower()
                    device_id = m.group(6).lower()
                    sys_slot = slot if slot.count(":") >= 2 else f"0000:{slot}"
                    sys_path = os.path.join("/sys/bus/pci/devices", sys_slot)
                    modalias = _read_sysfs_text(os.path.join(sys_path, "modalias"))
                    sys_drv = _read_sysfs_driver(sys_path)
                    seen_slots.add(sys_slot)
                    current = {
                        "bus": "pci",
                        "slot": slot,
                        "sys_slot": sys_slot,
                        "class_name": class_name,
                        "class_id": class_id,
                        "name": dev_name,
                        "vendor_id": vendor_id,
                        "device_id": device_id,
                        "driver": sys_drv,
                        "modules": [],
                        "modalias": modalias,
                        "modaliases": [modalias] if modalias else [],
                    }
                else:
                    current = None
            elif current:
                line = raw_line.strip()
                if line.startswith("Kernel driver in use:"):
                    current["driver"] = line.split(":", 1)[1].strip()
                elif line.startswith("Kernel modules:"):
                    mods = [x.strip() for x in line.split(":", 1)[1].split(",") if x.strip()]
                    current["modules"] = mods
        if current:
            devices.append(current)
    except Exception:
        pass

    # Fallback / supplement from /sys/bus/pci/devices directly
    for sys_path in sorted(glob.glob("/sys/bus/pci/devices/*")):
        sys_slot = os.path.basename(sys_path)
        if sys_slot in seen_slots:
            continue
        vid = _read_sysfs_text(os.path.join(sys_path, "vendor")).replace("0x", "").lower()
        did = _read_sysfs_text(os.path.join(sys_path, "device")).replace("0x", "").lower()
        cls_raw = _read_sysfs_text(os.path.join(sys_path, "class")).replace("0x", "").lower()
        class_id = cls_raw[:4] if len(cls_raw) >= 4 else ""
        modalias = _read_sysfs_text(os.path.join(sys_path, "modalias"))
        if vid and did:
            devices.append({
                "bus": "pci",
                "slot": sys_slot,
                "sys_slot": sys_slot,
                "class_name": "PCI Device",
                "class_id": class_id,
                "name": f"PCI Device [{vid}:{did}]",
                "vendor_id": vid,
                "device_id": did,
                "driver": _read_sysfs_driver(sys_path),
                "modules": [],
                "modalias": modalias,
                "modaliases": [modalias] if modalias else [],
            })

    for d in devices:
        d["is_bridge_or_hub"] = is_standard_bridge_or_hub(d)
        d["category"] = classify_hardware_device(d)
    return devices


def scan_usb_devices():
    lsusb_by_busdev = {}
    lsusb_by_vidpid = {}
    try:
        res = subprocess.run(["lsusb"], capture_output=True, text=True, check=False, timeout=8)
        for line in res.stdout.splitlines():
            m = re.match(r'^Bus\s+(\d+)\s+Device\s+(\d+):\s+ID\s+([0-9a-fA-F]{4}):([0-9a-fA-F]{4})\s*(.*)$', line.strip())
            if m:
                bus_num = int(m.group(1))
                dev_num = int(m.group(2))
                vid = m.group(3).lower()
                pid = m.group(4).lower()
                desc = m.group(5).strip()
                if desc:
                    lsusb_by_busdev[(bus_num, dev_num)] = desc
                    lsusb_by_vidpid[f"{vid}:{pid}"] = desc
    except Exception:
        pass

    devices = []
    seen_busdev = set()
    for dev_path in sorted(glob.glob("/sys/bus/usb/devices/*")):
        vid_f = os.path.join(dev_path, "idVendor")
        pid_f = os.path.join(dev_path, "idProduct")
        if not (os.path.exists(vid_f) and os.path.exists(pid_f)):
            continue
        vid = _read_sysfs_text(vid_f).lower()
        pid = _read_sysfs_text(pid_f).lower()
        dclass = _read_sysfs_text(os.path.join(dev_path, "bDeviceClass")).lower()
        if vid == "1d6b" or dclass == "09":
            continue

        busnum_s = _read_sysfs_text(os.path.join(dev_path, "busnum"))
        devnum_s = _read_sysfs_text(os.path.join(dev_path, "devnum"))
        bus_dev_key = None
        if busnum_s.isdigit() and devnum_s.isdigit():
            bus_dev_key = (int(busnum_s), int(devnum_s))
            seen_busdev.add(bus_dev_key)

        prod = _read_sysfs_text(os.path.join(dev_path, "product"))
        mfr = _read_sysfs_text(os.path.join(dev_path, "manufacturer"))
        name = ""
        if bus_dev_key and bus_dev_key in lsusb_by_busdev:
            name = lsusb_by_busdev[bus_dev_key]
        elif f"{vid}:{pid}" in lsusb_by_vidpid:
            name = lsusb_by_vidpid[f"{vid}:{pid}"]
        elif mfr and prod:
            name = f"{mfr} {prod}" if mfr.lower() not in prod.lower() else prod
        elif prod:
            name = prod
        else:
            name = f"USB Device [{vid}:{pid}]"

        drivers = []
        iclasses = set()
        modaliases = []
        is_bt_iface = False
        for iface in sorted(glob.glob(dev_path + ":*")):
            drv = _read_sysfs_driver(iface)
            if drv and drv not in ("usbfs", "hub") and drv not in drivers:
                drivers.append(drv)
            ic = _read_sysfs_text(os.path.join(iface, "bInterfaceClass")).lower()
            isc = _read_sysfs_text(os.path.join(iface, "bInterfaceSubClass")).lower()
            ip = _read_sysfs_text(os.path.join(iface, "bInterfaceProtocol")).lower()
            if ic:
                iclasses.add(ic)
            if ic == "e0" and isc == "01" and ip == "01":
                is_bt_iface = True
            ma = _read_sysfs_text(os.path.join(iface, "modalias"))
            if ma and ma not in modaliases:
                modaliases.append(ma)

        dev_ma = _read_sysfs_text(os.path.join(dev_path, "modalias"))
        if dev_ma and dev_ma not in modaliases:
            modaliases.append(dev_ma)

        dev_obj = {
            "bus": "usb",
            "slot": os.path.basename(dev_path),
            "name": name,
            "vendor_id": vid,
            "device_id": pid,
            "device_class": dclass,
            "interface_classes": iclasses,
            "is_bt_iface": is_bt_iface,
            "driver": ", ".join(drivers),
            "drivers": drivers,
            "modalias": modaliases[0] if modaliases else "",
            "modaliases": modaliases,
        }
        dev_obj["is_bridge_or_hub"] = is_standard_bridge_or_hub(dev_obj)
        dev_obj["category"] = classify_hardware_device(dev_obj)
        if not dev_obj["is_bridge_or_hub"]:
            devices.append(dev_obj)

    return devices


def scan_sensors_and_misc():
    devices = []
    seen = set()

    # IIO sensors (accelerometer, ambient light, gyroscope, screen rotation)
    for iio_path in sorted(glob.glob("/sys/bus/iio/devices/iio:device*")):
        sname = _read_sysfs_text(os.path.join(iio_path, "name"))
        if not sname or sname in seen:
            continue
        seen.add(sname)
        drv = _read_sysfs_driver(os.path.join(iio_path, "device")) or _read_sysfs_driver(iio_path) or "iio"
        friendly_map = {
            "accel_3d": "3D Accelerometer (Screen Rotation)",
            "gyro_3d": "3D Gyroscope",
            "als": "Ambient Light Sensor",
            "incli_3d": "Inclinometer Sensor",
            "magn_3d": "Magnetometer Sensor",
        }
        devices.append({
            "bus": "iio",
            "slot": os.path.basename(iio_path),
            "name": friendly_map.get(sname, f"Sensor ({sname})"),
            "vendor_id": "iio",
            "device_id": sname,
            "driver": drv,
            "modalias": "",
            "modaliases": [],
            "is_bridge_or_hub": False,
            "category": "sensors",
        })

    # Active touchscreens / styluses
    for inp_path in sorted(glob.glob("/sys/class/input/input*")):
        iname = _read_sysfs_text(os.path.join(inp_path, "name"))
        il = iname.lower()
        if not iname or iname in seen:
            continue
        if any(k in il for k in ("touchscreen", "wacom", "goodix capacitive", "elan touchscreen", "stylus")):
            seen.add(iname)
            drv = _read_sysfs_driver(os.path.join(inp_path, "device")) or "hid-multitouch"
            devices.append({
                "bus": "input",
                "slot": os.path.basename(inp_path),
                "name": iname,
                "vendor_id": "input",
                "device_id": "touch",
                "driver": drv,
                "modalias": "",
                "modaliases": [],
                "is_bridge_or_hub": False,
                "category": "sensors",
            })

    # SPI fingerprint sensors if present
    for spi_path in sorted(glob.glob("/sys/bus/spi/devices/*")):
        modalias = _read_sysfs_text(os.path.join(spi_path, "modalias"))
        ml = modalias.lower()
        if any(k in ml for k in ("elan", "gxfp", "goodix", "syna", "fpc", "vfs", "fp")):
            dev_name = os.path.basename(spi_path)
            if dev_name in seen:
                continue
            seen.add(dev_name)
            devices.append({
                "bus": "spi",
                "slot": dev_name,
                "name": f"SPI Fingerprint Sensor ({dev_name})",
                "vendor_id": "spi",
                "device_id": dev_name,
                "driver": _read_sysfs_driver(spi_path),
                "modalias": modalias,
                "modaliases": [modalias] if modalias else [],
                "is_bridge_or_hub": False,
                "category": "fingerprint",
            })

    return devices


def _find_dnf_binary():
    for candidate in ("dnf5", "dnf"):
        if subprocess.run(["which", candidate], capture_output=True, check=False).returncode == 0:
            return candidate
    return None


def query_dnf_modalias(modaliases):
    dnf_bin = _find_dnf_binary()
    if not dnf_bin or not modaliases:
        return []

    ignored_prefixes = (
        "kernel",
        "glibc",
        "systemd",
        "dracut",
        "mesa-dri-drivers",
        "linux-firmware",
    )
    found = []
    for ma in modaliases[:3]:
        if not ma:
            continue
        try:
            res = subprocess.run(
                [dnf_bin, "repoquery", "--quiet", "--qf", "%{name}\n", "--whatprovides", ma],
                capture_output=True,
                text=True,
                check=False,
                timeout=12
            )
            if res.returncode == 0:
                for line in res.stdout.splitlines():
                    pkg = line.strip()
                    if not pkg:
                        continue
                    if any(pkg == pref or pkg.startswith(pref + "-") for pref in ignored_prefixes):
                        continue
                    if pkg not in found:
                        found.append(pkg)
            if found:
                break
        except Exception:
            continue
    return found


def check_fwupd_updates():
    updates = []
    try:
        res = subprocess.run(
            ["fwupdmgr", "get-updates", "--json"],
            capture_output=True,
            text=True,
            check=False,
            timeout=15
        )
        out = res.stdout.strip()
        if not out:
            return updates
        json_start = out.find("{")
        if json_start == -1:
            return updates
        data = json.loads(out[json_start:])
        for dev in data.get("Devices", []):
            releases = dev.get("Releases", [])
            if not releases:
                continue
            rel = releases[0]
            updates.append({
                "device_id": dev.get("DeviceId", ""),
                "name": dev.get("Name", "Hardware Device"),
                "vendor": dev.get("Vendor", ""),
                "current_version": dev.get("Version", ""),
                "new_version": rel.get("Version", ""),
                "summary": rel.get("Summary", ""),
            })
    except Exception:
        pass
    return updates


def analyze_hardware_and_drivers():
    pci_devices = scan_pci_devices()
    usb_devices = scan_usb_devices()
    misc_devices = scan_sensors_and_misc()
    all_devices = pci_devices + usb_devices + misc_devices

    loaded_modules = get_loaded_modules()
    installed_pkgs = get_installed_and_staged_packages()
    sb_enabled, needs_mok = get_secure_boot_state()
    layered_nvidia = get_layered_nvidia_packages()
    nouveau_loaded = is_nouveau_loaded()
    nvidia_active = is_nvidia_driver_active() or ("nvidia" in loaded_modules and not nouveau_loaded)
    db = load_database()
    has_video0 = os.path.exists("/dev/video0") or bool(glob.glob("/dev/video*"))

    recommendations = []
    seen_rec_keys = set()
    handled_unbound_slots = set()

    def add_rec(key, title, desc, packages, category, optional=False, needs_nvidia_kargs=False, needs_akmods=False, needs_fprintd_enable=False):
        if key in seen_rec_keys:
            return
        missing_pkgs = [p for p in packages if p not in installed_pkgs]
        if not missing_pkgs:
            return
        seen_rec_keys.add(key)
        recommendations.append({
            "key": key,
            "title": title,
            "desc": desc,
            "packages": missing_pkgs,
            "all_packages": packages,
            "category": category,
            "optional": optional,
            "default_selected": not optional,
            "needs_nvidia_kargs": needs_nvidia_kargs,
            "needs_akmods": needs_akmods or any(p.startswith("akmod-") for p in missing_pkgs),
            "needs_fprintd_enable": needs_fprintd_enable,
        })

    nvidia_state = {
        "has_gpu": False,
        "active": False,
        "layered_inactive": False,
        "unsupported": False,
        "layered_pkgs": layered_nvidia,
        "gpu_names": [],
    }

    # --- Rule 1: NVIDIA GPU (10de:*) ---
    nvidia_gpus = [d for d in pci_devices if d["vendor_id"] == "10de" and d["category"] == "gpu"]
    if nvidia_gpus:
        nvidia_state["has_gpu"] = True
        nvidia_state["gpu_names"] = [g["name"] for g in nvidia_gpus]
        primary = nvidia_gpus[0]
        gpu_dict = {"slot": primary["slot"], "device_id": primary["device_id"], "raw_name": primary["name"]}
        cat_key, card_name, cat_info = classify_gpu(gpu_dict, db)
        handled_unbound_slots.add(primary["slot"])

        if cat_key == "unsupported":
            nvidia_state["unsupported"] = True
        elif layered_nvidia and nvidia_active:
            nvidia_state["active"] = True
        elif layered_nvidia and not nvidia_active:
            nvidia_state["layered_inactive"] = True
        else:
            drv_pkg = cat_info.get("driver_package", "akmod-nvidia")
            cuda_pkg = cat_info.get("cuda_package", "xorg-x11-drv-nvidia-cuda")
            pkgs = [drv_pkg]
            if cuda_pkg:
                pkgs.append(cuda_pkg)
            if not ("nvidia" in loaded_modules and drv_pkg in installed_pkgs):
                add_rec(
                    key="nvidia",
                    title=t("drv_rec_nvidia_title", name=card_name),
                    desc=t("drv_rec_nvidia_desc"),
                    packages=pkgs,
                    category="gpu",
                    optional=False,
                    needs_nvidia_kargs=True,
                    needs_akmods=True,
                )

    # --- Rule 2: Intel & AMD GPUs ---
    for d in pci_devices:
        if d["category"] != "gpu":
            continue
        if d["vendor_id"] == "8086":
            if "intel-media-driver" not in installed_pkgs:
                add_rec(
                    key="intel-gpu",
                    title=t("drv_rec_intel_gpu_title", name=d["name"]),
                    desc=t("drv_rec_intel_gpu_desc"),
                    packages=["intel-media-driver"],
                    category="gpu",
                    optional=False,
                )
        elif d["vendor_id"] == "1002":
            if "mesa-va-drivers-freeworld" not in installed_pkgs:
                add_rec(
                    key="amd-gpu-freeworld",
                    title=t("drv_rec_amd_gpu_title", name=d["name"]),
                    desc=t("drv_rec_amd_gpu_desc"),
                    packages=["mesa-va-drivers-freeworld"],
                    category="gpu",
                    optional=True,
                )

    # --- Rule 3: Broadcom Wi-Fi (14e4:*) & Unbound Wi-Fi / Bluetooth ---
    for d in all_devices:
        if d["category"] in ("network", "bluetooth"):
            if d["vendor_id"] == "14e4" and d["category"] == "network":
                # Broadcom Wi-Fi without active kernel driver (or not using brcmfmac/wl)
                if not d.get("driver") and "akmod-wl" not in installed_pkgs:
                    handled_unbound_slots.add(d["slot"])
                    add_rec(
                        key="broadcom-wl",
                        title=t("drv_rec_broadcom_title", name=d["name"]),
                        desc=t("drv_rec_broadcom_desc"),
                        packages=["akmod-wl"],
                        category="network",
                        optional=False,
                        needs_akmods=True,
                    )

    # --- Rule 4: Intel IPU6 / MIPI Cameras ---
    for d in pci_devices:
        name_l = d["name"].lower()
        is_intel_ipu6 = (
            d["vendor_id"] == "8086"
            and (
                d["device_id"] in INTEL_IPU6_DEVICE_IDS
                or any(k in name_l for k in ("ipu6", "ipu ", "mipi", "imaging"))
            )
        )
        is_cam_ctrl = d["category"] == "camera"
        if (is_intel_ipu6 and not d.get("driver")) or (is_cam_ctrl and not has_video0):
            handled_unbound_slots.add(d["slot"])
            if "akmod-intel-ipu6" not in installed_pkgs:
                add_rec(
                    key="intel-ipu6",
                    title=t("drv_rec_ipu6_title", name=d["name"]),
                    desc=t("drv_rec_ipu6_desc"),
                    packages=["akmod-intel-ipu6"],
                    category="camera",
                    optional=False,
                    needs_akmods=True,
                )

    # --- Rule 5: Audio (Intel / AMD modern audio without active driver) ---
    for d in pci_devices:
        if d["category"] == "audio" and d["vendor_id"] in ("8086", "1022") and not d.get("driver"):
            handled_unbound_slots.add(d["slot"])
            if "alsa-sof-firmware" not in installed_pkgs:
                add_rec(
                    key="audio-sof",
                    title=t("drv_rec_audio_sof_title", name=d["name"]),
                    desc=t("drv_rec_audio_sof_desc"),
                    packages=["alsa-sof-firmware"],
                    category="audio",
                    optional=False,
                )

    # --- Rule 6: Fingerprint Reader ---
    fp_devices = [d for d in all_devices if d["category"] == "fingerprint"]
    if fp_devices:
        for d in fp_devices:
            handled_unbound_slots.add(d["slot"])
        missing_fp = [p for p in ("fprintd", "fprintd-pam") if p not in installed_pkgs]
        if missing_fp:
            add_rec(
                key="fingerprint",
                title=t("drv_rec_fprint_title", name=fp_devices[0]["name"]),
                desc=t("drv_rec_fprint_desc"),
                packages=["fprintd", "fprintd-pam"],
                category="fingerprint",
                optional=False,
                needs_fprintd_enable=True,
            )

    # --- Rule 7: General Dynamic Fallback via modalias ---
    fallback_queries = 0
    for d in all_devices:
        if fallback_queries >= 5:
            break
        if d.get("bus") not in ("pci", "usb"):
            continue
        if d.get("is_bridge_or_hub"):
            continue
        if d.get("driver"):
            continue
        if d.get("slot") in handled_unbound_slots:
            continue
        modaliases = d.get("modaliases", [])
        if not modaliases:
            continue
        fallback_queries += 1
        matched_pkgs = query_dnf_modalias(modaliases)
        if matched_pkgs:
            add_rec(
                key=f"modalias-{d['bus']}-{d['vendor_id']}-{d['device_id']}",
                title=t("drv_rec_modalias_title", name=d["name"]),
                desc=t("drv_rec_modalias_desc"),
                packages=matched_pkgs[:2],
                category=d["category"],
                optional=False,
                needs_akmods=any(p.startswith("akmod-") for p in matched_pkgs[:2]),
            )

    # --- Rule 8: Firmware Updates (fwupd) ---
    firmware_updates = check_fwupd_updates()

    # Group visible hardware devices by category (exclude boring bridges/hubs)
    devices_by_category = {cat_key: [] for cat_key, _, _ in HARDWARE_CATEGORIES}
    for d in all_devices:
        if d.get("is_bridge_or_hub"):
            continue
        cat = d.get("category", "other")
        if cat not in devices_by_category:
            cat = "other"
        devices_by_category[cat].append(d)

    return {
        "recommendations": recommendations,
        "firmware_updates": firmware_updates,
        "devices_by_category": devices_by_category,
        "sb_enabled": sb_enabled,
        "needs_mok": needs_mok,
        "nvidia_state": nvidia_state,
    }


def launch_container_terminal():
    for term in ["ptyxis", "gnome-terminal", "kgx", "x-terminal-emulator"]:
        try:
            if subprocess.run(["which", term], capture_output=True).returncode == 0:
                if term == "ptyxis":
                    subprocess.Popen(["ptyxis", "--", "distrobox", "enter", "sadeem-box"])
                elif term == "gnome-terminal":
                    subprocess.Popen(["gnome-terminal", "--", "distrobox", "enter", "sadeem-box"])
                else:
                    subprocess.Popen([term, "-e", "distrobox", "enter", "sadeem-box"])
                return
        except Exception:
            pass
    try:
        subprocess.Popen(["distrobox", "enter", "sadeem-box"])
    except Exception:
        pass


class SadeemSystemWindow(Adw.ApplicationWindow):
    def __init__(self, app, initial_tab="updates"):
        super().__init__(application=app)
        self.t = TranslationProxy()

        self.set_title(t("app_title"))
        self.set_default_size(760, 650)

        # State tracking
        self.is_updating = False
        self.is_checking = False
        self.current_update_stage = "idle"
        self.reboot_ready = False
        self.reboot_required = False
        self._color_updating = False
        self._upd_pulse_timer = None
        self._upd_checking_timer = None
        self._upd_staging_timer = None
        self._upd_current_frac = 0.0

        self.setup_ui(initial_tab)
        self.check_box_availability()
        self.check_initial_reboot_status()

    def check_initial_reboot_status(self):
        def _check():
            pending = has_pending_reboot()
            if pending:
                def _ui():
                    self.reboot_ready = True
                    self.btn_start_update.set_label(t("install_and_restart"))
                    self.btn_start_update.set_sensitive(True)
                    if not self.btn_start_update.has_css_class("suggested-action"):
                        self.btn_start_update.add_css_class("suggested-action")
                    if not self.btn_start_update.has_css_class("pill"):
                        self.btn_start_update.add_css_class("pill")
                    self.upd_status_label.set_text(t("status_reboot"))
                    if hasattr(self, "upd_results_group"):
                        for r in getattr(self, "upd_result_rows", []):
                            self.upd_results_group.remove(r)
                        self.upd_result_rows = []
                        row = Adw.ActionRow()
                        row.set_use_markup(False)
                        row.set_title(t("install_and_restart"))
                        row.set_subtitle(t("status_reboot"))
                        row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["system-reboot-symbolic", "view-refresh-symbolic"])))
                        self.upd_results_group.add(row)
                        self.upd_result_rows.append(row)
                        self.upd_results_group.set_visible(True)
                    return False
                GLib.idle_add(_ui)
        threading.Thread(target=_check, daemon=True).start()

    def update_action_button_state(self, pending=None):
        if pending is None:
            pending = has_pending_reboot()

        def _apply():
            self.reboot_ready = pending
            if pending:
                self.btn_start_update.set_label(t("install_and_restart"))
                self.btn_start_update.set_sensitive(True)
                if not self.btn_start_update.has_css_class("suggested-action"):
                    self.btn_start_update.add_css_class("suggested-action")
                if not self.btn_start_update.has_css_class("pill"):
                    self.btn_start_update.add_css_class("pill")
                self.upd_status_label.set_text(t("status_reboot"))
            else:
                if getattr(self, "current_update_stage", "idle") == "idle":
                    self.btn_start_update.set_label(t("btn_check_updates"))
                self.btn_start_update.set_sensitive(True)
                if not self.btn_start_update.has_css_class("suggested-action"):
                    self.btn_start_update.add_css_class("suggested-action")
                if not self.btn_start_update.has_css_class("pill"):
                    self.btn_start_update.add_css_class("pill")
            return False

        GLib.idle_add(_apply)

    def on_action_button_clicked(self, btn):
        if getattr(self, "reboot_ready", False):
            trigger_system_reboot()
        elif getattr(self, "current_update_stage", "idle") == "results_has_updates":
            self.start_installation()
        else:
            self.start_checking()

    def build_page_header(self, icon_names, title, subtitle):
        return build_page_header(icon_names, title, subtitle)

    def setup_ui(self, initial_tab):
        self.setup_color_css()
        self.toast_overlay = Adw.ToastOverlay()
        self.toolbar_view = Adw.ToolbarView()
        self.toast_overlay.set_child(self.toolbar_view)
        self.set_content(self.toast_overlay)

        # HeaderBar with ViewSwitcherTitle
        self.header_bar = Adw.HeaderBar()
        self.switcher_title = Adw.ViewSwitcherTitle()
        self.switcher_title.set_title(t("app_title"))

        # ViewStack
        self.view_stack = Adw.ViewStack()
        if hasattr(self.switcher_title, 'set_view_stack'):
            self.switcher_title.set_view_stack(self.view_stack)
        else:
            self.switcher_title.set_stack(self.view_stack)

        self.header_bar.set_title_widget(self.switcher_title)
        self.toolbar_view.add_top_bar(self.header_bar)

        # Bottom ViewSwitcherBar for narrow window adaptive view
        self.switcher_bar = Adw.ViewSwitcherBar()
        if hasattr(self.switcher_bar, 'set_view_stack'):
            self.switcher_bar.set_view_stack(self.view_stack)
        else:
            self.switcher_bar.set_stack(self.view_stack)

        self.toolbar_view.add_bottom_bar(self.switcher_bar)
        self.switcher_title.bind_property(
            "title-visible",
            self.switcher_bar,
            "reveal",
            GObject.BindingFlags.SYNC_CREATE
        )

        # Build Tab Pages
        page_updates = self.build_updates_page()
        page_colors = self.build_colors_page()
        page_drivers = self.build_drivers_page()
        page_containers = self.build_containers_page()

        self.view_stack.add_titled_with_icon(
            page_updates, "updates", t("tab_updates"), safe_icon(["software-update-available-symbolic", "system-software-update-symbolic"])
        )
        self.view_stack.add_titled_with_icon(
            page_colors, "colors", t("tab_colors"), safe_icon(["preferences-desktop-appearance-symbolic"])
        )
        self.view_stack.add_titled_with_icon(
            page_drivers, "drivers", t("tab_drivers"), safe_icon(["video-display-symbolic"])
        )
        self.view_stack.add_titled_with_icon(
            page_containers, "containers", t("tab_containers"), safe_icon(["package-x-generic-symbolic"])
        )

        self.toolbar_view.set_content(self.view_stack)

        # Initial Tab Selection
        self.set_active_tab(initial_tab)

    def set_active_tab(self, tab_name):
        if tab_name in ("updates", "colors", "drivers", "containers"):
            self.view_stack.set_visible_child_name(tab_name)
            if tab_name == "updates":
                self.check_initial_reboot_status()

    # =========================================================================
    # TAB 1: UPDATES
    # =========================================================================
    def build_updates_page(self):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_propagate_natural_height(False)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(640)
        clamp.set_tightening_threshold(480)
        scrolled.set_child(clamp)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.set_margin_top(20)
        content.set_margin_bottom(24)
        content.set_margin_start(20)
        content.set_margin_end(20)
        clamp.set_child(content)

        # Unified Banner Header
        header = self.build_page_header(
            ["software-update-available-symbolic", "system-software-update-symbolic"],
            t("upd_banner_title"),
            t("upd_banner_desc")
        )
        content.append(header)

        # Target Switches Group
        pref_group = Adw.PreferencesGroup()
        pref_group.set_title(t("upd_group_targets"))
        content.append(pref_group)

        self.sys_row = Adw.SwitchRow()
        self.sys_row.set_use_markup(False)
        self.sys_row.set_title(t("upd_sys_title"))
        self.sys_row.set_subtitle(t("upd_sys_desc"))
        self.sys_row.set_active(True)
        pref_group.add(self.sys_row)

        self.flatpak_row = Adw.SwitchRow()
        self.flatpak_row.set_use_markup(False)
        self.flatpak_row.set_title(t("upd_flatpak_title"))
        self.flatpak_row.set_subtitle(t("upd_flatpak_desc"))
        self.flatpak_row.set_active(True)
        pref_group.add(self.flatpak_row)

        self.box_row = Adw.SwitchRow()
        self.box_row.set_use_markup(False)
        self.box_row.set_title(t("upd_box_title"))
        self.box_row.set_subtitle(t("upd_box_desc"))
