    # =========================================================================
    def _create_drv_progress_widgets(self, parent_box):
        self.drv_progress_group = Adw.PreferencesGroup()
        self.drv_progress_group.set_visible(False)
        parent_box.append(self.drv_progress_group)

        self.drv_progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.drv_progress_box.set_margin_top(6)
        self.drv_progress_box.set_margin_bottom(6)
        self.drv_progress_group.add(self.drv_progress_box)

        self.drv_progress_bar = Gtk.ProgressBar()
        self.drv_progress_bar.set_show_text(True)
        self.drv_progress_bar.set_pulse_step(0.08)
        self.drv_progress_box.append(self.drv_progress_bar)

        self.lbl_drv_status = Gtk.Label(label=t("drv_preparing"))
        self.lbl_drv_status.set_halign(Gtk.Align.START)
        self.lbl_drv_status.set_wrap(True)
        self.lbl_drv_status.add_css_class("dim-label")
        self.drv_progress_box.append(self.lbl_drv_status)

        self.lbl_drv_note = Gtk.Label(label=t("drv_compile_notice"))
        self.lbl_drv_note.set_wrap(True)
        self.lbl_drv_note.set_halign(Gtk.Align.START)
        self.lbl_drv_note.add_css_class("dim-label")
        self.lbl_drv_note.add_css_class("caption")
        self.drv_progress_box.append(self.lbl_drv_note)

        self.drv_expander = Gtk.Expander.new(t("drv_log_expander"))
        self.drv_expander.set_expanded(True)
        self.drv_progress_box.append(self.drv_expander)

        log_scrolled = Gtk.ScrolledWindow()
        log_scrolled.set_min_content_height(170)
        log_scrolled.set_max_content_height(260)
        log_scrolled.set_propagate_natural_height(False)
