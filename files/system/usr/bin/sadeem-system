        pref_group.add(self.box_row)

        # Stage 3: Results Summary Card (PreferencesGroup under target switches)
        self.upd_results_group = Adw.PreferencesGroup()
        self.upd_results_group.set_title(t("upd_results_title"))
        self.upd_results_group.set_visible(False)
        self.upd_result_rows = []
        content.append(self.upd_results_group)

        # Progress / Status Area
        self.upd_progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.upd_spinner = Gtk.Spinner()
        self.upd_spinner.set_visible(False)
