        self.drv_text_buffer = Gtk.TextBuffer()
        self.drv_text_view = Gtk.TextView.new_with_buffer(self.drv_text_buffer)
        self.drv_text_view.set_editable(False)
        self.drv_text_view.set_cursor_visible(False)
        self.drv_text_view.set_monospace(True)
        self.drv_text_view.set_left_margin(12)
        self.drv_text_view.set_right_margin(12)
        self.drv_text_view.set_top_margin(10)
        self.drv_text_view.set_bottom_margin(10)
        log_scrolled.set_child(self.drv_text_view)

        self.btn_reboot_drivers = Gtk.Button(label=t("btn_reboot_drivers"))
        self.btn_reboot_drivers.add_css_class("suggested-action")
        self.btn_reboot_drivers.add_css_class("pill")
        self.btn_reboot_drivers.set_size_request(-1, 48)
        self.btn_reboot_drivers.set_visible(False)
        self.btn_reboot_drivers.connect("clicked", lambda b: trigger_system_reboot())
        self.drv_progress_box.append(self.btn_reboot_drivers)

    def build_drivers_page(self):
        self.drv_checkboxes = []
        self.drv_busy = False
        self.drv_pulse_timer = None
        self.drv_last_scan = None

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_propagate_natural_height(False)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(720)
        clamp.set_tightening_threshold(520)
        scrolled.set_child(clamp)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        content.set_margin_top(20)
        content.set_margin_bottom(28)
        content.set_margin_start(20)
        content.set_margin_end(20)
        clamp.set_child(content)

        header = self.build_page_header(
            ["video-display-symbolic", "applications-system-symbolic", "computer-symbolic"],
            t("drv_banner_title"),
            t("drv_banner_desc")
        )
        content.append(header)

        # Top rescan button bar
        top_btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        top_btn_box.set_halign(Gtk.Align.CENTER)
        content.append(top_btn_box)

        self.btn_drv_rescan = Gtk.Button()
        rescan_inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        rescan_inner.append(Gtk.Image.new_from_icon_name(safe_icon(["view-refresh-symbolic"])))
        rescan_inner.append(Gtk.Label(label=t("drv_rescan_btn")))
        self.btn_drv_rescan.set_child(rescan_inner)
        self.btn_drv_rescan.add_css_class("pill")
        self.btn_drv_rescan.connect("clicked", lambda b: self.start_hardware_scan())
        top_btn_box.append(self.btn_drv_rescan)

        # Scanning spinner state
        self.drv_loading_group = Adw.PreferencesGroup()
        content.append(self.drv_loading_group)

        loading_row = Adw.ActionRow(
            title=t("drv_scanning_title"),
            subtitle=t("drv_scanning_desc")
        )
        loading_row.set_use_markup(False)
        self.drv_spinner = Gtk.Spinner()
        self.drv_spinner.set_spinning(True)
        self.drv_spinner.set_size_request(24, 24)
        loading_row.add_prefix(self.drv_spinner)
        self.drv_loading_group.add(loading_row)

        # Dynamic hardware & driver groups container
        self.drv_dynamic_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        content.append(self.drv_dynamic_box)

        # Persistent progress & live log container
        self._create_drv_progress_widgets(content)

        # Launch non-blocking initial hardware scan
        self.start_hardware_scan()
        return scrolled

    def start_hardware_scan(self):
        if self.drv_busy:
            return
        self.btn_drv_rescan.set_sensitive(False)
        self.drv_loading_group.set_visible(True)
        self.drv_spinner.set_spinning(True)

        def _worker():
            try:
                data = analyze_hardware_and_drivers()
            except Exception as exc:
                data = {
                    "recommendations": [],
                    "firmware_updates": [],
                    "devices_by_category": {k: [] for k, _, _ in HARDWARE_CATEGORIES},
                    "sb_enabled": False,
                    "needs_mok": False,
                    "nvidia_state": {"has_gpu": False, "active": False, "layered_inactive": False, "unsupported": False, "layered_pkgs": [], "gpu_names": []},
                    "error": str(exc),
                }
            GLib.idle_add(self._populate_drivers_ui, data)

        threading.Thread(target=_worker, daemon=True).start()

    def _clear_box(self, box):
        child = box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            box.remove(child)
            child = nxt

    def _populate_drivers_ui(self, scan_data):
        self.drv_last_scan = scan_data
        self.drv_loading_group.set_visible(False)
        self.drv_spinner.set_spinning(False)
        self.btn_drv_rescan.set_sensitive(True)

        self._clear_box(self.drv_dynamic_box)
        self.drv_checkboxes = []
        self.btn_install_selected = None
        self.btn_install_fw = None
        self.btn_enroll_mok = None
        self.btn_fix_kargs = None
        self.btn_uninstall_driver = None

        recs = scan_data.get("recommendations", [])
        fw_updates = scan_data.get("firmware_updates", [])
        devices_by_cat = scan_data.get("devices_by_category", {})
        sb_enabled = scan_data.get("sb_enabled", False)
        needs_mok = scan_data.get("needs_mok", False)
        nv_state = scan_data.get("nvidia_state", {})

        cat_icon_map = {k: icons for k, _, icons in HARDWARE_CATEGORIES}

        # 1. Secure Boot Alert Banner (when enabled)
        if sb_enabled:
            sb_group = Adw.PreferencesGroup(title=t("drv_sb_title"))
            self.drv_dynamic_box.append(sb_group)

            sb_row = Adw.ActionRow()
            sb_row.set_use_markup(False)
            sb_row.set_title(t("drv_sb_enabled_title"))
            sb_row.set_subtitle(t("drv_sb_needs_mok_desc") if needs_mok else t("drv_sb_enrolled_desc"))
            sb_row.set_subtitle_lines(3)
            sb_icon = Gtk.Image.new_from_icon_name(
                safe_icon(["dialog-warning-symbolic", "channel-secure-symbolic"] if needs_mok else ["channel-secure-symbolic", "security-high-symbolic"])
            )
            if needs_mok:
                sb_icon.add_css_class("drv-status-warn")
            else:
                sb_icon.add_css_class("drv-status-ok")
            sb_row.add_prefix(sb_icon)

            self.btn_enroll_mok = Gtk.Button(label=t("drv_mok_enroll_btn"))
            self.btn_enroll_mok.set_valign(Gtk.Align.CENTER)
            if needs_mok:
                self.btn_enroll_mok.add_css_class("suggested-action")
            self.btn_enroll_mok.add_css_class("pill")
            self.btn_enroll_mok.connect("clicked", self.on_enroll_mok_clicked)
            sb_row.add_suffix(self.btn_enroll_mok)
            sb_group.add(sb_row)

        # 2. Prominent Top Section: Available Drivers & Updates
        avail_group = Adw.PreferencesGroup(
            title=t("drv_available_title"),
            description=t("drv_available_desc") if recs else ""
        )
        self.drv_dynamic_box.append(avail_group)

        if recs:
            for rec in recs:
                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(rec["title"])
                pkg_line = t("drv_packages_label", pkgs=", ".join(rec["packages"]))
                row.set_subtitle(f"{rec['desc']}\n{pkg_line}")
                row.set_subtitle_lines(4)

                cb = Gtk.CheckButton()
                cb.set_active(rec.get("default_selected", True))
                cb.set_valign(Gtk.Align.CENTER)
                cb.connect("toggled", self._update_install_selected_btn)
                row.add_prefix(cb)

                cat_ico = Gtk.Image.new_from_icon_name(safe_icon(cat_icon_map.get(rec.get("category", "other"), ["package-x-generic-symbolic"])))
                cat_ico.set_valign(Gtk.Align.CENTER)
                row.add_prefix(cat_ico)

                badge = Gtk.Label(label=t("drv_optional_badge") if rec.get("optional") else t("drv_recommended_badge"))
                badge.set_valign(Gtk.Align.CENTER)
                badge.add_css_class("drv-badge-opt" if rec.get("optional") else "drv-badge-rec")
                row.add_suffix(badge)

                row.set_activatable_widget(cb)
                avail_group.add(row)
                self.drv_checkboxes.append((cb, rec))

            install_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            install_box.set_margin_top(12)
            self.btn_install_selected = Gtk.Button(label=t("drv_install_selected"))
            self.btn_install_selected.add_css_class("suggested-action")
            self.btn_install_selected.add_css_class("pill")
            self.btn_install_selected.set_size_request(-1, 50)
            self.btn_install_selected.connect("clicked", self.on_install_selected_clicked)
            install_box.append(self.btn_install_selected)
            avail_group.add(install_box)
            self._update_install_selected_btn()
        elif not fw_updates and not nv_state.get("layered_inactive"):
            ok_row = Adw.ActionRow()
            ok_row.set_use_markup(False)
            ok_row.set_title(t("drv_all_ok_title"))
            ok_row.set_subtitle(t("drv_all_ok_desc"))
            ok_row.set_subtitle_lines(3)
            ok_ico = Gtk.Image.new_from_icon_name(safe_icon(["emblem-ok-symbolic", "object-select-symbolic"]))
            ok_ico.add_css_class("drv-status-ok")
            ok_row.add_prefix(ok_ico)
            avail_group.add(ok_row)

        # 2b. NVIDIA Layered Status / Quick Maintenance Actions (active, inactive, or legacy)
        if nv_state.get("layered_inactive"):
            nv_group = Adw.PreferencesGroup(title=t("drv_inactive_title"))
            self.drv_dynamic_box.append(nv_group)

            warn_row = Adw.ActionRow()
            warn_row.set_use_markup(False)
            warn_row.set_title(", ".join(nv_state.get("layered_pkgs", [])))
            warn_row.set_subtitle(t("drv_inactive_desc"))
            warn_row.set_subtitle_lines(4)
            w_ico = Gtk.Image.new_from_icon_name(safe_icon(["dialog-warning-symbolic"]))
            w_ico.add_css_class("drv-status-warn")
            warn_row.add_prefix(w_ico)
            nv_group.add(warn_row)

            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            btn_box.set_margin_top(10)
            btn_box.set_homogeneous(True)

            self.btn_fix_kargs = Gtk.Button(label=t("btn_fix_kargs"))
            self.btn_fix_kargs.add_css_class("suggested-action")
            self.btn_fix_kargs.add_css_class("pill")
            self.btn_fix_kargs.set_size_request(-1, 46)
            self.btn_fix_kargs.connect("clicked", lambda b: self.on_fix_kargs_clicked())
            btn_box.append(self.btn_fix_kargs)

            self.btn_uninstall_driver = Gtk.Button(label=t("btn_uninstall_driver"))
            self.btn_uninstall_driver.add_css_class("destructive-action")
            self.btn_uninstall_driver.add_css_class("pill")
            self.btn_uninstall_driver.set_size_request(-1, 46)
            self.btn_uninstall_driver.connect("clicked", lambda b: self.on_uninstall_drivers_clicked(nv_state.get("layered_pkgs", [])))
            btn_box.append(self.btn_uninstall_driver)
            nv_group.add(btn_box)
        elif nv_state.get("active"):
            nv_group = Adw.PreferencesGroup()
            self.drv_dynamic_box.append(nv_group)

            act_row = Adw.ActionRow()
            act_row.set_use_markup(False)
            act_row.set_title(t("drv_installed_title"))
            act_row.set_subtitle(", ".join(nv_state.get("layered_pkgs", [])))
            ok_ico = Gtk.Image.new_from_icon_name(safe_icon(["emblem-ok-symbolic"]))
            ok_ico.add_css_class("drv-status-ok")
            act_row.add_prefix(ok_ico)

            self.btn_uninstall_driver = Gtk.Button(label=t("btn_uninstall_driver"))
            self.btn_uninstall_driver.add_css_class("destructive-action")
            self.btn_uninstall_driver.add_css_class("pill")
            self.btn_uninstall_driver.set_valign(Gtk.Align.CENTER)
            self.btn_uninstall_driver.connect("clicked", lambda b: self.on_uninstall_drivers_clicked(nv_state.get("layered_pkgs", [])))
            act_row.add_suffix(self.btn_uninstall_driver)
            nv_group.add(act_row)
        elif nv_state.get("unsupported"):
            nv_group = Adw.PreferencesGroup()
            self.drv_dynamic_box.append(nv_group)

            leg_row = Adw.ActionRow()
            leg_row.set_use_markup(False)
            leg_row.set_title(t("drv_unsupported_title"))
            leg_row.set_subtitle(t("drv_unsupported_desc"))
            leg_row.set_subtitle_lines(4)
            leg_row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["dialog-information-symbolic", "video-display-symbolic"])))
            nv_group.add(leg_row)

        # 3. Firmware Updates Section (fwupd)
        if fw_updates:
            fw_group = Adw.PreferencesGroup(
                title=t("drv_fw_group_title"),
                description=t("drv_fw_group_desc")
            )
            self.drv_dynamic_box.append(fw_group)

            for fw in fw_updates:
                frow = Adw.ActionRow()
                frow.set_use_markup(False)
                ver_str = f"{fw.get('current_version', '')} → {fw.get('new_version', '')}".strip(" →")
                frow.set_title(f"{fw.get('name', 'Firmware')} ({ver_str})" if ver_str else fw.get("name", "Firmware"))
                sub_parts = [p for p in (fw.get("vendor", ""), fw.get("summary", "")) if p]
                frow.set_subtitle(" — ".join(sub_parts) if sub_parts else "LVFS / fwupd")
                frow.set_subtitle_lines(3)
                frow.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["software-update-available-symbolic", "computer-symbolic"])))
                fw_group.add(frow)

            fw_btn_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            fw_btn_box.set_margin_top(10)
            self.btn_install_fw = Gtk.Button(label=t("drv_fw_install_btn"))
            self.btn_install_fw.add_css_class("suggested-action")
            self.btn_install_fw.add_css_class("pill")
            self.btn_install_fw.set_size_request(-1, 46)
            self.btn_install_fw.connect("clicked", self.on_install_fw_clicked)
            fw_btn_box.append(self.btn_install_fw)
            fw_group.add(fw_btn_box)

        # 4. Bottom Organized Section: Automatically Configured Hardware
        hw_group = Adw.PreferencesGroup(
            title=t("drv_auto_hw_title"),
            description=t("drv_auto_hw_desc")
        )
        self.drv_dynamic_box.append(hw_group)

        for cat_key, cat_tkey, cat_icons in HARDWARE_CATEGORIES:
            devs = devices_by_cat.get(cat_key, [])
            if not devs:
                continue
            missing_cnt = sum(1 for d in devs if not d.get("driver"))
            exp = Adw.ExpanderRow()
            exp.set_use_markup(False)
            exp.set_title(t(cat_tkey))
            if missing_cnt > 0:
                exp.set_subtitle(t("drv_cat_summary_missing", count=len(devs), missing=missing_cnt))
            else:
                exp.set_subtitle(t("drv_cat_summary", count=len(devs)))
            exp.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(cat_icons)))
            exp.set_expanded(cat_key in ("gpu", "network", "audio") or missing_cnt > 0)

            for dev in devs:
                drow = Adw.ActionRow()
                drow.set_use_markup(False)
                drow.set_title(dev.get("name", "Unknown Device"))
                drv_name = dev.get("driver", "")
                drv_txt = t("drv_active_driver", driver=drv_name) if drv_name else t("drv_no_driver")
                vid = dev.get("vendor_id", "")
                did = dev.get("device_id", "")
                id_txt = f" [{vid}:{did}]" if vid and did and vid not in ("iio", "input", "spi") else ""
                drow.set_subtitle(f"{drv_txt}{id_txt}")
                drow.set_subtitle_lines(2)

                st_icon = Gtk.Image.new_from_icon_name(
                    safe_icon(["emblem-ok-symbolic", "object-select-symbolic"] if drv_name else ["dialog-warning-symbolic"])
                )
                st_icon.add_css_class("drv-status-ok" if drv_name else "drv-status-warn")
                drow.add_suffix(st_icon)
                exp.add_row(drow)

            hw_group.add(exp)

        return False

    def _update_install_selected_btn(self, *_args):
        if not getattr(self, "btn_install_selected", None):
            return
        selected_count = sum(1 for cb, _ in self.drv_checkboxes if cb.get_active())
        self.btn_install_selected.set_sensitive((not self.drv_busy) and selected_count > 0)
        if selected_count > 0:
            self.btn_install_selected.set_label(t("drv_install_selected_count", count=selected_count))
        else:
            self.btn_install_selected.set_label(t("drv_install_selected"))

    def _set_drv_controls_sensitive(self, sensitive):
        self.drv_busy = not sensitive
        if getattr(self, "btn_drv_rescan", None):
            self.btn_drv_rescan.set_sensitive(sensitive)
        for cb, _ in getattr(self, "drv_checkboxes", []):
            cb.set_sensitive(sensitive)
        if getattr(self, "btn_install_selected", None):
            if sensitive:
                self._update_install_selected_btn()
            else:
                self.btn_install_selected.set_sensitive(False)
        if getattr(self, "btn_install_fw", None):
            self.btn_install_fw.set_sensitive(sensitive)
        if getattr(self, "btn_enroll_mok", None):
            self.btn_enroll_mok.set_sensitive(sensitive)
        if getattr(self, "btn_fix_kargs", None):
            self.btn_fix_kargs.set_sensitive(sensitive)
        if getattr(self, "btn_uninstall_driver", None):
            self.btn_uninstall_driver.set_sensitive(sensitive)

    def _set_drv_progress(self, fraction, status_text=None):
        def _upd():
            self.drv_progress_bar.set_fraction(max(0.0, min(1.0, fraction)))
            pct = int(round(max(0.0, min(1.0, fraction)) * 100))
            self.drv_progress_bar.set_text(f"{pct}%")
            if status_text is not None:
                self.lbl_drv_status.set_text(status_text)
            return False
        GLib.idle_add(_upd)

    def append_drv_log(self, text):
        end_iter = self.drv_text_buffer.get_end_iter()
        self.drv_text_buffer.insert(end_iter, text)
        mark = self.drv_text_buffer.create_mark(None, self.drv_text_buffer.get_end_iter(), False)
        self.drv_text_view.scroll_to_mark(mark, 0.05, False, 0.0, 1.0)
        return False

    def _start_drv_operation_ui(self, initial_status):
        self._set_drv_controls_sensitive(False)
        self.drv_progress_group.set_visible(True)
        self.btn_reboot_drivers.set_visible(False)
        self.drv_text_buffer.set_text("")
        self.drv_progress_bar.set_fraction(0.05)
        self.drv_progress_bar.set_text("5%")
        self.lbl_drv_status.set_text(initial_status)

    def _finish_drv_operation(self, rc, success_msg, show_reboot=True):
        if getattr(self, "drv_pulse_timer", None):
            GLib.source_remove(self.drv_pulse_timer)
            self.drv_pulse_timer = None

        self._set_drv_controls_sensitive(True)

        if rc == 0:
            self.drv_progress_bar.set_fraction(1.0)
            self.drv_progress_bar.set_text("100%")
            self.lbl_drv_status.set_text(success_msg)
            if show_reboot:
                self.btn_reboot_drivers.set_visible(True)
            toast = Adw.Toast.new(success_msg)
            self.toast_overlay.add_toast(toast)
        elif rc in (126, 127):
            self.drv_progress_bar.set_fraction(0.0)
            self.drv_progress_bar.set_text("0%")
            self.lbl_drv_status.set_text(t("drv_auth_cancelled"))
            self.append_drv_log(f"\n[{t('drv_auth_cancelled')}]\n")
            toast = Adw.Toast.new(t("drv_auth_cancelled"))
            self.toast_overlay.add_toast(toast)
        else:
            self.drv_progress_bar.set_fraction(0.0)
            self.drv_progress_bar.set_text("0%")
            self.lbl_drv_status.set_text(t("drv_error"))
            toast = Adw.Toast.new(t("drv_error"))
            self.toast_overlay.add_toast(toast)
        return False

    def on_install_selected_clicked(self, *_args):
        selected = [rec for cb, rec in self.drv_checkboxes if cb.get_active()]
        if not selected:
            self.toast_overlay.add_toast(Adw.Toast.new(t("drv_select_one_warn")))
            return

        self._start_drv_operation_ui(t("drv_stage_auth"))
        threading.Thread(
            target=self.run_selected_drivers_thread,
            args=(selected,),
            daemon=True
        ).start()

    def run_selected_drivers_thread(self, selected_recs):
        pkgs = []
        needs_nv_kargs = False
        needs_akmods = False
        needs_fprintd = False

        for rec in selected_recs:
            for p in rec.get("packages", []):
                if p not in pkgs:
                    pkgs.append(p)
            if rec.get("needs_nvidia_kargs"):
                needs_nv_kargs = True
            if rec.get("needs_akmods"):
                needs_akmods = True
            if rec.get("needs_fprintd_enable"):
                needs_fprintd = True

        quoted_pkgs = " ".join(shlex.quote(p) for p in pkgs)
        script_lines = [
            "set -e",
            "echo '===SADEEM_STAGE:DOWNLOADING==='",
            f"echo 'Installing packages via rpm-ostree: {' '.join(pkgs)}'",
            f"rpm-ostree install -y --idempotent {quoted_pkgs}",
        ]

        if needs_nv_kargs:
            script_lines.extend([
                "echo '===SADEEM_STAGE:LAYERING==='",
                "echo 'Configuring NVIDIA kernel boot arguments (kargs)...'",
                'rpm-ostree kargs --append-if-missing="rd.driver.blacklist=nouveau" --append-if-missing="modprobe.blacklist=nouveau" --append-if-missing="nvidia-drm.modeset=1"',
            ])

        if needs_akmods:
            script_lines.extend([
                "echo '===SADEEM_STAGE:AKMODS==='",
                "echo 'Building kernel modules (akmods)...'",
                "akmods --force 2>&1 || true",
            ])

        if needs_fprintd:
            script_lines.extend([
                "echo 'Enabling fingerprint service and PAM integration...'",
                "systemctl enable fprintd.service 2>/dev/null || true",
                "authselect enable-feature with-fingerprint 2>/dev/null || true",
            ])

        script_lines.append("echo '===SADEEM_STAGE:DONE==='")
        full_script = "\n".join(script_lines)

        try:
            self._set_drv_progress(0.12, t("drv_stage_auth"))
            proc = subprocess.Popen(
                ["pkexec", "/usr/bin/bash", "-c", full_script],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            current_frac = 0.15
            for line in proc.stdout:
                clean = line.strip()
                low = clean.lower()
                if "===SADEEM_STAGE:DOWNLOADING===" in clean:
                    current_frac = max(current_frac, 0.22)
                    self._set_drv_progress(current_frac, t("drv_stage_downloading"))
                    continue
                if "===SADEEM_STAGE:LAYERING===" in clean:
                    current_frac = max(current_frac, 0.72)
                    self._set_drv_progress(current_frac, t("drv_stage_layering"))
                    continue
                if "===SADEEM_STAGE:AKMODS===" in clean:
                    current_frac = max(current_frac, 0.85)
                    self._set_drv_progress(current_frac, t("drv_stage_akmods"))
                    continue
                if "===SADEEM_STAGE:DONE===" in clean:
                    current_frac = 0.98
                    self._set_drv_progress(current_frac, t("drv_stage_complete"))
                    continue

                GLib.idle_add(self.append_drv_log, line)

                if any(k in low for k in ("downloading", "fetching", "receiving")):
                    current_frac = min(0.55, current_frac + 0.02)
                    self._set_drv_progress(current_frac, t("drv_stage_downloading"))
                elif any(k in low for k in ("checking out", "importing", "applying", "staging", "writing", "running post")):
                    current_frac = min(0.78, max(current_frac + 0.03, 0.58))
                    self._set_drv_progress(current_frac, t("drv_stage_layering"))
                elif "akmod" in low or "building" in low:
                    current_frac = min(0.94, max(current_frac + 0.02, 0.84))
                    self._set_drv_progress(current_frac, t("drv_stage_akmods"))

            rc = proc.wait()
            GLib.idle_add(self._finish_drv_operation, rc, t("drv_done"), True)
        except Exception as e:
            GLib.idle_add(self.append_drv_log, f"\n[Error]: {e}\n")
            GLib.idle_add(self._finish_drv_operation, 1, t("drv_done"), True)

    def on_install_fw_clicked(self, *_args):
        self._start_drv_operation_ui(t("drv_fw_updating"))
        threading.Thread(target=self.run_fw_update_thread, daemon=True).start()

    def run_fw_update_thread(self):
        try:
            self._set_drv_progress(0.20, t("drv_fw_updating"))
            proc = subprocess.Popen(
                ["pkexec", "fwupdmgr", "update", "-y"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            frac = 0.25
            for line in proc.stdout:
                GLib.idle_add(self.append_drv_log, line)
                m = re.search(r'(\d{1,3})%', line)
                if m:
                    val = int(m.group(1))
                    if 0 <= val <= 100:
                        frac = max(frac, 0.20 + (val / 100.0) * 0.75)
                        self._set_drv_progress(min(0.95, frac), t("drv_fw_updating"))
                else:
                    frac = min(0.92, frac + 0.02)
                    self._set_drv_progress(frac, t("drv_fw_updating"))
            rc = proc.wait()
            # fwupdmgr exit code 2 means nothing to do / already updated
            norm_rc = 0 if rc in (0, 2) else rc
            GLib.idle_add(self._finish_drv_operation, norm_rc, t("drv_fw_done"), True)
        except Exception as e:
            GLib.idle_add(self.append_drv_log, f"\n[Error]: {e}\n")
            GLib.idle_add(self._finish_drv_operation, 1, t("drv_fw_done"), True)

    def on_enroll_mok_clicked(self, *_args):
        dialog = Gtk.Window(transient_for=self, modal=True)
        dialog.set_title(t("drv_mok_dialog_title"))
        dialog.set_default_size(440, -1)
        dialog.set_resizable(False)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_margin_top(20)
        box.set_margin_bottom(20)
        box.set_margin_start(20)
        box.set_margin_end(20)
        dialog.set_child(box)

        lbl_title = Gtk.Label(label=t("drv_mok_dialog_title"))
        lbl_title.add_css_class("title-3")
        lbl_title.set_halign(Gtk.Align.START)
        box.append(lbl_title)

        lbl_body = Gtk.Label(label=t("drv_mok_dialog_body"))
        lbl_body.set_wrap(True)
        lbl_body.set_halign(Gtk.Align.START)
        lbl_body.add_css_class("dim-label")
        box.append(lbl_body)

        entry = Gtk.PasswordEntry()
        entry.set_show_peek_icon(True)
        entry.set_property("placeholder-text", t("drv_mok_pass"))
        box.append(entry)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_row.set_halign(Gtk.Align.END)
        btn_row.set_margin_top(6)
        box.append(btn_row)

        btn_cancel = Gtk.Button(label=t("drv_cancel"))
        btn_cancel.add_css_class("pill")
        btn_cancel.connect("clicked", lambda b: dialog.close())
        btn_row.append(btn_cancel)

        btn_ok = Gtk.Button(label=t("drv_confirm"))
        btn_ok.add_css_class("suggested-action")
        btn_ok.add_css_class("pill")
        btn_row.append(btn_ok)

        def _submit(*_a):
            pw = entry.get_text().strip()
            if len(pw) < 8:
                self.toast_overlay.add_toast(Adw.Toast.new(t("drv_mok_dialog_body")))
                return
            dialog.close()
            self._start_drv_operation_ui(t("drv_mok_enrolling"))
            threading.Thread(target=self.run_mok_enroll_thread, args=(pw,), daemon=True).start()

        btn_ok.connect("clicked", _submit)
        entry.connect("activate", _submit)
        dialog.present()

    def run_mok_enroll_thread(self, mok_pass):
        qpass = shlex.quote(mok_pass)
        script = f"""set -e
if [ ! -f /etc/pki/akmods/certs/public_key.der ]; then
    echo 'Generating akmods Secure Boot signing key...'
    kmodgenca -a || true
fi
if [ -f /etc/pki/akmods/certs/public_key.der ]; then
    printf '%s\\n%s\\n' {qpass} {qpass} | mokutil --import /etc/pki/akmods/certs/public_key.der
    echo 'MOK signing key imported successfully.'
else
    echo 'Error: /etc/pki/akmods/certs/public_key.der not found.' >&2
    exit 1
fi
"""
        try:
            self._set_drv_progress(0.35, t("drv_mok_enrolling"))
            proc = subprocess.Popen(
                ["pkexec", "/usr/bin/bash", "-c", script],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in proc.stdout:
                GLib.idle_add(self.append_drv_log, line)
            rc = proc.wait()
            GLib.idle_add(self._finish_drv_operation, rc, t("drv_mok_done"), True)
        except Exception as e:
            GLib.idle_add(self.append_drv_log, f"\n[Error]: {e}\n")
            GLib.idle_add(self._finish_drv_operation, 1, t("drv_mok_done"), True)

    def on_fix_kargs_clicked(self):
        self._start_drv_operation_ui(t("drv_fixing_kargs"))
        threading.Thread(target=self.run_fix_kargs_thread, daemon=True).start()

    def run_fix_kargs_thread(self):
        script = """set -e
echo '[1/2] Blacklisting nouveau & enabling nvidia-drm modeset...'
rpm-ostree kargs --append-if-missing="rd.driver.blacklist=nouveau" --append-if-missing="modprobe.blacklist=nouveau" --append-if-missing="nvidia-drm.modeset=1"
echo '[2/2] Ensuring NVIDIA kernel modules (akmods)...'
akmods --force 2>&1 || true
echo 'Kernel arguments updated successfully! Please reboot.'
"""
        try:
            self._set_drv_progress(0.30, t("drv_fixing_kargs"))
            proc = subprocess.Popen(
                ["pkexec", "/usr/bin/bash", "-c", script],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in proc.stdout:
                GLib.idle_add(self.append_drv_log, line)
            rc = proc.wait()
            GLib.idle_add(self._finish_drv_operation, rc, t("drv_done"), True)
        except Exception as e:
            GLib.idle_add(self.append_drv_log, f"\n[Error]: {e}\n")
            GLib.idle_add(self._finish_drv_operation, 1, t("drv_done"), True)

    def on_uninstall_drivers_clicked(self, pkgs):
        self._start_drv_operation_ui(t("drv_uninstalling"))
        threading.Thread(target=self.run_uninstall_thread, args=(pkgs,), daemon=True).start()

    def run_uninstall_thread(self, pkgs):
        quoted_pkgs = " ".join(shlex.quote(p) for p in pkgs)
        script = f"""set -e
echo '[1/2] Uninstalling NVIDIA driver packages: {' '.join(pkgs)}'
rpm-ostree uninstall {quoted_pkgs} || true
echo '[2/2] Removing nouveau blacklist from kargs...'
rpm-ostree kargs --delete-if-present="rd.driver.blacklist=nouveau" --delete-if-present="modprobe.blacklist=nouveau" --delete-if-present="nvidia-drm.modeset=1" || true
echo 'NVIDIA driver uninstalled! Please restart.'
"""
        try:
            self._set_drv_progress(0.35, t("drv_uninstalling"))
            proc = subprocess.Popen(
                ["pkexec", "/usr/bin/bash", "-c", script],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            for line in proc.stdout:
                GLib.idle_add(self.append_drv_log, line)
            rc = proc.wait()
            GLib.idle_add(self._finish_drv_operation, rc, t("drv_uninstalled_done"), True)
        except Exception as e:
            GLib.idle_add(self.append_drv_log, f"\n[Error]: {e}\n")
            GLib.idle_add(self._finish_drv_operation, 1, t("drv_uninstalled_done"), True)

