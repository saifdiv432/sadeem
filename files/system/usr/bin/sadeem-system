        self.upd_status_label = Gtk.Label(label=t("status_ready"))
        self.upd_status_label.add_css_class("body")
        self.upd_status_label.set_halign(Gtk.Align.START)
        status_box.append(self.upd_status_label)
        self.upd_progress_box.append(status_box)

        self.upd_progress_bar = Gtk.ProgressBar()
        self.upd_progress_bar.set_show_text(True)
        self.upd_progress_bar.set_fraction(0.0)
        self.upd_progress_bar.set_text("0%")
        self.upd_progress_bar.set_visible(False)
        self.upd_progress_box.append(self.upd_progress_bar)
        content.append(self.upd_progress_box)

        # Action Buttons (Primary button: "Check for Updates" by default)
