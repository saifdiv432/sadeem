    def stop_all_upd_timers(self):
        def _stop():
            if getattr(self, "_upd_pulse_timer", None) is not None:
                try:
                    GLib.source_remove(self._upd_pulse_timer)
                except Exception:
                    pass
                self._upd_pulse_timer = None
            if getattr(self, "_upd_checking_timer", None) is not None:
                try:
                    GLib.source_remove(self._upd_checking_timer)
                except Exception:
                    pass
                self._upd_checking_timer = None
            if getattr(self, "_upd_staging_timer", None) is not None:
                try:
                    GLib.source_remove(self._upd_staging_timer)
                except Exception:
                    pass
                self._upd_staging_timer = None
            return False
        GLib.idle_add(_stop)

    def start_upd_pulse(self):
        def _ui_start():
            if getattr(self, "_upd_pulse_timer", None) is None:
                def _pulse():
                    self.upd_progress_bar.pulse()
                    return True
                self._upd_pulse_timer = GLib.timeout_add(120, _pulse)
            return False
        GLib.idle_add(_ui_start)

    def stop_upd_pulse(self):
        def _ui_stop():
            if getattr(self, "_upd_pulse_timer", None) is not None:
                try:
                    GLib.source_remove(self._upd_pulse_timer)
                except Exception:
                    pass
                self._upd_pulse_timer = None
            return False
        GLib.idle_add(_ui_stop)

    def update_upd_progress(self, fraction, text=None):
        self.stop_upd_pulse()
        frac = min(1.0, max(0.0, fraction))
        self._upd_current_frac = frac
        def _ui_update():
            self.upd_progress_bar.set_visible(True)
            self.upd_progress_bar.set_show_text(True)
            self.upd_progress_bar.set_fraction(frac)
            pct_text = text if text is not None else f"{int(round(frac * 100))}%"
            self.upd_progress_bar.set_text(pct_text)
            return False
        GLib.idle_add(_ui_update)

    def start_upd_checking_progression(self):
        def _start():
            self.stop_all_upd_timers()
            self.upd_status_label.set_text(t("status_sys_checking"))
            self.update_upd_progress(0.02)
            def _step():
                if getattr(self, "_upd_checking_timer", None) is None:
                    return False
                cur = getattr(self, "_upd_current_frac", 0.0)
                if cur < 0.15:
                    next_frac = min(0.15, cur + 0.01)
                    self.update_upd_progress(next_frac)
                    return True
                return False
            self._upd_checking_timer = GLib.timeout_add(250, _step)
            return False
        GLib.idle_add(_start)

    def start_upd_staging_progression(self):
        def _start():
            self.stop_all_upd_timers()
            self.upd_status_label.set_text(t("status_sys_staging"))
            self.update_upd_progress(0.70)
            def _step():
                if getattr(self, "_upd_staging_timer", None) is None:
                    return False
                cur = getattr(self, "_upd_current_frac", 0.70)
                if cur < 0.95:
                    next_frac = min(0.95, cur + 0.005)
                    self.update_upd_progress(next_frac)
                    return True
                return False
            self._upd_staging_timer = GLib.timeout_add(1500, _step)
            return False
        GLib.idle_add(_start)

    def append_upd_log(self, text):
        clean = re.sub(r'\x1b\[[0-9;?]*[a-zA-Z]', '', text).replace('\r', '').strip()
        if not clean:
            return
        def _append():
            buf = self.upd_text_view.get_buffer()
            end_iter = buf.get_end_iter()
            buf.insert(end_iter, clean + "\n")
            mark = buf.create_mark(None, buf.get_end_iter(), False)
            self.upd_text_view.scroll_to_mark(mark, 0.05, False, 0.0, 1.0)
            return False
        GLib.idle_add(_append)

    def start_checking(self):
        if getattr(self, "is_checking", False) or getattr(self, "is_updating", False):
            return

        run_sys = self.sys_row.get_active()
        run_flatpak = self.flatpak_row.get_active()
        run_box = self.box_row.get_active()

        if not (run_sys or run_flatpak or run_box):
            return

        self.is_checking = True
        self.btn_start_update.set_sensitive(False)
        self.sys_row.set_sensitive(False)
        self.flatpak_row.set_sensitive(False)
        self.box_row.set_sensitive(False)

        self.upd_progress_bar.set_visible(False)
        self.upd_spinner.set_visible(True)
        self.upd_spinner.start()
        self.upd_status_label.set_text(t("status_checking"))

        threading.Thread(
            target=self.check_for_updates_thread,
            args=(run_sys, run_flatpak, run_box),
            daemon=True
        ).start()

    def check_for_updates_thread(self, do_sys, do_flatpak, do_box):
        results = {
            "sys": {"has_update": False, "version": "", "diff": "", "digest": ""},
            "flatpak": {"has_update": False, "count": 0, "apps": []},
            "box": {"has_update": False, "count": 0}
        }

        # 1. rpm-ostree upgrade --check
        if do_sys:
            try:
                # 1. Clean locally cached metadata to guarantee pulling the latest digest from remote registry
                subprocess.run(["rpm-ostree", "cleanup", "-m"], capture_output=True, text=True, timeout=30, check=False)

                # Get currently booted image digest
                current_digest = get_current_booted_digest()

                # Run update check (exit code 0 indicates update available; exit code 77 indicates unchanged / no update)
                res = subprocess.run(["rpm-ostree", "upgrade", "--check"], capture_output=True, text=True, timeout=90, check=False)
                if res.returncode == 0:
                    out = res.stdout.strip()
                    has_available_section = ("AvailableUpdate" in out and "AvailableUpdate: none" not in out) or "Diff:" in out

                    if has_available_section:
                        # Extract incoming image digest from AvailableUpdate section
                        m_digest = re.search(r'Digest:\s*(sha256:[a-f0-9]+)', out, re.IGNORECASE)
                        if not m_digest:
                            m_digest = re.search(r'sha256:[a-f0-9]{64}', out)

                        new_digest = m_digest.group(1).strip() if (m_digest and m_digest.lastindex) else (m_digest.group(0).strip() if m_digest else "")

                        # Compare digests: same-day builds share identical Version (e.g. 45.20261117.0)
                        # but differ in sha256 digest
                        if new_digest and current_digest:
                            has_update = (new_digest != current_digest)
                        else:
                            # If digest couldn't be extracted, rely on returncode == 0 and AvailableUpdate/Diff section
                            has_update = True

                        if has_update:
                            results["sys"]["has_update"] = True
                            if new_digest:
                                results["sys"]["digest"] = new_digest
                            m_ver = re.search(r'Version:\s*([^\s\n]+)', out)
                            if m_ver:
                                results["sys"]["version"] = m_ver.group(1)
                            m_diff = re.search(r'Diff:\s*([^\n]+)', out)
                            if m_diff:
                                results["sys"]["diff"] = m_diff.group(1)
                            elif "Upgraded:" in out:
                                upg = [l.strip() for l in out.splitlines() if l.strip().startswith("Upgraded:")]
                                if upg:
                                    results["sys"]["diff"] = upg[0]
                            elif new_digest:
                                short_digest = new_digest.replace("sha256:", "")[:12]
                                results["sys"]["diff"] = f"Digest: {short_digest}..."
            except Exception:
                pass

        # 2. flatpak remote-ls --updates --columns=application,name,version,download-size
        if do_flatpak:
            try:
                res = subprocess.run(["flatpak", "remote-ls", "--updates", "--columns=application,name,version,download-size"], capture_output=True, text=True, timeout=60, check=False)
                if res.returncode == 0 and res.stdout.strip():
                    lines = [l.strip() for l in res.stdout.strip().splitlines() if l.strip()]
                    apps = []
                    for line in lines:
                        if line.startswith("Application ID") or "Download size" in line:
                            continue
                        parts = re.split(r'\t+|\s{2,}', line)
                        if len(parts) >= 2:
                            app_id = parts[0]
                            name = parts[1]
                            ver = parts[2] if len(parts) > 2 else ""
                            size = parts[3] if len(parts) > 3 else ""
                            apps.append((app_id, name, ver, size))
                    if apps:
                        results["flatpak"]["has_update"] = True
                        results["flatpak"]["count"] = len(apps)
                        results["flatpak"]["apps"] = apps
            except Exception:
                pass

        # 3. Sadeem Box check
        if do_box:
            try:
                chk = subprocess.run(["distrobox", "list", "--no-color"], capture_output=True, text=True, timeout=5, check=False)
                if chk.returncode == 0 and "sadeem-box" in chk.stdout:
                    res = subprocess.run(["distrobox", "enter", "sadeem-box", "--", "dnf", "check-update"], capture_output=True, text=True, timeout=60, check=False)
                    if res.returncode == 100:
                        lines = [l.strip() for l in res.stdout.splitlines() if l.strip()]
                        pkg_lines = []
                        for l in lines:
                            if "Obsoleting Packages" in l:
                                break
                            parts = l.split()
                            if len(parts) >= 3 and not l.startswith("Last metadata") and not l.startswith("Security:"):
                                pkg_lines.append(parts[0])
                        count = len(pkg_lines) if pkg_lines else 1
                        results["box"]["has_update"] = True
                        results["box"]["count"] = count
            except Exception:
                pass

        GLib.idle_add(self.on_check_finished, results)

    def on_check_finished(self, results):
        self.is_checking = False
        self.upd_spinner.stop()
        self.upd_spinner.set_visible(False)
        self.sys_row.set_sensitive(True)
        self.flatpak_row.set_sensitive(True)
        self.box_row.set_sensitive(True)

        for r in getattr(self, "upd_result_rows", []):
            self.upd_results_group.remove(r)
        self.upd_result_rows = []

        has_any = results["sys"]["has_update"] or results["flatpak"]["has_update"] or results["box"]["has_update"]

        if not has_any:
            row = Adw.ActionRow()
            row.set_use_markup(False)
            row.set_title(t("status_all_updated"))
            row.set_subtitle(t("upd_no_updates_desc"))
            row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["emblem-ok-symbolic", "object-select-symbolic"])))
            self.upd_results_group.add(row)
            self.upd_result_rows.append(row)
            self.upd_results_group.set_visible(True)

            self.upd_status_label.set_text(t("status_all_updated"))
            self.btn_start_update.set_label(t("btn_check_again"))
            self.btn_start_update.set_sensitive(True)
            self.current_update_stage = "idle"
        else:
            if results["sys"]["has_update"]:
                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(t("upd_sys_title"))
                ver = results["sys"]["version"]
                diff = results["sys"]["diff"]
                sub_parts = []
                if ver:
                    sub_parts.append(f"Sadeem {ver}")
                if diff:
                    sub_parts.append(diff)
                row.set_subtitle(" • ".join(sub_parts) if sub_parts else t("status_updates_available"))
                row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["software-update-available-symbolic", "system-software-update-symbolic"])))
                self.upd_results_group.add(row)
                self.upd_result_rows.append(row)

            if results["flatpak"]["has_update"]:
                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(t("upd_flatpak_title"))
                apps = results["flatpak"]["apps"]
                app_names = [a[1] if a[1] else a[0] for a in apps]
                preview = ", ".join(app_names[:3])
                if len(app_names) > 3:
                    preview += f" (+{len(app_names) - 3})"
                sub = f"{results['flatpak']['count']} {t('upd_apps_available')}: {preview}"
                row.set_subtitle(sub)
                row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["system-software-install-symbolic", "application-x-executable-symbolic"])))
                self.upd_results_group.add(row)
                self.upd_result_rows.append(row)

            if results["box"]["has_update"]:
                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(t("upd_box_title"))
                row.set_subtitle(f"{results['box']['count']} {t('upd_pkgs_available')}")
                row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["package-x-generic-symbolic", "utilities-terminal-symbolic"])))
                self.upd_results_group.add(row)
                self.upd_result_rows.append(row)

            self.upd_results_group.set_visible(True)
            self.upd_status_label.set_text(t("status_updates_available"))
            self.btn_start_update.set_label(t("btn_install_updates"))
            self.btn_start_update.set_sensitive(True)
            self.current_update_stage = "results_has_updates"

        return False

    def start_installation(self):
        if getattr(self, "is_updating", False):
            return

        run_sys = self.sys_row.get_active()
        run_flatpak = self.flatpak_row.get_active()
        run_box = self.box_row.get_active()

        if not (run_sys or run_flatpak or run_box):
            return

        self.is_updating = True
        self.current_update_stage = "installing"
        self.btn_start_update.set_sensitive(False)
        self.btn_start_update.set_label(t("btn_updating"))
        self.sys_row.set_sensitive(False)
        self.flatpak_row.set_sensitive(False)
        self.box_row.set_sensitive(False)

        self.upd_progress_bar.set_visible(True)
        self.upd_progress_bar.set_show_text(True)
        self.update_upd_progress(0.0)

        buf = self.upd_text_view.get_buffer()
        buf.set_text("")
        self.upd_expander.set_expanded(False)

        threading.Thread(target=self.run_updates_thread, args=(run_sys, run_flatpak, run_box), daemon=True).start()

    def run_upd_command(self, cmd, desc, task_idx, total_tasks):
        full_cmd = ["stdbuf", "-oL", "-eL"] + cmd if os.path.exists("/usr/bin/stdbuf") else cmd
        self.append_upd_log(f"=== {desc} ===")
        self.append_upd_log(f"$ {' '.join(cmd)}")

        is_rpm_ostree = any("rpm-ostree" in str(c) for c in cmd) and any("upgrade" in str(c) for c in cmd)
        ostree_stage = ["checking"]

        if is_rpm_ostree:
            self.start_upd_checking_progression()
        else:
            if total_tasks > 1 and task_idx > 0:
                base_other = 0.95 + ((task_idx - 1) / (total_tasks - 1)) * 0.05
                self.update_upd_progress(base_other)
            else:
                self.update_upd_progress(task_idx / total_tasks)
            self.start_upd_pulse()

        try:
            proc = subprocess.Popen(
                full_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                bufsize=0
            )
            buf = bytearray()
            output_lines = []

            def _process_line(raw_line):
                clean = re.sub(r'\x1b\[[0-9;?]*[a-zA-Z]', '', raw_line).replace('\r', '').strip()
                if not clean:
                    return
                output_lines.append(clean)
                self.append_upd_log(clean)
                clean_lower = clean.lower()

                if is_rpm_ostree:
                    staging_keywords = [
                        "staging deployment", "staging", "deploying", "writing deployment",
                        "running post", "executing %post", "building kernel modules",
                        "building kmod", "building akmod", "regenerating initramfs",
                        "initramfs", "akmod", "changes queued"
                    ]
                    # Stage 3: Staging / Deploying / Kernel modules
                    if any(k in clean_lower for k in staging_keywords):
                        if ostree_stage[0] != "staging":
                            ostree_stage[0] = "staging"
                            self.start_upd_staging_progression()
                    # Stage 2: Downloading layers / Fetching
                    elif any(k in clean_lower for k in ["receiving objects", "receiving delta", "fetching", "downloading"]):
                        if ostree_stage[0] != "staging":
                            if ostree_stage[0] != "downloading":
                                ostree_stage[0] = "downloading"
                                self.stop_all_upd_timers()
                                GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_sys_downloading")))
                            m_pct = re.search(r'(\d{1,3})%', clean)
                            if m_pct:
                                val = int(m_pct.group(1))
                                if 0 <= val <= 100:
                                    mapped = 0.15 + (val / 100.0) * 0.50
                                    self.update_upd_progress(mapped)
                    # Stage 1: Checking / Pulling metadata
                    elif ostree_stage[0] == "checking":
                        m_pct = re.search(r'(\d{1,3})%', clean)
                        if m_pct:
                            val = int(m_pct.group(1))
                            if 0 <= val <= 100:
                                mapped = (val / 100.0) * 0.15
                                cur = getattr(self, "_upd_current_frac", 0.0)
                                self.update_upd_progress(min(0.15, max(cur, mapped)))
                    # Fallback transition: if downloading was active and reached >= 64%, any subsequent non-download line transitions to staging
                    elif ostree_stage[0] == "downloading" and getattr(self, "_upd_current_frac", 0.0) >= 0.64:
                        ostree_stage[0] = "staging"
                        self.start_upd_staging_progression()

                else:
                    # Non-rpm-ostree commands (Flatpak, Distrobox)
                    sub_pct = None
                    m_layer = re.search(r'\[\s*(\d+)\s*/\s*(\d+)\s*\]', clean)
                    m_pct = re.search(r'(\d{1,3})%', clean)
                    if m_layer:
                        cur, tot = int(m_layer.group(1)), int(m_layer.group(2))
                        if tot > 0:
                            sub_pct = min(1.0, max(0.0, cur / tot))
                    elif m_pct:
                        val = int(m_pct.group(1))
                        if 0 <= val <= 100:
                            sub_pct = val / 100.0

                    if sub_pct is not None:
                        if total_tasks > 1 and task_idx > 0:
                            base_other = 0.95 + ((task_idx - 1) / (total_tasks - 1)) * 0.05
                            range_other = (1.0 / (total_tasks - 1)) * 0.05
                            overall = min(1.0, base_other + (sub_pct * range_other))
                        else:
                            base_start = task_idx / total_tasks
                            task_range = 1.0 / total_tasks
                            overall = base_start + (sub_pct * task_range)
                        self.update_upd_progress(overall)
                    else:
                        if any(w in clean_lower for w in ["deploying", "staging", "writing", "checking", "resolving", "preparing"]):
                            self.start_upd_pulse()

            while True:
                b = proc.stdout.read(1)
                if not b:
                    break
                if b in (b'\n', b'\r'):
                    if buf:
                        try:
                            raw_str = buf.decode('utf-8', errors='replace')
                        except Exception:
                            raw_str = ""
                        buf.clear()
                        _process_line(raw_str)
                else:
                    buf.extend(b)

            if buf:
                try:
                    raw_str = buf.decode('utf-8', errors='replace')
                    _process_line(raw_str)
                except Exception:
                    pass

            proc.wait()
            self.stop_all_upd_timers()
            self.stop_upd_pulse()

            if proc.returncode == 0:
                if is_rpm_ostree:
                    if task_idx == total_tasks - 1:
                        self.update_upd_progress(1.0, text=t("status_upd_complete"))
                        GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_upd_complete")))
                    else:
                        self.update_upd_progress(0.95)
                else:
                    if task_idx == total_tasks - 1:
                        self.update_upd_progress(1.0, text=t("status_upd_complete"))
                        GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_upd_complete")))
                    else:
                        self.update_upd_progress((task_idx + 1) / total_tasks)
            self.append_upd_log("")
            return proc.returncode, "\n".join(output_lines)

        except Exception as e:
            self.stop_all_upd_timers()
            self.stop_upd_pulse()
            err_msg = f"Error executing {cmd[0]}: {str(e)}"
            self.append_upd_log(err_msg)
            return 1, err_msg

    def run_updates_thread(self, do_sys, do_flatpak, do_box):
        tasks = []
        if do_sys:
            tasks.append("sys")
        if do_flatpak:
            tasks.append("flatpak")
        if do_box:
            tasks.append("box")

        total = len(tasks)
        overall_success = True

        for idx, task in enumerate(tasks):
            if task == "sys":
                GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_sys")))
                code, out = self.run_upd_command(
                    ["pkexec", "rpm-ostree", "upgrade"],
                    "rpm-ostree upgrade",
                    idx,
                    total
                )
                if code == 0:
                    out_lower = out.lower()
                    if any(phrase in out_lower for phrase in [
                        "changes queued for next boot",
                        "staging deployment",
                        "upgraded:",
                        "downgraded:",
                        "added:",
                        "removed:",
                        "pinned:",
                        "freed:",
                        "staged"
                    ]):
                        self.reboot_required = True
                    try:
                        st = subprocess.run(["rpm-ostree", "status"], capture_output=True, text=True, check=False)
                        st_lower = st.stdout.lower()
                        if "changes queued" in st_lower or "staged" in st_lower:
                            self.reboot_required = True
                    except Exception:
                        pass
                else:
                    overall_success = False

            elif task == "flatpak":
                GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_flatpak")))
                code, out = self.run_upd_command(
                    ["flatpak", "update", "-y", "--noninteractive"],
                    "flatpak update",
                    idx,
                    total
                )
                if code == 0:
                    GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_flatpak_cleanup")))
                    self.run_upd_command(
                        ["flatpak", "uninstall", "--unused", "-y", "--noninteractive"],
                        "flatpak cleanup",
                        idx,
                        total
                    )
                else:
                    overall_success = False

            elif task == "box":
                GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_box")))
                code, out = self.run_upd_command(
                    ["distrobox", "upgrade", "sadeem-box"],
                    "distrobox upgrade sadeem-box",
                    idx,
                    total
                )
                if code == 0:
                    GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_box_cleanup")))
                    self.run_upd_command(
                        ["distrobox", "enter", "sadeem-box", "--", "sudo", "dnf", "clean", "all"],
                        "distrobox clean cache",
                        idx,
                        total
                    )
                else:
                    overall_success = False

        GLib.idle_add(self.on_updates_finished, overall_success)

    def on_updates_finished(self, success):
        self.is_updating = False
        self.stop_all_upd_timers()
        self.stop_upd_pulse()
        self.sys_row.set_sensitive(True)
        self.flatpak_row.set_sensitive(True)
        self.box_row.set_sensitive(True)
        self.check_box_availability()

        if success:
            self.upd_progress_bar.set_visible(True)
            self.upd_progress_bar.set_show_text(True)
            self.upd_progress_bar.set_fraction(1.0)
            self.upd_progress_bar.set_text(t("status_upd_complete"))
            self.upd_status_label.set_text(t("status_upd_complete"))
        else:
            self.upd_progress_bar.set_visible(False)
            self.upd_status_label.set_text(t("status_error"))

        def _check_finished():
            if success:
                time.sleep(0.8)
            pending = has_pending_reboot()
            def _ui():
                if pending:
                    self.reboot_ready = True
                    self.btn_start_update.set_label(t("install_and_restart"))
                    self.btn_start_update.set_sensitive(True)
                    if not self.btn_start_update.has_css_class("suggested-action"):
                        self.btn_start_update.add_css_class("suggested-action")
                    if not self.btn_start_update.has_css_class("pill"):
                        self.btn_start_update.add_css_class("pill")
                    self.upd_status_label.set_text(t("status_reboot"))
                    for r in getattr(self, "upd_result_rows", []):
                        self.upd_results_group.remove(r)
                    self.upd_result_rows = []
                    row = Adw.ActionRow()
                    row.set_use_markup(False)
                    row.set_title(t("install_and_restart"))
                    row.set_subtitle(t("status_reboot"))
                    row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["system-reboot-symbolic", "view-refresh-symbolic"])))
                    self.upd_results_group.add(row)
                    self.upd_result_rows.append(row)
                    self.upd_results_group.set_visible(True)
                elif success:
                    self.reboot_ready = False
                    self.current_update_stage = "idle"
                    self.btn_start_update.set_label(t("btn_check_again"))
                    self.btn_start_update.set_sensitive(True)
                    self.upd_status_label.set_text(t("status_done"))
                    for r in getattr(self, "upd_result_rows", []):
                        self.upd_results_group.remove(r)
                    self.upd_result_rows = []
                    row = Adw.ActionRow()
                    row.set_use_markup(False)
                    row.set_title(t("status_all_updated"))
                    row.set_subtitle(t("upd_no_updates_desc"))
                    row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["emblem-ok-symbolic", "object-select-symbolic"])))
                    self.upd_results_group.add(row)
                    self.upd_result_rows.append(row)
                    self.upd_results_group.set_visible(True)
                else:
                    self.reboot_ready = False
                    self.current_update_stage = "idle"
                    self.btn_start_update.set_label(t("btn_check_again"))
                    self.btn_start_update.set_sensitive(True)
                    self.upd_status_label.set_text(t("status_error"))
                return False
            GLib.idle_add(_ui)

        threading.Thread(target=_check_finished, daemon=True).start()
        return False
    # =========================================================================
    # TAB 2: COLORS & THEME
    # =========================================================================
    def build_colors_page(self):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_propagate_natural_height(False)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(620)
        clamp.set_tightening_threshold(480)
        scrolled.set_child(clamp)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        content.set_valign(Gtk.Align.CENTER)
        content.set_margin_top(20)
        content.set_margin_bottom(24)
        content.set_margin_start(20)
        content.set_margin_end(20)
        clamp.set_child(content)

        # Section 1: Unified Page Header
        header = self.build_page_header(
            ["preferences-desktop-appearance-symbolic", "preferences-desktop-theme-symbolic"],
            t("colors_banner_title"),
            t("colors_banner_desc")
        )
        content.append(header)

        # Section 2: Preset Colors Group
        preset_group = Adw.PreferencesGroup(
            title=t("colors_presets_title")
        )
        self.restore_btn = Gtk.Button()
        restore_content = Adw.ButtonContent(
            icon_name=safe_icon(["object-rotate-left-symbolic", "view-refresh-symbolic"]),
            label=t("colors_reset")
        )
        self.restore_btn.set_child(restore_content)
        self.restore_btn.add_css_class("flat")
        self.restore_btn.connect("clicked", lambda b: self.set_color("#7a1c33"))
        preset_group.set_header_suffix(self.restore_btn)
        content.append(preset_group)

        preset_row = Adw.ActionRow()
        preset_row.set_activatable(False)
        palette_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8,
            homogeneous=True,
            hexpand=True,
            margin_top=10,
            margin_bottom=10
        )
        self.preset_buttons = []
        color_names = t("color_names") if isinstance(t("color_names"), list) else []
        for i, hex_code in enumerate(PRESET_HEXES):
            name = color_names[i] if i < len(color_names) else hex_code
            btn = Gtk.Button()
            btn.set_tooltip_text(f"{name} ({hex_code})")
            btn.add_css_class("color-circle")
            btn.add_css_class(f"preset-color-{i}")
            btn.set_size_request(42, 42)
            btn.set_halign(Gtk.Align.CENTER)

            icon = Gtk.Image.new_from_icon_name(safe_icon(["object-select-symbolic", "emblem-ok-symbolic"]))
            icon.set_visible(False)
            icon.add_css_class("check-icon")
            btn.set_child(icon)

            btn.connect("clicked", lambda b, h=hex_code: self.set_color(h))
            palette_box.append(btn)
            self.preset_buttons.append((btn, hex_code, icon))

        preset_row.set_child(palette_box)
        preset_group.add(preset_row)

        # Section 3: Custom Color Group
        custom_group = Adw.PreferencesGroup(title=t("colors_custom_title"))
        content.append(custom_group)

        self.custom_row = Adw.ActionRow(
            title=t("colors_custom_desc"),
            subtitle=t("colors_current", color="#7A1C33")
        )
        self.color_dialog = Gtk.ColorDialog.new()
        self.color_dialog.set_with_alpha(False)
        self.color_dialog_btn = Gtk.ColorDialogButton.new(self.color_dialog)
        self.color_dialog_btn.set_valign(Gtk.Align.CENTER)
        self.color_dialog_btn.connect("notify::rgba", self.on_color_dialog_rgba_changed)
        self.custom_row.add_suffix(self.color_dialog_btn)
        custom_group.add(self.custom_row)

        # Section 4: Live Accent Preview Group
        preview_group = Adw.PreferencesGroup(title=t("colors_preview_title"))
        content.append(preview_group)

        preview_row = Adw.ActionRow(title=t("colors_preview_desc"))
        preview_row.set_activatable(False)

        preview_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        preview_box.set_valign(Gtk.Align.CENTER)
        preview_box.set_halign(Gtk.Align.END)

        self.preview_progress = Gtk.ProgressBar()
        self.preview_progress.set_fraction(0.65)
        self.preview_progress.set_valign(Gtk.Align.CENTER)
        self.preview_progress.set_size_request(110, -1)
        preview_box.append(self.preview_progress)

        self.preview_switch = Gtk.Switch()
        self.preview_switch.set_active(True)
        self.preview_switch.set_valign(Gtk.Align.CENTER)
        preview_box.append(self.preview_switch)

        self.preview_btn = Gtk.Button(label=t("colors_preview_btn"))
        self.preview_btn.add_css_class("suggested-action")
        self.preview_btn.add_css_class("pill")
        self.preview_btn.set_valign(Gtk.Align.CENTER)
        preview_box.append(self.preview_btn)

        preview_row.add_suffix(preview_box)
        preview_group.add(preview_row)

        initial_color = self.detect_current_color()
        self.set_color(initial_color, is_init=True)

        return scrolled

