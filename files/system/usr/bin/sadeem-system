    # TAB 4: CONTAINERS & PACKAGES
    # =========================================================================
    def build_containers_page(self):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(640)
        clamp.set_tightening_threshold(480)
        scrolled.set_child(clamp)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        content.set_margin_top(20)
        content.set_margin_bottom(24)
        content.set_margin_start(20)
        content.set_margin_end(20)
        clamp.set_child(content)

        # Unified Header
        header = self.build_page_header(
            ["package-x-generic-symbolic", "system-run-symbolic"],
            t("box_header_title"),
            t("box_header_desc")
        )
        content.append(header)

        # Status Group
        status_group = Adw.PreferencesGroup()
        content.append(status_group)

        self.box_status_row = Adw.ActionRow(
            title=t("box_status_title"),
            subtitle=t("box_status_init")
        )
        self.box_status_icon = Gtk.Image.new_from_icon_name(safe_icon(["utilities-terminal-symbolic", "drive-harddisk-symbolic"]))
        self.box_status_row.add_prefix(self.box_status_icon)
        status_group.add(self.box_status_row)

        # Actions Group
        actions_group = Adw.PreferencesGroup(title=t("box_actions_title"))
        content.append(actions_group)

        # Row 1: Container Terminal
        row_term = Adw.ActionRow(
            title=t("box_btn_terminal"),
            subtitle=t("box_btn_terminal_desc")
        )
        row_term.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["utilities-terminal-symbolic", "terminal-symbolic"])))
        btn_term = Gtk.Button(label=t("btn_open_terminal"))
        btn_term.set_valign(Gtk.Align.CENTER)
        btn_term.set_size_request(165, -1)
        btn_term.add_css_class("pill")
        btn_term.connect("clicked", lambda b: launch_container_terminal())
        row_term.add_suffix(btn_term)
        actions_group.add(row_term)

        # Row 2: BoxBuddy
        row_buddy = Adw.ActionRow(
            title=t("box_btn_boxbuddy"),
            subtitle=t("box_btn_boxbuddy_desc")
        )
        row_buddy.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["system-run-symbolic", "application-x-executable-symbolic"])))
        btn_buddy = Gtk.Button(label=t("btn_open_boxbuddy"))
        btn_buddy.set_valign(Gtk.Align.CENTER)
        btn_buddy.set_size_request(165, -1)
        btn_buddy.add_css_class("pill")
        btn_buddy.connect("clicked", lambda b: launch_boxbuddy())
        row_buddy.add_suffix(btn_buddy)
        actions_group.add(row_buddy)

        # Row 3: Manual Package Installer
        row_pkg = Adw.ActionRow(
            title=t("box_btn_install"),
            subtitle=t("box_btn_install_desc")
        )
        row_pkg.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["document-open-symbolic", "folder-open-symbolic"])))
        btn_pkg = Gtk.Button(label=t("btn_choose_package"))
        btn_pkg.set_valign(Gtk.Align.CENTER)
        btn_pkg.set_size_request(165, -1)
        btn_pkg.add_css_class("pill")
        btn_pkg.add_css_class("suggested-action")
        btn_pkg.connect("clicked", self.on_choose_package_clicked)
        row_pkg.add_suffix(btn_pkg)
        actions_group.add(row_pkg)

        box_btn_group = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)
        box_btn_group.add_widget(btn_term)
        box_btn_group.add_widget(btn_buddy)
        box_btn_group.add_widget(btn_pkg)

        return scrolled

    def on_choose_package_clicked(self, btn):
        try:
            dialog = Gtk.FileDialog.new()
            dialog.set_title(t("box_dialog_title"))

            filters = Gio.ListStore.new(Gtk.FileFilter)
            f_pkg = Gtk.FileFilter.new()
            f_pkg.set_name(t("box_filter_pkgs"))
            f_pkg.add_pattern("*.rpm")
            f_pkg.add_pattern("*.deb")
            filters.append(f_pkg)

            f_all = Gtk.FileFilter.new()
            f_all.set_name(t("box_filter_all"))
            f_all.add_pattern("*")
            filters.append(f_all)

            dialog.set_filters(filters)
            dialog.set_default_filter(f_pkg)

            def _on_finish(dialog, result):
                try:
                    file = dialog.open_finish(result)
                    if file:
                        path = file.get_path()
                        if path:
                            subprocess.Popen(["/usr/bin/sadeem-pkg-installer", path])
                except Exception:
                    pass

            dialog.open(self, None, _on_finish)
        except Exception:
            # Fallback
            try:
                res = subprocess.run(
                    ["zenity", "--file-selection", "--title=" + t("box_dialog_title"), "--file-filter=Packages | *.rpm *.deb", "--file-filter=All | *"],
                    capture_output=True, text=True
                )
                if res.returncode == 0 and res.stdout.strip():
                    subprocess.Popen(["/usr/bin/sadeem-pkg-installer", res.stdout.strip()])
            except Exception:
                pass

    def check_box_availability(self):
        def _check():
            has_box = False
            try:
                res = subprocess.run(
                    ["distrobox", "list", "--no-color"],
                    capture_output=True,
                    text=True,
                    timeout=5,
                    check=False
                )
                if res.returncode == 0 and "sadeem-box" in res.stdout:
                    has_box = True
            except Exception:
                has_box = False

            def _update():
                if hasattr(self, "box_status_row") and self.box_status_row:
                    if has_box:
                        self.box_status_row.set_subtitle(t("box_status_active"))
                        self.box_status_icon.set_from_icon_name(safe_icon(["emblem-ok-symbolic", "object-select-symbolic"]))
                    else:
                        self.box_status_row.set_subtitle(t("box_status_init"))
                        self.box_status_icon.set_from_icon_name(safe_icon(["utilities-terminal-symbolic", "drive-harddisk-symbolic"]))
                return False

            GLib.idle_add(_update)

        threading.Thread(target=_check, daemon=True).start()


class SadeemSystemApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="org.sadeem.System",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.window = None

    def do_command_line(self, command_line):
        args = command_line.get_arguments()
        tab = "updates"
        autostart = False

        for i, arg in enumerate(args[1:], start=1):
            if arg.startswith("--tab="):
                tab = arg.split("=")[1].strip().lower()
            elif arg == "--tab" and i + 1 < len(args):
                tab = args[i + 1].strip().lower()
            elif arg == "--autostart":
                autostart = True

        if autostart:
            gpus = detect_nvidia_gpus()
            if not gpus or is_driver_installed():
                return 0
            db = load_database()
            if all(classify_gpu(g, db)[0] == "unsupported" for g in gpus):
                return 0
            tab = "drivers"

        setup_icon_theme()
        if LANG in ("ar", "ur"):
            Gtk.Widget.set_default_direction(Gtk.TextDirection.RTL)
        else:
            Gtk.Widget.set_default_direction(Gtk.TextDirection.LTR)

        if not self.window:
            self.window = SadeemSystemWindow(self, initial_tab=tab)
        else:
            self.window.set_active_tab(tab)

        self.window.present()
        return 0


def main():
    GLib.set_prgname("org.sadeem.System")
    app = SadeemSystemApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
