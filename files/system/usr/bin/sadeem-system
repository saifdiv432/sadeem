        self.live_css_provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            self.live_css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 200
        )

    def detect_current_color(self):
        gtk4_file = os.path.expanduser("~/.config/gtk-4.0/gtk.css")
        if os.path.exists(gtk4_file):
            try:
                with open(gtk4_file, "r") as f:
                    for line in f:
                        if "--accent-bg-color:" in line:
                            val = line.split("--accent-bg-color:")[1].split(";")[0].strip()
                            if val.startswith("#") and len(val) in (4, 7):
                                return val
                        elif "accent_bg_color" in line:
                            val = line.split("accent_bg_color")[1].strip().rstrip(";").strip()
                            if val.startswith("#") and len(val) in (4, 7):
                                return val
            except Exception:
                pass
        return "#7a1c33"

    def on_color_dialog_rgba_changed(self, btn, pspec):
        if self._color_updating:
            return
        rgba = btn.get_rgba()
        hex_code = rgb_to_hex(rgba.red, rgba.green, rgba.blue)
        self.set_color(hex_code)

    def set_color(self, hex_code, is_init=False):
        pal = compute_color_palette(hex_code)
        hex_norm = pal["hex"]

        is_burgundy = (hex_norm.lower() == "#7a1c33")
        self.restore_btn.set_sensitive(not is_burgundy)
        self.custom_row.set_subtitle(t("colors_current", color=hex_norm.upper()))

        self._color_updating = True
        rgba = Gdk.RGBA()
        rgba.parse(hex_norm)
        self.color_dialog_btn.set_rgba(rgba)
        self._color_updating = False

        for btn, h, icon in self.preset_buttons:
            if h.lower() == hex_norm.lower():
                btn.add_css_class("selected")
                icon.set_visible(True)
            else:
                btn.remove_css_class("selected")
                icon.set_visible(False)

        live_css = f"""
        @define-color accent_bg_color {hex_norm};
        @define-color accent_fg_color {pal['accent_fg']};
        @define-color accent_color {pal['accent_color']};

        switch:checked {{
          background-color: {hex_norm};
          border-color: {hex_norm};
          color: #ffffff;
        }}
        switch:checked > slider,
        switch:checked slider {{
          background-color: #ffffff;
          color: {hex_norm};
        }}
        checkbutton.radio radio:checked,
        checkbutton.radio:checked radio,
        checkbutton radio:checked,
        checkbutton:checked radio,
        radio:checked {{
          background-color: {hex_norm};
          border-color: {hex_norm};
          color: #ffffff;
        }}
        checkbutton check:checked,
        checkbutton:checked check,
        check:checked {{
          background-color: {hex_norm};
          border-color: {hex_norm};
          color: #ffffff;
        }}
        button.suggested-action {{
          background-color: {hex_norm};
          color: {pal['accent_fg']};
        }}
        progressbar progress {{
          background-color: {hex_norm};
        }}
        scale highlight {{
          background-color: {hex_norm};
        }}
        """
        self.live_css_provider.load_from_string(live_css)

        if not is_init:
            self.write_theme_files(pal)
            self.toast_overlay.add_toast(Adw.Toast.new(t("colors_toast_applied")))

    def write_theme_files(self, pal):
        hex_val = pal["hex"]
        fg_val = pal["accent_fg"]
        acc_val = pal["accent_color"]
        hov_val = pal["hover"]
        arr_val = pal["arrow"]

        # 1. ~/.config/gtk-4.0/gtk.css
        gtk4_dir = os.path.expanduser("~/.config/gtk-4.0")
        os.makedirs(gtk4_dir, exist_ok=True)
        gtk4_content = f"""@define-color accent_bg_color {hex_val};
@define-color accent_fg_color {fg_val};
@define-color accent_color {acc_val};

switch:checked {{
  background-color: {hex_val};
  border-color: {hex_val};
  color: #ffffff;
}}

switch:checked > slider,
switch:checked slider {{
  background-color: #ffffff;
  color: {hex_val};
}}

checkbutton.radio radio:checked,
checkbutton.radio:checked radio,
checkbutton radio:checked,
checkbutton:checked radio,
radio:checked {{
  background-color: {hex_val};
  border-color: {hex_val};
  color: #ffffff;
}}

checkbutton check:checked,
checkbutton:checked check,
check:checked {{
  background-color: {hex_val};
  border-color: {hex_val};
  color: #ffffff;
}}

button.suggested-action {{
  background-color: {hex_val};
  color: {fg_val};
}}

progressbar progress {{
  background-color: {hex_val};
}}

scale highlight {{
  background-color: {hex_val};
}}
"""
        with open(os.path.join(gtk4_dir, "gtk.css"), "w") as f:
            f.write(gtk4_content)

        # 2. ~/.config/gtk-3.0/gtk.css
        gtk3_dir = os.path.expanduser("~/.config/gtk-3.0")
        os.makedirs(gtk3_dir, exist_ok=True)
        gtk3_content = f"""@define-color accent_bg_color {hex_val};
@define-color accent_fg_color {fg_val};
@define-color accent_color {acc_val};

switch:checked {{
  background-color: {hex_val};
  border-color: {hex_val};
  color: #ffffff;
}}

switch:checked > slider,
switch:checked slider {{
  background-color: #ffffff;
  color: {hex_val};
}}

check:checked,
radio:checked {{
  background-color: {hex_val};
  border-color: {hex_val};
  color: #ffffff;
}}

button.suggested-action {{
  background-color: {hex_val};
  color: {fg_val};
}}
"""
        with open(os.path.join(gtk3_dir, "gtk.css"), "w") as f:
            f.write(gtk3_content)

        # 3. GNOME Shell theme overrides
        shell_theme_dir = os.path.expanduser("~/.local/share/themes/Saifdora-Custom/gnome-shell")
        os.makedirs(shell_theme_dir, exist_ok=True)
        shell_css = f"""@import url("resource:///org/gnome/shell/theme/gnome-shell.css");

stage {{
  -st-accent-color: {hex_val};
  -st-accent-fg-color: {fg_val};
}}

.quick-toggle:checked,
.quick-toggle-menu-button:checked {{
  background-color: {hex_val} !important;
  color: {fg_val} !important;
}}

.quick-toggle:checked:hover,
.quick-toggle-menu-button:checked:hover {{
  background-color: {hov_val} !important;
}}

.quick-toggle-menu-button:checked {{
  background-color: {arr_val} !important;
  border-left-color: rgba(255, 255, 255, 0.18) !important;
}}

.quick-toggle-menu-button:checked:hover {{
  background-color: {hov_val} !important;
}}

.slider {{
  -barlevel-active-background-color: {hex_val} !important;
}}

.toggle-switch:checked {{
  background-color: {hex_val} !important;
  color: {fg_val} !important;
}}

.check-box:checked StBin {{
  background-color: {hex_val} !important;
  color: {fg_val} !important;
}}

.calendar-today {{
  background-color: {hex_val} !important;
  color: {fg_val} !important;
}}
"""
        with open(os.path.join(shell_theme_dir, "gnome-shell.css"), "w") as f:
            f.write(shell_css)

        # Official GNOME accent-color synchronization
        gnome_accent_map = {
            "#7a1c33": "red",
            "#1c71d8": "blue",
            "#2ec27e": "green",
            "#e5a50a": "yellow",
            "#e66100": "orange",
            "#c01c28": "red",
            "#f66151": "pink",
            "#9141ac": "purple",
            "#5e5c64": "slate",
            "#008080": "teal",
        }
        accent_color_name = gnome_accent_map.get(hex_val.lower(), "red")
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "accent-color", accent_color_name], check=False)

        # Dual sync for Shell theme
        if hex_val.lower() == "#7a1c33":
            subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", "Saifdora-Burgundy"], check=False)
        else:
            subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", "Default"], check=False)
            time.sleep(0.05)
            subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", "Saifdora-Custom"], check=False)

