]


def get_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG"):
        val = os.environ.get(var, "")
        if val:
            code = val.split(":")[0].split(".")[0].split("_")[0].split("@")[0].lower()
            if code in TRANSLATIONS:
                return code
    return "en"


LANG = get_language()


def t(key, **kwargs):
    entry = TRANSLATIONS.get(LANG, {})
    val = entry.get(key)
    if val is None or val == "":
        val = TRANSLATIONS.get("en", {}).get(key, key)
    if kwargs and isinstance(val, str):
        try:
            return val.format(**kwargs)
        except Exception:
            return val
    return val


class TranslationProxy:
    def __getitem__(self, key):
        return t(key)

    def get(self, key, default=None):
        val = t(key)
        return val if val != key else default


def setup_icon_theme():
    display = Gdk.Display.get_default()
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        search_paths = [
            "/usr/share/icons/hicolor/scalable/apps",
            "/usr/share/icons/hicolor/256x256/apps",
            "/usr/share/icons/hicolor/128x128/apps",
            "/usr/share/icons/hicolor/64x64/apps",
            "/usr/share/icons/hicolor/48x48/apps",
            "/usr/share/pixmaps",
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "scalable", "apps")),
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "256x256", "apps")),
        ]
        for p in search_paths:
            if os.path.isdir(p):
                theme.add_search_path(p)


def safe_icon(icon_names, fallback="application-x-executable-symbolic"):
    if isinstance(icon_names, str):
        icon_names = [icon_names]
    display = Gdk.Display.get_default()
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        for name in icon_names:
            if name and theme.has_icon(name):
                return name
    for name in icon_names:
        if name:
            if os.path.isabs(name) and os.path.exists(name):
                return name
            for prefix in ("/usr/share/icons/hicolor/scalable/apps",
                           "/usr/share/icons/hicolor/256x256/apps",
                           "/usr/share/pixmaps"):
                for ext in (".svg", ".png"):
                    p = os.path.join(prefix, f"{name}{ext}")
                    if os.path.exists(p):
                        return name
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        if theme.has_icon(fallback):
            return fallback
        for fb in ("application-x-executable-symbolic", "system-run-symbolic", "image-missing-symbolic"):
            if theme.has_icon(fb):
                return fb
    return fallback


def create_badge(icon_names, size=64, icon_size=28, fallback="application-x-executable-symbolic"):
    badge = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    badge.set_halign(Gtk.Align.CENTER)
    badge.set_valign(Gtk.Align.CENTER)
    badge.set_size_request(size, size)
    badge.add_css_class("sadeem-gradient-badge")

    icon = safe_icon(icon_names, fallback=fallback)
    img = Gtk.Image.new_from_icon_name(icon)
    img.set_pixel_size(icon_size)
    img.set_halign(Gtk.Align.CENTER)
    img.set_valign(Gtk.Align.CENTER)
    img.set_hexpand(True)
    img.set_vexpand(True)
    badge.append(img)
    return badge


def build_page_header(icon_names, title, subtitle):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.set_halign(Gtk.Align.CENTER)
    box.set_margin_bottom(6)

    badge = create_badge(icon_names, size=64, icon_size=28)
    badge.set_halign(Gtk.Align.CENTER)
    box.append(badge)

    title_lbl = Gtk.Label(label=title)
    title_lbl.add_css_class("sadeem-header-title")
    title_lbl.set_wrap(True)
    title_lbl.set_justify(Gtk.Justification.CENTER)
    box.append(title_lbl)

    sub_lbl = Gtk.Label(label=subtitle)
    sub_lbl.add_css_class("sadeem-header-subtitle")
    sub_lbl.set_wrap(True)
    sub_lbl.set_justify(Gtk.Justification.CENTER)
    sub_lbl.set_max_width_chars(54)
    box.append(sub_lbl)

    return box



def has_pending_reboot():
    """Check rpm-ostree status --json for staged deployments awaiting reboot."""
    try:
        res = subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True, check=False)
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            deployments = data.get("deployments", [])
            if deployments and deployments[0].get("booted") is False:
                return True
    except Exception:
        pass
    return False


def trigger_system_reboot():
    """Trigger a safe, graceful GNOME session reboot with systemctl fallback."""
    try:
        res = subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "org.gnome.SessionManager",
            "--object-path", "/org/gnome/SessionManager",
            "--method", "org.gnome.SessionManager.Reboot"
        ], capture_output=True, text=True, check=False)
        if res.returncode == 0:
            return True
    except Exception:
        pass

    try:
        subprocess.Popen(["systemctl", "reboot"])
        return True
    except Exception as e:
        print(f"Error triggering system reboot: {e}", file=sys.stderr)
        return False

def launch_boxbuddy():
    for cmd in [
        ["gtk-launch", "io.github.dvlv.boxbuddyrs"],
        ["boxbuddy-rs"],
        ["boxbuddy"],
        ["flatpak", "run", "io.github.dvlv.boxbuddyrs"]
    ]:
        try:
            subprocess.Popen(cmd)
            return
        except Exception:
            pass


def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip("#")
    if len(hex_str) == 3:
        hex_str = "".join(c * 2 for c in hex_str)
    r = int(hex_str[0:2], 16) / 255.0
    g = int(hex_str[2:4], 16) / 255.0
    b = int(hex_str[4:6], 16) / 255.0
    return r, g, b


def rgb_to_hex(r, g, b):
    r_int = max(0, min(255, round(r * 255)))
    g_int = max(0, min(255, round(g * 255)))
    b_int = max(0, min(255, round(b * 255)))
    return f"#{r_int:02x}{g_int:02x}{b_int:02x}"


def compute_color_palette(hex_str):
    r, g, b = hex_to_rgb(hex_str)
    h, l, s = colorsys.rgb_to_hls(r, g, b)

    luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b
    accent_fg = "#ffffff" if luminance < 0.55 else "#1e1e1e"

    accent_l = max(l, 0.65)
    r_acc, g_acc, b_acc = colorsys.hls_to_rgb(h, accent_l, s)
    accent_color = rgb_to_hex(r_acc, g_acc, b_acc)

    hov_l = min(1.0, max(0.0, l + 0.06))
    r_hov, g_hov, b_hov = colorsys.hls_to_rgb(h, hov_l, s)
    hover_color = rgb_to_hex(r_hov, g_hov, b_hov)

    arr_l = min(1.0, max(0.0, l - 0.06))
    r_arr, g_arr, b_arr = colorsys.hls_to_rgb(h, arr_l, s)
    arrow_color = rgb_to_hex(r_arr, g_arr, b_arr)

    return {
        "hex": hex_str.lower(),
        "accent_fg": accent_fg,
        "accent_color": accent_color,
        "hover": hover_color,
        "arrow": arrow_color,
    }


def detect_nvidia_gpus():
    gpus = []
    try:
        res = subprocess.run(
            ["lspci", "-nn", "-d", "10de:"],
            capture_output=True,
            text=True,
            check=False
        )
        for line in res.stdout.strip().splitlines():
            line = line.strip()
            if not line:
                continue
            match = re.search(r'\[10de:([0-9a-fA-F]{4})\]', line)
            if match:
                dev_id = match.group(1).lower()
                raw_name = line
                if ":" in line:
                    parts = line.split(":", 2)
                    if len(parts) >= 3:
                        raw_name = parts[2].strip()
                raw_name = re.sub(r'\(rev\s+[0-9a-fA-F]+\)', '', raw_name).strip()
                gpus.append({
                    "slot": line.split()[0] if line.split() else "",
                    "device_id": dev_id,
                    "raw_name": raw_name
                })
    except Exception:
        pass
    return gpus


def is_driver_installed():
    for pkg in ["akmod-nvidia", "akmod-nvidia-580xx"]:
        try:
            res = subprocess.run(
                ["rpm", "-q", pkg],
                capture_output=True,
                text=True,
                check=False
            )
            if res.returncode == 0:
                return True
        except Exception:
            pass
    return False


def get_secure_boot_state():
    sb_enabled = False
    needs_enrollment = False
    try:
        res = subprocess.run(
            ["mokutil", "--sb-state"],
            capture_output=True,
            text=True,
            check=False
        )
        if "SecureBoot enabled" in res.stdout:
            sb_enabled = True
            key_path = "/etc/pki/akmods/certs/public_key.der"
            if os.path.exists(key_path):
                test_res = subprocess.run(
                    ["mokutil", "--test-key", key_path],
                    capture_output=True,
                    text=True,
                    check=False
                )
                if test_res.returncode != 0:
                    needs_enrollment = True
            else:
                needs_enrollment = True
    except Exception:
        pass
    return sb_enabled, needs_enrollment


def load_database():
    try:
        req = urllib.request.Request(
            REMOTE_DB_URL,
            headers={"User-Agent": "SadeemSystem/1.0"}
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode('utf-8'))
                if "categories" in data:
                    return data
    except Exception:
        pass

    for p in LOCAL_DB_PATHS:
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if "categories" in data:
                        return data
            except Exception:
                pass

    return {"categories": {}}


def classify_gpu(gpu, db):
    dev_id = gpu["device_id"].lower()
    categories = db.get("categories", {})

    for cat_key in ["modern", "legacy_580xx", "unsupported"]:
        cat_data = categories.get(cat_key, {})
        devices = cat_data.get("devices", {})
        if dev_id in devices:
            return cat_key, devices[dev_id], cat_data

    try:
        val = int(dev_id, 16)
        if val >= 0x1E00:
            cat_data = categories.get("modern", {
                "branch": "akmod-nvidia",
                "driver_package": "akmod-nvidia",
                "userspace_package": "xorg-x11-drv-nvidia",
                "cuda_package": "xorg-x11-drv-nvidia-cuda",
            })
            return "modern", gpu["raw_name"], cat_data
        elif val >= 0x1340:
            cat_data = categories.get("legacy_580xx", {
                "branch": "akmod-nvidia-580xx",
                "driver_package": "akmod-nvidia-580xx",
                "userspace_package": "xorg-x11-drv-nvidia-580xx",
                "cuda_package": "xorg-x11-drv-nvidia-580xx-cuda",
            })
            return "legacy_580xx", gpu["raw_name"], cat_data
        else:
            cat_data = categories.get("unsupported", {
                "branch": None,
            })
            return "unsupported", gpu["raw_name"], cat_data
    except Exception:
        return "unsupported", gpu["raw_name"], categories.get("unsupported", {})


def launch_container_terminal():
    for term in ["ptyxis", "gnome-terminal", "kgx", "x-terminal-emulator"]:
        try:
            if subprocess.run(["which", term], capture_output=True).returncode == 0:
                if term == "ptyxis":
                    subprocess.Popen(["ptyxis", "--", "distrobox", "enter", "sadeem-box"])
                elif term == "gnome-terminal":
                    subprocess.Popen(["gnome-terminal", "--", "distrobox", "enter", "sadeem-box"])
                else:
                    subprocess.Popen([term, "-e", "distrobox", "enter", "sadeem-box"])
                return
        except Exception:
            pass
    try:
        subprocess.Popen(["distrobox", "enter", "sadeem-box"])
    except Exception:
        pass


class SadeemSystemWindow(Adw.ApplicationWindow):
    def __init__(self, app, initial_tab="updates"):
        super().__init__(application=app)
        self.t = TranslationProxy()

        self.set_title(t("app_title"))
        self.set_default_size(760, 650)

        # State tracking
        self.is_updating = False
        self.is_checking = False
        self.current_update_stage = "idle"
        self.reboot_ready = False
        self.reboot_required = False
        self._color_updating = False
        self._upd_pulse_timer = None

        self.setup_ui(initial_tab)
        self.check_box_availability()
        self.check_initial_reboot_status()

    def check_initial_reboot_status(self):
        def _check():
            pending = has_pending_reboot()
            if pending:
                def _ui():
                    self.reboot_ready = True
                    self.btn_start_update.set_label(t("install_and_restart"))
                    self.btn_start_update.set_sensitive(True)
                    if not self.btn_start_update.has_css_class("suggested-action"):
                        self.btn_start_update.add_css_class("suggested-action")
                    if not self.btn_start_update.has_css_class("pill"):
                        self.btn_start_update.add_css_class("pill")
                    self.upd_status_label.set_text(t("status_reboot"))
                    if hasattr(self, "upd_results_group"):
                        for r in getattr(self, "upd_result_rows", []):
                            self.upd_results_group.remove(r)
                        self.upd_result_rows = []
                        row = Adw.ActionRow()
                        row.set_use_markup(False)
                        row.set_title(t("install_and_restart"))
                        row.set_subtitle(t("status_reboot"))
                        row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["system-reboot-symbolic", "view-refresh-symbolic"])))
                        self.upd_results_group.add(row)
                        self.upd_result_rows.append(row)
                        self.upd_results_group.set_visible(True)
                    return False
                GLib.idle_add(_ui)
        threading.Thread(target=_check, daemon=True).start()

    def update_action_button_state(self, pending=None):
        if pending is None:
            pending = has_pending_reboot()

        def _apply():
            self.reboot_ready = pending
            if pending:
                self.btn_start_update.set_label(t("install_and_restart"))
                self.btn_start_update.set_sensitive(True)
                if not self.btn_start_update.has_css_class("suggested-action"):
                    self.btn_start_update.add_css_class("suggested-action")
                if not self.btn_start_update.has_css_class("pill"):
                    self.btn_start_update.add_css_class("pill")
                self.upd_status_label.set_text(t("status_reboot"))
            else:
                if getattr(self, "current_update_stage", "idle") == "idle":
                    self.btn_start_update.set_label(t("btn_check_updates"))
                self.btn_start_update.set_sensitive(True)
                if not self.btn_start_update.has_css_class("suggested-action"):
                    self.btn_start_update.add_css_class("suggested-action")
                if not self.btn_start_update.has_css_class("pill"):
                    self.btn_start_update.add_css_class("pill")
            return False

        GLib.idle_add(_apply)

    def on_action_button_clicked(self, btn):
        if getattr(self, "reboot_ready", False):
            trigger_system_reboot()
        elif getattr(self, "current_update_stage", "idle") == "results_has_updates":
            self.start_installation()
        else:
            self.start_checking()

    def build_page_header(self, icon_names, title, subtitle):
        return build_page_header(icon_names, title, subtitle)

    def setup_ui(self, initial_tab):
        self.setup_color_css()
        self.toast_overlay = Adw.ToastOverlay()
        self.toolbar_view = Adw.ToolbarView()
        self.toast_overlay.set_child(self.toolbar_view)
        self.set_content(self.toast_overlay)

        # HeaderBar with ViewSwitcherTitle
        self.header_bar = Adw.HeaderBar()
        self.switcher_title = Adw.ViewSwitcherTitle()
        self.switcher_title.set_title(t("app_title"))

        # ViewStack
        self.view_stack = Adw.ViewStack()
        if hasattr(self.switcher_title, 'set_view_stack'):
            self.switcher_title.set_view_stack(self.view_stack)
        else:
            self.switcher_title.set_stack(self.view_stack)

        self.header_bar.set_title_widget(self.switcher_title)
        self.toolbar_view.add_top_bar(self.header_bar)

        # Bottom ViewSwitcherBar for narrow window adaptive view
        self.switcher_bar = Adw.ViewSwitcherBar()
        if hasattr(self.switcher_bar, 'set_view_stack'):
            self.switcher_bar.set_view_stack(self.view_stack)
        else:
            self.switcher_bar.set_stack(self.view_stack)

        self.toolbar_view.add_bottom_bar(self.switcher_bar)
        self.switcher_title.bind_property(
            "title-visible",
            self.switcher_bar,
            "reveal",
            GObject.BindingFlags.SYNC_CREATE
        )

        # Build Tab Pages
        page_updates = self.build_updates_page()
        page_colors = self.build_colors_page()
        page_drivers = self.build_drivers_page()
        page_containers = self.build_containers_page()

        self.view_stack.add_titled_with_icon(
            page_updates, "updates", t("tab_updates"), safe_icon(["software-update-available-symbolic", "system-software-update-symbolic"])
        )
        self.view_stack.add_titled_with_icon(
            page_colors, "colors", t("tab_colors"), safe_icon(["preferences-desktop-appearance-symbolic"])
        )
        self.view_stack.add_titled_with_icon(
            page_drivers, "drivers", t("tab_drivers"), safe_icon(["video-display-symbolic"])
        )
        self.view_stack.add_titled_with_icon(
            page_containers, "containers", t("tab_containers"), safe_icon(["package-x-generic-symbolic"])
        )

        self.toolbar_view.set_content(self.view_stack)

        # Initial Tab Selection
        self.set_active_tab(initial_tab)

    def set_active_tab(self, tab_name):
        if tab_name in ("updates", "colors", "drivers", "containers"):
            self.view_stack.set_visible_child_name(tab_name)
            if tab_name == "updates":
                self.check_initial_reboot_status()

    # =========================================================================
    # TAB 1: UPDATES
    # =========================================================================
    def build_updates_page(self):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_propagate_natural_height(False)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(640)
        clamp.set_tightening_threshold(480)
        scrolled.set_child(clamp)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.set_margin_top(20)
        content.set_margin_bottom(24)
        content.set_margin_start(20)
        content.set_margin_end(20)
        clamp.set_child(content)

        # Unified Banner Header
        header = self.build_page_header(
            ["software-update-available-symbolic", "system-software-update-symbolic"],
            t("upd_banner_title"),
            t("upd_banner_desc")
        )
        content.append(header)

        # Target Switches Group
        pref_group = Adw.PreferencesGroup()
        pref_group.set_title(t("upd_group_targets"))
        content.append(pref_group)

        self.sys_row = Adw.SwitchRow()
        self.sys_row.set_use_markup(False)
        self.sys_row.set_title(t("upd_sys_title"))
        self.sys_row.set_subtitle(t("upd_sys_desc"))
        self.sys_row.set_active(True)
        pref_group.add(self.sys_row)

        self.flatpak_row = Adw.SwitchRow()
        self.flatpak_row.set_use_markup(False)
        self.flatpak_row.set_title(t("upd_flatpak_title"))
        self.flatpak_row.set_subtitle(t("upd_flatpak_desc"))
        self.flatpak_row.set_active(True)
        pref_group.add(self.flatpak_row)

        self.box_row = Adw.SwitchRow()
        self.box_row.set_use_markup(False)
        self.box_row.set_title(t("upd_box_title"))
        self.box_row.set_subtitle(t("upd_box_desc"))
        self.box_row.set_active(True)
        pref_group.add(self.box_row)

        # Stage 3: Results Summary Card (PreferencesGroup under target switches)
        self.upd_results_group = Adw.PreferencesGroup()
        self.upd_results_group.set_title(t("upd_results_title"))
        self.upd_results_group.set_visible(False)
        self.upd_result_rows = []
        content.append(self.upd_results_group)

        # Progress / Status Area
        self.upd_progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.upd_spinner = Gtk.Spinner()
        self.upd_spinner.set_visible(False)
        status_box.append(self.upd_spinner)

        self.upd_status_label = Gtk.Label(label=t("status_ready"))
        self.upd_status_label.add_css_class("body")
        self.upd_status_label.set_halign(Gtk.Align.START)
        status_box.append(self.upd_status_label)
        self.upd_progress_box.append(status_box)

        self.upd_progress_bar = Gtk.ProgressBar()
        self.upd_progress_bar.set_show_text(True)
        self.upd_progress_bar.set_fraction(0.0)
        self.upd_progress_bar.set_text("0%")
        self.upd_progress_bar.set_visible(False)
        self.upd_progress_box.append(self.upd_progress_bar)
        content.append(self.upd_progress_box)

        # Action Buttons (Primary button: "Check for Updates" by default)
        actions_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        actions_box.set_halign(Gtk.Align.FILL)

        self.btn_start_update = Gtk.Button(label=t("btn_check_updates"))
        self.btn_start_update.add_css_class("suggested-action")
        self.btn_start_update.add_css_class("pill")
        self.btn_start_update.set_size_request(-1, 46)
        self.btn_start_update.set_hexpand(True)
        self.btn_start_update.connect("clicked", self.on_action_button_clicked)
        actions_box.append(self.btn_start_update)

        content.append(actions_box)

        # Details Expander
        self.upd_expander = Gtk.Expander(label=t("upd_details_title"))
        self.upd_expander.set_expanded(False)

        scrolled_text = Gtk.ScrolledWindow()
        scrolled_text.set_min_content_height(140)
        scrolled_text.set_max_content_height(260)
        scrolled_text.set_propagate_natural_height(False)
        scrolled_text.set_vexpand(False)
        scrolled_text.add_css_class("card")

        self.upd_text_view = Gtk.TextView()
        self.upd_text_view.set_editable(False)
        self.upd_text_view.set_cursor_visible(False)
        self.upd_text_view.set_monospace(True)
        self.upd_text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.upd_text_view.set_top_margin(10)
        self.upd_text_view.set_bottom_margin(10)
        self.upd_text_view.set_left_margin(10)
        self.upd_text_view.set_right_margin(10)
        scrolled_text.set_child(self.upd_text_view)

        self.upd_expander.set_child(scrolled_text)
        content.append(self.upd_expander)

        return scrolled

    def start_upd_pulse(self):
        def _ui_start():
            if self._upd_pulse_timer is None:
                def _pulse():
                    self.upd_progress_bar.pulse()
                    return True
                self._upd_pulse_timer = GLib.timeout_add(120, _pulse)
            return False
        GLib.idle_add(_ui_start)

    def stop_upd_pulse(self):
        def _ui_stop():
            if self._upd_pulse_timer is not None:
                GLib.source_remove(self._upd_pulse_timer)
                self._upd_pulse_timer = None
            return False
        GLib.idle_add(_ui_stop)

    def update_upd_progress(self, fraction):
        self.stop_upd_pulse()
        def _ui_update():
            frac = min(1.0, max(0.0, fraction))
            self.upd_progress_bar.set_fraction(frac)
            pct_text = f"{int(round(frac * 100))}%"
            self.upd_progress_bar.set_text(pct_text)
            return False
        GLib.idle_add(_ui_update)

    def append_upd_log(self, text):
        clean = re.sub(r'\x1b\[[0-9;?]*[a-zA-Z]', '', text).replace('\r', '').strip()
        if not clean:
            return
        def _append():
            buf = self.upd_text_view.get_buffer()
            end_iter = buf.get_end_iter()
            buf.insert(end_iter, clean + "\n")
            mark = buf.create_mark(None, buf.get_end_iter(), False)
            self.upd_text_view.scroll_to_mark(mark, 0.05, False, 0.0, 1.0)
            return False
        GLib.idle_add(_append)

    def start_checking(self):
        if getattr(self, "is_checking", False) or getattr(self, "is_updating", False):
            return

        run_sys = self.sys_row.get_active()
        run_flatpak = self.flatpak_row.get_active()
        run_box = self.box_row.get_active()

        if not (run_sys or run_flatpak or run_box):
            return

        self.is_checking = True
        self.btn_start_update.set_sensitive(False)
        self.sys_row.set_sensitive(False)
        self.flatpak_row.set_sensitive(False)
        self.box_row.set_sensitive(False)

        self.upd_progress_bar.set_visible(False)
        self.upd_spinner.set_visible(True)
        self.upd_spinner.start()
        self.upd_status_label.set_text(t("status_checking"))

        threading.Thread(
            target=self.check_for_updates_thread,
            args=(run_sys, run_flatpak, run_box),
            daemon=True
        ).start()

    def check_for_updates_thread(self, do_sys, do_flatpak, do_box):
        results = {
            "sys": {"has_update": False, "version": "", "diff": ""},
            "flatpak": {"has_update": False, "count": 0, "apps": []},
            "box": {"has_update": False, "count": 0}
        }

        # 1. rpm-ostree upgrade --check
        if do_sys:
            try:
                res = subprocess.run(["rpm-ostree", "upgrade", "--check"], capture_output=True, text=True, timeout=90, check=False)
                if res.returncode == 0:
                    out = res.stdout.strip()
                    if "AvailableUpdate" in out and "AvailableUpdate: none" not in out:
                        results["sys"]["has_update"] = True
                        m_ver = re.search(r'Version:\s*([^\s\n]+)', out)
                        if m_ver:
                            results["sys"]["version"] = m_ver.group(1)
                        m_diff = re.search(r'Diff:\s*([^\n]+)', out)
                        if m_diff:
                            results["sys"]["diff"] = m_diff.group(1)
                        elif "Upgraded:" in out:
                            upg = [l.strip() for l in out.splitlines() if l.strip().startswith("Upgraded:")]
                            if upg:
                                results["sys"]["diff"] = upg[0]
            except Exception:
                pass

        # 2. flatpak remote-ls --updates --columns=application,name,version,download-size
        if do_flatpak:
            try:
                res = subprocess.run(["flatpak", "remote-ls", "--updates", "--columns=application,name,version,download-size"], capture_output=True, text=True, timeout=60, check=False)
                if res.returncode == 0 and res.stdout.strip():
                    lines = [l.strip() for l in res.stdout.strip().splitlines() if l.strip()]
                    apps = []
                    for line in lines:
                        if line.startswith("Application ID") or "Download size" in line:
                            continue
                        parts = re.split(r'\t+|\s{2,}', line)
                        if len(parts) >= 2:
                            app_id = parts[0]
                            name = parts[1]
                            ver = parts[2] if len(parts) > 2 else ""
                            size = parts[3] if len(parts) > 3 else ""
                            apps.append((app_id, name, ver, size))
                    if apps:
                        results["flatpak"]["has_update"] = True
                        results["flatpak"]["count"] = len(apps)
                        results["flatpak"]["apps"] = apps
            except Exception:
                pass

        # 3. Sadeem Box check
        if do_box:
            try:
                chk = subprocess.run(["distrobox", "list", "--no-color"], capture_output=True, text=True, timeout=5, check=False)
                if chk.returncode == 0 and "sadeem-box" in chk.stdout:
                    res = subprocess.run(["distrobox", "enter", "sadeem-box", "--", "dnf", "check-update"], capture_output=True, text=True, timeout=60, check=False)
                    if res.returncode == 100:
                        lines = [l.strip() for l in res.stdout.splitlines() if l.strip()]
                        pkg_lines = []
                        for l in lines:
                            if "Obsoleting Packages" in l:
                                break
                            parts = l.split()
                            if len(parts) >= 3 and not l.startswith("Last metadata") and not l.startswith("Security:"):
                                pkg_lines.append(parts[0])
                        count = len(pkg_lines) if pkg_lines else 1
                        results["box"]["has_update"] = True
                        results["box"]["count"] = count
            except Exception:
                pass

        GLib.idle_add(self.on_check_finished, results)

    def on_check_finished(self, results):
        self.is_checking = False
        self.upd_spinner.stop()
        self.upd_spinner.set_visible(False)
        self.sys_row.set_sensitive(True)
        self.flatpak_row.set_sensitive(True)
        self.box_row.set_sensitive(True)

        for r in getattr(self, "upd_result_rows", []):
            self.upd_results_group.remove(r)
        self.upd_result_rows = []

        has_any = results["sys"]["has_update"] or results["flatpak"]["has_update"] or results["box"]["has_update"]

        if not has_any:
            row = Adw.ActionRow()
            row.set_use_markup(False)
            row.set_title(t("status_all_updated"))
            row.set_subtitle(t("upd_no_updates_desc"))
            row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["emblem-ok-symbolic", "object-select-symbolic"])))
            self.upd_results_group.add(row)
            self.upd_result_rows.append(row)
            self.upd_results_group.set_visible(True)

            self.upd_status_label.set_text(t("status_all_updated"))
            self.btn_start_update.set_label(t("btn_check_again"))
            self.btn_start_update.set_sensitive(True)
            self.current_update_stage = "idle"
        else:
            if results["sys"]["has_update"]:
                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(t("upd_sys_title"))
                ver = results["sys"]["version"]
                diff = results["sys"]["diff"]
                sub_parts = []
                if ver:
                    sub_parts.append(f"Sadeem {ver}")
                if diff:
                    sub_parts.append(diff)
                row.set_subtitle(" • ".join(sub_parts) if sub_parts else t("status_updates_available"))
                row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["software-update-available-symbolic", "system-software-update-symbolic"])))
                self.upd_results_group.add(row)
                self.upd_result_rows.append(row)

            if results["flatpak"]["has_update"]:
                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(t("upd_flatpak_title"))
                apps = results["flatpak"]["apps"]
                app_names = [a[1] if a[1] else a[0] for a in apps]
                preview = ", ".join(app_names[:3])
                if len(app_names) > 3:
                    preview += f" (+{len(app_names) - 3})"
                sub = f"{results['flatpak']['count']} {t('upd_apps_available')}: {preview}"
                row.set_subtitle(sub)
                row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["system-software-install-symbolic", "application-x-executable-symbolic"])))
                self.upd_results_group.add(row)
                self.upd_result_rows.append(row)

            if results["box"]["has_update"]:
                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(t("upd_box_title"))
                row.set_subtitle(f"{results['box']['count']} {t('upd_pkgs_available')}")
                row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["package-x-generic-symbolic", "utilities-terminal-symbolic"])))
                self.upd_results_group.add(row)
                self.upd_result_rows.append(row)

            self.upd_results_group.set_visible(True)
            self.upd_status_label.set_text(t("status_updates_available"))
            self.btn_start_update.set_label(t("btn_install_updates"))
            self.btn_start_update.set_sensitive(True)
            self.current_update_stage = "results_has_updates"

        return False

    def start_installation(self):
        if getattr(self, "is_updating", False):
            return

        run_sys = self.sys_row.get_active()
        run_flatpak = self.flatpak_row.get_active()
        run_box = self.box_row.get_active()

        if not (run_sys or run_flatpak or run_box):
            return

        self.is_updating = True
        self.current_update_stage = "installing"
        self.btn_start_update.set_sensitive(False)
        self.btn_start_update.set_label(t("btn_updating"))
        self.sys_row.set_sensitive(False)
        self.flatpak_row.set_sensitive(False)
        self.box_row.set_sensitive(False)

        self.upd_progress_bar.set_visible(True)
        self.upd_progress_bar.set_show_text(True)
        self.update_upd_progress(0.0)

        buf = self.upd_text_view.get_buffer()
        buf.set_text("")
        self.upd_expander.set_expanded(False)

        threading.Thread(target=self.run_updates_thread, args=(run_sys, run_flatpak, run_box), daemon=True).start()

    def run_upd_command(self, cmd, desc, task_idx, total_tasks):
        full_cmd = ["stdbuf", "-oL", "-eL"] + cmd if os.path.exists("/usr/bin/stdbuf") else cmd
        self.append_upd_log(f"=== {desc} ===")
        self.append_upd_log(f"$ {' '.join(cmd)}")

        base_start = task_idx / total_tasks
        task_range = 1.0 / total_tasks

        # Non-numeric initial phase -> pulse animation
        self.start_upd_pulse()

        try:
            proc = subprocess.Popen(
                full_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                bufsize=0
            )
            buf = bytearray()
            output_lines = []

            def _process_line(raw_line):
                clean = re.sub(r'\x1b\[[0-9;?]*[a-zA-Z]', '', raw_line).replace('\r', '').strip()
                if not clean:
                    return
                output_lines.append(clean)
                self.append_upd_log(clean)

                # Intra-task progress extraction
                sub_pct = None
                m_layer = re.search(r'\[\s*(\d+)\s*/\s*(\d+)\s*\]', clean)
                m_pct = re.search(r'(\d{1,3})%', clean)
                if m_layer:
                    cur, tot = int(m_layer.group(1)), int(m_layer.group(2))
                    if tot > 0:
                        sub_pct = min(1.0, max(0.0, cur / tot))
                elif m_pct:
                    val = int(m_pct.group(1))
                    if 0 <= val <= 100:
                        sub_pct = val / 100.0

                if sub_pct is not None:
                    overall = base_start + (sub_pct * task_range)
                    self.update_upd_progress(overall)
                else:
                    clean_lower = clean.lower()
                    if any(w in clean_lower for w in ["deploying", "staging", "writing", "checking", "resolving", "preparing"]):
                        self.start_upd_pulse()

            while True:
                b = proc.stdout.read(1)
                if not b:
                    break
                if b in (b'\n', b'\r'):
                    if buf:
                        try:
                            raw_str = buf.decode('utf-8', errors='replace')
                        except Exception:
                            raw_str = ""
                        buf.clear()
                        _process_line(raw_str)
                else:
                    buf.extend(b)

            if buf:
                try:
                    raw_str = buf.decode('utf-8', errors='replace')
                    _process_line(raw_str)
                except Exception:
                    pass

            proc.wait()
            self.stop_upd_pulse()
            self.update_upd_progress((task_idx + 1) / total_tasks)
            self.append_upd_log("")
            return proc.returncode, "\n".join(output_lines)

        except Exception as e:
            self.stop_upd_pulse()
            err_msg = f"Error executing {cmd[0]}: {str(e)}"
            self.append_upd_log(err_msg)
            return 1, err_msg

    def run_updates_thread(self, do_sys, do_flatpak, do_box):
        tasks = []
        if do_sys:
            tasks.append("sys")
        if do_flatpak:
            tasks.append("flatpak")
        if do_box:
            tasks.append("box")

        total = len(tasks)
        overall_success = True

        for idx, task in enumerate(tasks):
            if task == "sys":
                GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_sys")))
                code, out = self.run_upd_command(
                    ["pkexec", "rpm-ostree", "upgrade"],
                    "rpm-ostree upgrade",
                    idx,
                    total
                )
                if code == 0:
                    out_lower = out.lower()
                    if any(phrase in out_lower for phrase in [
                        "changes queued for next boot",
                        "staging deployment",
                        "upgraded:",
                        "downgraded:",
                        "added:",
                        "removed:",
                        "pinned:",
                        "freed:",
                        "staged"
                    ]):
                        self.reboot_required = True
                    try:
                        st = subprocess.run(["rpm-ostree", "status"], capture_output=True, text=True, check=False)
                        st_lower = st.stdout.lower()
                        if "changes queued" in st_lower or "staged" in st_lower:
                            self.reboot_required = True
                    except Exception:
                        pass
                else:
                    overall_success = False

            elif task == "flatpak":
                GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_flatpak")))
                code, out = self.run_upd_command(
                    ["flatpak", "update", "-y", "--noninteractive"],
                    "flatpak update",
                    idx,
                    total
                )
                if code == 0:
                    GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_flatpak_cleanup")))
                    self.run_upd_command(
                        ["flatpak", "uninstall", "--unused", "-y", "--noninteractive"],
                        "flatpak cleanup",
                        idx,
                        total
                    )
                else:
                    overall_success = False

            elif task == "box":
                GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_box")))
                code, out = self.run_upd_command(
                    ["distrobox", "upgrade", "sadeem-box"],
                    "distrobox upgrade sadeem-box",
                    idx,
                    total
                )
                if code == 0:
                    GLib.idle_add(lambda: self.upd_status_label.set_text(t("status_box_cleanup")))
                    self.run_upd_command(
                        ["distrobox", "enter", "sadeem-box", "--", "sudo", "dnf", "clean", "all"],
                        "distrobox clean cache",
                        idx,
                        total
                    )
                else:
                    overall_success = False

        GLib.idle_add(self.on_updates_finished, overall_success)

    def on_updates_finished(self, success):
        self.is_updating = False
        self.stop_upd_pulse()
        self.upd_progress_bar.set_visible(False)
        self.sys_row.set_sensitive(True)
        self.flatpak_row.set_sensitive(True)
        self.box_row.set_sensitive(True)
        self.check_box_availability()

        def _check_finished():
            pending = has_pending_reboot()
            def _ui():
                if pending:
                    self.reboot_ready = True
                    self.btn_start_update.set_label(t("install_and_restart"))
                    self.btn_start_update.set_sensitive(True)
                    if not self.btn_start_update.has_css_class("suggested-action"):
                        self.btn_start_update.add_css_class("suggested-action")
                    if not self.btn_start_update.has_css_class("pill"):
                        self.btn_start_update.add_css_class("pill")
                    self.upd_status_label.set_text(t("status_reboot"))
                    for r in getattr(self, "upd_result_rows", []):
                        self.upd_results_group.remove(r)
                    self.upd_result_rows = []
                    row = Adw.ActionRow()
                    row.set_use_markup(False)
                    row.set_title(t("install_and_restart"))
                    row.set_subtitle(t("status_reboot"))
                    row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["system-reboot-symbolic", "view-refresh-symbolic"])))
                    self.upd_results_group.add(row)
                    self.upd_result_rows.append(row)
                    self.upd_results_group.set_visible(True)
                elif success:
                    self.reboot_ready = False
                    self.current_update_stage = "idle"
                    self.btn_start_update.set_label(t("btn_check_again"))
                    self.btn_start_update.set_sensitive(True)
                    self.upd_status_label.set_text(t("status_done"))
                    for r in getattr(self, "upd_result_rows", []):
                        self.upd_results_group.remove(r)
                    self.upd_result_rows = []
                    row = Adw.ActionRow()
                    row.set_use_markup(False)
                    row.set_title(t("status_all_updated"))
                    row.set_subtitle(t("upd_no_updates_desc"))
                    row.add_prefix(Gtk.Image.new_from_icon_name(safe_icon(["emblem-ok-symbolic", "object-select-symbolic"])))
                    self.upd_results_group.add(row)
                    self.upd_result_rows.append(row)
                    self.upd_results_group.set_visible(True)
                else:
                    self.reboot_ready = False
                    self.current_update_stage = "idle"
                    self.btn_start_update.set_label(t("btn_check_again"))
                    self.btn_start_update.set_sensitive(True)
                    self.upd_status_label.set_text(t("status_error"))
                return False
            GLib.idle_add(_ui)

        threading.Thread(target=_check_finished, daemon=True).start()
        return False
