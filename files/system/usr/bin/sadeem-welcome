RUNTIME_FRIENDLY_NAMES = {
    "org.gnome.Platform": {"ar": "بيئة تشغيل جنوم", "en": "GNOME Platform"},
    "org.kde.Platform": {"ar": "بيئة تشغيل كيدي", "en": "KDE Platform"},
