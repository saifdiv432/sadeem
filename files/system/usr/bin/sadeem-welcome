def get_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG"):
        val = os.environ.get(var, "")
        if val:
            code = val.split(":")[0].split(".")[0].split("_")[0].split("@")[0].lower()
            if code in WELCOME_TRANSLATIONS:
                return code
    return "en"


LANG = get_language()


def t(key, **kwargs):
    entry = WELCOME_TRANSLATIONS.get(LANG, {})
    val = entry.get(key)
    if val is None or val == "":
        val = WELCOME_TRANSLATIONS.get("en", {}).get(key, key)
    if kwargs and isinstance(val, str):
        try:
            return val.format(**kwargs)
        except Exception:
            return val
    return val


_ = t


def setup_icon_theme():
    display = Gdk.Display.get_default()
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        search_paths = [
            "/usr/share/icons/hicolor/scalable/apps",
            "/usr/share/icons/hicolor/256x256/apps",
            "/usr/share/icons/hicolor/128x128/apps",
            "/usr/share/icons/hicolor/64x64/apps",
            "/usr/share/icons/hicolor/48x48/apps",
            "/usr/share/pixmaps",
            "/var/lib/flatpak/exports/share/icons",
            os.path.expanduser("~/.local/share/flatpak/exports/share/icons"),
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "scalable", "apps")),
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "256x256", "apps")),
        ]
        for p in search_paths:
            if os.path.isdir(p):
                theme.add_search_path(p)


def safe_icon(icon_names, fallback="application-x-executable-symbolic"):
    if isinstance(icon_names, str):
        icon_names = [icon_names]
    display = Gdk.Display.get_default()
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        for name in icon_names:
            if name and theme.has_icon(name):
                return name
    for name in icon_names:
        if name:
            if os.path.isabs(name) and os.path.exists(name):
                return name
            for prefix in ("/usr/share/icons/hicolor/scalable/apps",
                           "/usr/share/icons/hicolor/256x256/apps",
                           "/usr/share/pixmaps"):
                for ext in (".svg", ".png"):
                    p = os.path.join(prefix, f"{name}{ext}")
                    if os.path.exists(p):
                        return name
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        if theme.has_icon(fallback):
            return fallback
        for fb in ("application-x-executable-symbolic", "system-run-symbolic", "image-missing-symbolic"):
            if theme.has_icon(fb):
                return fb
    return fallback


def create_badge(icon_names, size=64, icon_size=28, fallback="application-x-executable-symbolic"):
    badge = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    badge.set_halign(Gtk.Align.CENTER)
    badge.set_valign(Gtk.Align.CENTER)
    badge.set_size_request(size, size)
    badge.add_css_class("sadeem-gradient-badge")

    icon = safe_icon(icon_names, fallback=fallback)
    img = Gtk.Image.new_from_icon_name(icon)
    img.set_pixel_size(icon_size)
    img.set_halign(Gtk.Align.CENTER)
    img.set_valign(Gtk.Align.CENTER)
    img.set_hexpand(True)
    img.set_vexpand(True)
    badge.append(img)
    return badge


def build_page_header(icon_names, title, subtitle):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.set_halign(Gtk.Align.CENTER)
    box.set_margin_bottom(6)

    badge = create_badge(icon_names, size=64, icon_size=28)
    badge.set_halign(Gtk.Align.CENTER)
    box.append(badge)

    title_lbl = Gtk.Label(label=title)
    title_lbl.add_css_class("sadeem-header-title")
    title_lbl.set_wrap(True)
    title_lbl.set_justify(Gtk.Justification.CENTER)
    box.append(title_lbl)

    sub_lbl = Gtk.Label(label=subtitle)
    sub_lbl.add_css_class("sadeem-header-subtitle")
    sub_lbl.set_wrap(True)
    sub_lbl.set_justify(Gtk.Justification.CENTER)
    sub_lbl.set_max_width_chars(54)
    box.append(sub_lbl)

    return box


def find_desktop_file_and_icon(app_id_candidates):
    search_dirs = [
        "/usr/share/applications",
        "/var/lib/flatpak/exports/share/applications",
        os.path.expanduser("~/.local/share/applications"),
        os.path.expanduser("~/.local/share/flatpak/exports/share/applications")
    ]
    for app_id in app_id_candidates:
        filenames = [app_id if app_id.endswith(".desktop") else f"{app_id}.desktop"]
        for d in search_dirs:
            for fname in filenames:
                full_path = os.path.join(d, fname)
                if os.path.isfile(full_path):
                    icon_val = None
                    exec_val = None
                    try:
                        with open(full_path, "r", encoding="utf-8", errors="replace") as f:
                            for line in f:
                                line = line.strip()
                                if line.startswith("Icon="):
                                    icon_val = line.split("Icon=", 1)[1].strip()
                                elif line.startswith("Exec="):
                                    exec_val = line.split("Exec=", 1)[1].strip()
                    except Exception:
                        pass
                    desktop_id = fname[:-8] if fname.endswith(".desktop") else fname
                    return desktop_id, icon_val, exec_val
    return None, None, None


def create_colorful_app_icon(app_id_candidates, fallback_icon_names, fallback_symbolic="application-x-executable-symbolic", size=40):
    _, desktop_icon, _ = find_desktop_file_and_icon(app_id_candidates)
    
    candidates = []
    if desktop_icon:
        candidates.append(desktop_icon)
    if isinstance(fallback_icon_names, (list, tuple)):
        candidates.extend(fallback_icon_names)
    elif fallback_icon_names:
        candidates.append(fallback_icon_names)

    # 1. Check direct file or standard icon directories
    for name in candidates:
        if os.path.isabs(name) and os.path.isfile(name):
            try:
                img = Gtk.Image.new_from_file(name)
                img.set_pixel_size(size)
                return img
            except Exception:
                pass
        for base_dir in [
            "/usr/share/icons/hicolor/scalable/apps",
            "/usr/share/icons/hicolor/256x256/apps",
            "/usr/share/icons/hicolor/128x128/apps",
            "/usr/share/icons/hicolor/64x64/apps",
            "/usr/share/icons/hicolor/48x48/apps",
            "/var/lib/flatpak/exports/share/icons/hicolor/scalable/apps",
            "/var/lib/flatpak/exports/share/icons/hicolor/256x256/apps",
            "/usr/share/pixmaps",
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "scalable", "apps")),
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "share", "icons", "hicolor", "256x256", "apps")),
        ]:
            for ext in (".svg", ".png"):
                p = os.path.join(base_dir, f"{name}{ext}")
                if os.path.isfile(p):
                    try:
                        img = Gtk.Image.new_from_file(p)
                        img.set_pixel_size(size)
                        return img
                    except Exception:
                        pass

    # 2. Check icon theme
    display = Gdk.Display.get_default()
    if display:
        theme = Gtk.IconTheme.get_for_display(display)
        for name in candidates:
            if theme.has_icon(name):
                img = Gtk.Image.new_from_icon_name(name)
                img.set_pixel_size(size)
                return img

    # 3. Fallback symbolic icon
    fb_icon = safe_icon([fallback_symbolic, "application-x-executable-symbolic"])
    img = Gtk.Image.new_from_icon_name(fb_icon)
    img.set_pixel_size(size)
    return img


def create_app_icon(icon_names, size=40, fallback="application-x-executable-symbolic"):
    return create_colorful_app_icon(icon_names, icon_names, fallback_symbolic=fallback, size=size)


# --- Configuration & Paths ---
APP_ID = "org.sadeem.Welcome"
CONFIG_DIR = os.path.expanduser("~/.config/sadeem")
SEEN_FILE = os.path.join(CONFIG_DIR, "welcome-seen")
LEGACY_SEEN_FILE = os.path.expanduser("~/.config/saifdora/welcome-seen")
AUTOSTART_DESKTOP_FILENAME = "org.sadeem.Welcome.desktop"
USER_AUTOSTART_DIR = os.path.expanduser("~/.config/autostart")
USER_AUTOSTART_FILE = os.path.join(USER_AUTOSTART_DIR, AUTOSTART_DESKTOP_FILENAME)


def is_autostart_disabled():
    """Check if autostart is disabled via user XDG autostart override."""
    if not os.path.isfile(USER_AUTOSTART_FILE):
        return False
    try:
        with open(USER_AUTOSTART_FILE, "r", encoding="utf-8") as f:
            for line in f:
                clean = line.strip().lower().replace(" ", "")
                if clean in ("hidden=true", "x-gnome-autostart-enabled=false"):
                    return True
    except Exception:
        pass
    return False


def is_seen():
    return is_autostart_disabled() or os.path.exists(SEEN_FILE) or os.path.exists(LEGACY_SEEN_FILE)


def check_nvidia_status():
    """Detect presence of NVIDIA GPU and whether proprietary driver is installed."""
    has_nvidia = False
    driver_installed = False
    try:
        res = subprocess.run(["lspci", "-nn"], capture_output=True, text=True, check=False)
        for line in res.stdout.splitlines():
            if "[10de:" in line:
                has_nvidia = True
                break
    except Exception:
        pass

    if has_nvidia:
        try:
            res_smi = subprocess.run(["nvidia-smi"], capture_output=True, text=True, check=False)
            if res_smi.returncode == 0:
                driver_installed = True
        except Exception:
            pass

        if not driver_installed:
            try:
                if os.path.exists("/proc/modules"):
                    with open("/proc/modules", "r") as f:
                        mods = f.read()
                        if "nvidia " in mods and "nouveau " not in mods:
                            driver_installed = True
            except Exception:
                pass

    return has_nvidia, driver_installed


def get_active_accent_color():
    gtk4_file = os.path.expanduser("~/.config/gtk-4.0/gtk.css")
    if os.path.exists(gtk4_file):
        try:
            with open(gtk4_file, "r") as f:
                for line in f:
                    if "--accent-bg-color:" in line:
                        val = line.split("--accent-bg-color:")[1].split(";")[0].strip()
                        if val.startswith("#") and len(val) in (4, 7):
                            return val
                    elif "accent_bg_color" in line:
                        val = line.split("accent_bg_color")[1].strip().rstrip(";").strip()
                        if val.startswith("#") and len(val) in (4, 7):
                            return val
        except Exception:
            pass
    return "#7a1c33"


