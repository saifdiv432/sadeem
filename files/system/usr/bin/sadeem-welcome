    def launch_app_smart(self, desktop_candidates, flatpak_id=None, direct_cmd=None):
        """Safely launch applications natively via discovered desktop file, flatpak, or direct executable."""
        desktop_id, _, _ = find_desktop_file_and_icon(desktop_candidates)
        if desktop_id:
            try:
                res = subprocess.run(["gtk-launch", desktop_id], capture_output=True, check=False)
                if res.returncode == 0:
                    return
            except Exception:
                pass

        for dt in desktop_candidates:
            clean_name = dt[:-8] if dt.endswith(".desktop") else dt
            try:
                res = subprocess.run(["gtk-launch", clean_name], capture_output=True, check=False)
                if res.returncode == 0:
                    return
            except Exception:
                pass

        if flatpak_id:
            try:
                res = subprocess.run(["flatpak", "info", flatpak_id], capture_output=True, text=True, check=False)
                if res.returncode == 0:
                    subprocess.Popen(["flatpak", "run", flatpak_id])
                    return
            except Exception:
                pass

        if direct_cmd:
            try:
                subprocess.Popen(direct_cmd)
                return
            except Exception as e:
                print(f"Error launching {direct_cmd}: {e}", file=sys.stderr)

    def launch_app(self, cmd_args, desktop_name=None):
        """Safely launch applications natively via desktop or direct executable."""
        if desktop_name:
            try:
                res = subprocess.run(["gtk-launch", desktop_name], capture_output=True, check=False)
                if res.returncode == 0:
                    return
            except Exception:
                pass
        try:
            subprocess.Popen(cmd_args)
        except Exception as e:
            print(f"Error launching {cmd_args}: {e}", file=sys.stderr)

    def launch_desktop_or_flatpak(self, app_id):
        """Smart launcher trying desktop file first, flatpak next, and flathub install toast fallback."""
        try:
            res = subprocess.run(["gtk-launch", app_id], capture_output=True, check=False)
            if res.returncode == 0:
                return
        except Exception:
            pass
        try:
            res = subprocess.run(["flatpak", "info", app_id], capture_output=True, text=True, check=False)
            if res.returncode == 0:
                subprocess.Popen(["flatpak", "run", app_id])
                return
        except Exception:
            pass

        # App is not yet installed or downloading in background
        msg = t("toast_installing")
        toast = Adw.Toast.new(msg)
        toast.set_timeout(4)
        self.toast_overlay.add_toast(toast)

        # Trigger background installation
        try:
            subprocess.Popen(["flatpak", "install", "-y", "--system", "flathub", app_id])
        except Exception as e:
            print(f"Error triggering flatpak install for {app_id}: {e}", file=sys.stderr)

    def on_install_nvidia(self, *args):
        self.launch_app(["/usr/bin/sadeem-system", "--tab=drivers"])

    def on_prev_clicked(self, *args):
        curr = int(round(self.carousel.get_position()))
        if curr > 0:
            self.carousel.scroll_to(self.carousel.get_nth_page(curr - 1), True)

    def on_next_clicked(self, *args):
        curr = int(round(self.carousel.get_position()))
        total = self.carousel.get_n_pages()
        if curr < total - 1:
            self.carousel.scroll_to(self.carousel.get_nth_page(curr + 1), True)
        else:
            self.close()

    def on_page_changed(self, carousel, index):
        total = carousel.get_n_pages()
        if index == 0:
            self.prev_btn.set_opacity(0.0)
            self.prev_btn.set_sensitive(False)
        else:
            self.prev_btn.set_opacity(1.0)
            self.prev_btn.set_sensitive(True)

        if not self.prev_btn.has_css_class("pill"):
            self.prev_btn.add_css_class("pill")
        if self.prev_btn.has_css_class("suggested-action"):
            self.prev_btn.remove_css_class("suggested-action")
        if self.prev_btn.has_css_class("sadeem-primary-btn"):
            self.prev_btn.remove_css_class("sadeem-primary-btn")

        if index == total - 1:
            self.next_btn.set_label(t("btn_start"))
        else:
            self.next_btn.set_label(t("btn_next"))

        if not self.next_btn.has_css_class("suggested-action"):
            self.next_btn.add_css_class("suggested-action")
        if not self.next_btn.has_css_class("pill"):
            self.next_btn.add_css_class("pill")
        if not self.next_btn.has_css_class("sadeem-primary-btn"):
            self.next_btn.add_css_class("sadeem-primary-btn")

    def on_startup_toggled(self, button):
        state = button.get_active()
        os.makedirs(CONFIG_DIR, exist_ok=True)
        if state:
            # Active means show on startup -> remove seen files
            for sf in (SEEN_FILE, LEGACY_SEEN_FILE):
                if os.path.exists(sf):
                    try:
                        os.remove(sf)
                    except Exception:
                        pass
        else:
            # Inactive means do not show on startup -> create seen file
            try:
                with open(SEEN_FILE, "w") as f:
                    f.write("seen\n")
            except Exception:
                pass


class WelcomeApplication(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )

    def do_command_line(self, command_line):
        args = command_line.get_arguments()
        is_autostart = "--autostart" in args or "DESKTOP_AUTOSTART_ID" in os.environ
        if is_autostart and is_seen():
            return 0

        self.activate()
        return 0

    def do_activate(self):
        setup_icon_theme()
        if LANG in ("ar", "ur"):
            Gtk.Widget.set_default_direction(Gtk.TextDirection.RTL)
        else:
            Gtk.Widget.set_default_direction(Gtk.TextDirection.LTR)
        win = self.get_active_window()
        if not win:
            win = WelcomeWindow(application=self)
        win.present()


def main():
    # Fast exit for autostart if already seen before starting GTK
    is_autostart = "--autostart" in sys.argv or "DESKTOP_AUTOSTART_ID" in os.environ
    if is_autostart and is_seen():
        sys.exit(0)

    GLib.set_prgname("org.sadeem.Welcome")
    app = WelcomeApplication()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
