def get_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG"):
        val = os.environ.get(var, "")
        if val:
            code = val.split(":")[0].split(".")[0].split("_")[0].split("@")[0].lower()
            if code in WELCOME_TRANSLATIONS:
                return code
    return "en"

LANG = get_language()
T = WELCOME_TRANSLATIONS[LANG]

def _(key):
    return T.get(key, WELCOME_TRANSLATIONS["en"].get(key, key))

# --- Configuration & Paths ---
APP_ID = "org.sadeem.welcome"
CONFIG_DIR = os.path.expanduser("~/.config/sadeem")
SEEN_FILE = os.path.join(CONFIG_DIR, "welcome-seen")
LEGACY_SEEN_FILE = os.path.expanduser("~/.config/saifdora/welcome-seen")

def is_seen():
    return os.path.exists(SEEN_FILE) or os.path.exists(LEGACY_SEEN_FILE)

def check_nvidia_status():
    """Detect presence of NVIDIA GPU and whether proprietary driver is installed."""
    has_nvidia = False
    driver_installed = False
    try:
        res = subprocess.run(["lspci", "-nn"], capture_output=True, text=True, check=False)
        for line in res.stdout.splitlines():
            if "[10de:" in line:
                has_nvidia = True
                break
    except Exception:
        pass

    if has_nvidia:
        try:
            res_rpm = subprocess.run(["rpm", "-q", "akmod-nvidia", "akmod-nvidia-580xx"],
                                     capture_output=True, text=True, check=False)
            if "akmod-nvidia" in res_rpm.stdout and "not installed" not in res_rpm.stdout:
                driver_installed = True
        except Exception:
            pass

        try:
            if os.path.exists("/proc/modules"):
                with open("/proc/modules", "r") as f:
                    if "nvidia " in f.read():
                        driver_installed = True
        except Exception:
            pass

    return has_nvidia, driver_installed


class WelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title(_("window_title"))
        self.set_default_size(640, 620)
        self.set_resizable(False)

        # Apply cohesive GNOME HIG styling
        self.apply_custom_css()

        # Root ToastOverlay
        self.toast_overlay = Adw.ToastOverlay()
        self.set_content(self.toast_overlay)

        # Main ToolbarView
        self.toolbar_view = Adw.ToolbarView()
        self.toast_overlay.set_child(self.toolbar_view)

        # Flat HeaderBar with Centered Indicator Dots
        self.header_bar = Adw.HeaderBar()
        self.header_bar.add_css_class("flat")
        self.toolbar_view.add_top_bar(self.header_bar)

        # NVIDIA Notification Banner
        self.banner = Adw.Banner()
        self.banner.set_title(_("banner_title"))
        self.banner.set_button_label(_("banner_btn"))
        self.banner.connect("button-clicked", self.on_install_nvidia)
        self.toolbar_view.add_top_bar(self.banner)

        # Check NVIDIA status
        has_nvidia, driver_installed = check_nvidia_status()
        if has_nvidia and not driver_installed:
            self.banner.set_revealed(True)

        # Carousel Container (Disable scroll wheel to avoid touchpad conflict)
        self.carousel = Adw.Carousel()
        self.carousel.set_allow_scroll_wheel(False)
        self.carousel.set_hexpand(True)
        self.carousel.set_vexpand(True)
        self.carousel.connect("page-changed", self.on_page_changed)
        self.toolbar_view.set_content(self.carousel)

        # Set Centered Indicator Dots in HeaderBar
        self.dots = Adw.CarouselIndicatorDots()
        self.dots.set_carousel(self.carousel)
        self.header_bar.set_title_widget(self.dots)

        # Bottom Action Bar with transparent seamless background
        self.action_bar = Gtk.ActionBar()

        # Start: Previous button
        self.prev_btn = Gtk.Button(label=_("btn_prev"))
        self.prev_btn.set_size_request(115, 36)
        self.prev_btn.set_visible(False)
        self.prev_btn.connect("clicked", self.on_prev_clicked)
        self.action_bar.pack_start(self.prev_btn)

        # Center: Show on startup checkbox
        self.startup_check = Gtk.CheckButton(label=_("check_startup"))
        self.startup_check.set_active(not is_seen())
        self.startup_check.connect("toggled", self.on_startup_toggled)
        self.action_bar.set_center_widget(self.startup_check)

        # End: Next / Get Started button
        self.next_btn = Gtk.Button(label=_("btn_next"))
        self.next_btn.add_css_class("suggested-action")
        self.next_btn.set_size_request(115, 36)
        self.next_btn.connect("clicked", self.on_next_clicked)
        self.action_bar.pack_end(self.next_btn)

        self.toolbar_view.add_bottom_bar(self.action_bar)

        # Build 5 Carousel Slides (3 rows each)
        self.build_slide_ready()
        self.build_slide_apps()
        self.build_slide_extensions()
        self.build_slide_hardware()
        self.build_slide_navigation()

    def apply_custom_css(self):
        """Apply CSS rules for seamless background, rounded buttons, and badges."""
        css = """
        actionbar > revealer > box {
            background: transparent;
            border-top: none;
            box-shadow: none;
            padding: 12px 24px 18px 24px;
        }

        button {
            border-radius: 10px;
        }

        .boxed-list {
            border-radius: 12px;
        }

        .icon-badge {
            background-color: alpha(@accent_bg_color, 0.14);
            color: @accent_color;
            border-radius: 9999px;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_string(css)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def create_slide_container(self, icon_name, title, subtitle):
        """Helper to create standard clamped slide layout with circular tinted badge."""
        clamp = Adw.Clamp()
        clamp.set_maximum_size(530)
        clamp.set_margin_start(24)
        clamp.set_margin_end(24)
        clamp.set_valign(Gtk.Align.CENTER)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        clamp.set_child(box)

        # Header Circular Tinted Badge
        if icon_name:
            badge = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            badge.set_halign(Gtk.Align.CENTER)
            badge.set_valign(Gtk.Align.CENTER)
            badge.set_size_request(76, 76)
            badge.add_css_class("icon-badge")

            img = Gtk.Image.new_from_icon_name(icon_name)
            img.set_pixel_size(40)
            img.set_halign(Gtk.Align.CENTER)
            img.set_valign(Gtk.Align.CENTER)
            img.set_hexpand(True)
            img.set_vexpand(True)
            badge.append(img)
            box.append(badge)

        title_lbl = Gtk.Label(label=title)
        title_lbl.add_css_class("title-1")
        title_lbl.set_wrap(True)
        title_lbl.set_justify(Gtk.Justification.CENTER)
        box.append(title_lbl)

        sub_lbl = Gtk.Label(label=subtitle)
        sub_lbl.add_css_class("body")
        sub_lbl.add_css_class("dim-label")
        sub_lbl.set_wrap(True)
        sub_lbl.set_justify(Gtk.Justification.CENTER)
        box.append(sub_lbl)

        return clamp, box

    def create_action_row(self, title, subtitle, icon_name=None, suffix_btn=None):
        """Helper to create an unactivatable ActionRow with uniform styling."""
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        row.set_activatable(False)
        row.set_title_lines(1)
        row.set_subtitle_lines(2)
        if icon_name:
            row.add_prefix(Gtk.Image.new_from_icon_name(icon_name))
        if suffix_btn:
            row.add_suffix(suffix_btn)
        return row

    def create_row_button(self, label, on_click, suggested=False):
        """Helper to create uniform rectangular row button (width=125, height=34)."""
        btn = Gtk.Button(label=label)
        btn.set_valign(Gtk.Align.CENTER)
        btn.set_size_request(125, 34)
        if suggested:
            btn.add_css_class("suggested-action")
        btn.connect("clicked", on_click)
        return btn

    def build_slide_ready(self):
        """Slide 1: Out-of-the-box readiness (3 rows)."""
        slide, box = self.create_slide_container(
            "computer-symbolic",
            _("s1_title"),
            _("s1_sub")
        )
        listbox = Gtk.ListBox()
        listbox.add_css_class("boxed-list")
        listbox.set_selection_mode(Gtk.SelectionMode.NONE)

        r1 = self.create_action_row(
            _("s1_r1_t"),
            _("s1_r1_d"),
            "video-x-generic-symbolic"
        )
        listbox.append(r1)

        r2 = self.create_action_row(
            _("s1_r2_t"),
            _("s1_r2_d"),
            "software-properties-symbolic"
        )
        listbox.append(r2)

        r3 = self.create_action_row(
            _("s1_r3_t"),
            _("s1_r3_d"),
            "package-x-generic-symbolic"
        )
        listbox.append(r3)

        box.append(listbox)
        self.carousel.append(slide)

