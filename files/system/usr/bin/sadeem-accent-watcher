#!/bin/bash
# One-time migration to v3 (Ensure Sadeem Desktop Helper enabled, clean disabled-extensions, capture shortcuts)
if [ ! -f "$HOME/.config/sadeem/migration-v3.done" ]; then
    mkdir -p "$HOME/.config/sadeem"

    EXT="sadeem-desktop-helper@sadeem.os"

    # Wait up to 20 seconds for GNOME Shell D-Bus / gsettings to be responsive
    for i in $(seq 1 20); do
        if gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 || \
           gdbus call --session --dest org.gnome.Shell.Extensions --object-path /org/gnome/Shell/Extensions --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 || \
           gsettings get org.gnome.shell enabled-extensions >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done

    # 1. Remove EXT from disabled-extensions if present
    DISABLED_EXTS=$(gsettings get org.gnome.shell disabled-extensions 2>/dev/null || echo "[]")
    if echo "$DISABLED_EXTS" | grep -q "$EXT"; then
        NEW_DISABLED=$(python3 -c "
import ast
try:
    arr = ast.literal_eval('''$DISABLED_EXTS''')
    arr = [x for x in arr if x != '$EXT']
    print(str(arr))
except Exception:
    pass
" 2>/dev/null)
        if [ -n "$NEW_DISABLED" ]; then
            gsettings set org.gnome.shell disabled-extensions "$NEW_DISABLED" 2>/dev/null || true
        fi
    fi

    # 2. Add EXT to enabled-extensions
    CURRENT_EXTS=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "[]")
    if ! echo "$CURRENT_EXTS" | grep -q "$EXT"; then
        NEW_EXTS=$(python3 -c "
import ast
try:
    arr = ast.literal_eval('''$CURRENT_EXTS''')
    if '$EXT' not in arr:
        arr.append('$EXT')
    print(str(arr))
except Exception:
    pass
" 2>/dev/null)
        if [ -n "$NEW_EXTS" ]; then
            gsettings set org.gnome.shell enabled-extensions "$NEW_EXTS" 2>/dev/null || true
        fi
    fi

    # 3. Call gnome-extensions enable directly
    gnome-extensions enable "$EXT" 2>/dev/null || true

    # 4. Disable default GNOME Shell screenshot shortcuts
    gsettings set org.gnome.shell.keybindings show-screenshot-ui "@as []" 2>/dev/null || true
    gsettings set org.gnome.shell.keybindings screenshot "@as []" 2>/dev/null || true

    # 5. Add custom shortcuts for Sadeem Capture and Stop Recording
    gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-capture/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record/']" 2>/dev/null || true
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-capture/ name "Sadeem Capture" 2>/dev/null || true
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-capture/ command "/usr/bin/sadeem-capture" 2>/dev/null || true
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-capture/ binding "Print" 2>/dev/null || true

    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record/ name "Stop Screen Recording" 2>/dev/null || true
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record/ command "/usr/bin/sadeem-capture --stop-recording" 2>/dev/null || true
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom-sadeem-stop-record/ binding "<Shift>Print" 2>/dev/null || true

    # 6. Sync dash-to-panel monitor positions and hide 9-dots button
    gsettings set org.gnome.shell.extensions.dash-to-panel panel-element-positions-monitors-sync true 2>/dev/null || true
    gsettings set org.gnome.shell.extensions.dash-to-panel show-apps-icon-file "" 2>/dev/null || true

    touch "$HOME/.config/sadeem/migration-v3.done"
fi

gsettings set org.gnome.desktop.interface accent-color 'red' 2>/dev/null || true
gsettings monitor org.gnome.desktop.interface accent-color | while read -r line; do
    val=$(echo "$line" | awk '{print $NF}' | tr -d "'")
    if [ -n "$val" ] && [ "$val" != "red" ]; then
        gsettings set org.gnome.desktop.interface accent-color 'red' 2>/dev/null || true
        now=$(date +%s)
        last=$(cat /tmp/sadeem-colors-last 2>/dev/null || echo 0)
        if [ $((now - last)) -ge 2 ]; then
            echo "$now" > /tmp/sadeem-colors-last
            /usr/bin/sadeem-colors >/dev/null 2>&1 &
        fi
    fi
done
