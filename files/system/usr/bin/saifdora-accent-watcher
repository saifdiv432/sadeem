#!/bin/bash
gsettings set org.gnome.desktop.interface accent-color 'red' 2>/dev/null || true
gsettings monitor org.gnome.desktop.interface accent-color | while read -r line; do
    val=$(echo "$line" | awk '{print $NF}' | tr -d "'")
    if [ -n "$val" ] && [ "$val" != "red" ]; then
        gsettings set org.gnome.desktop.interface accent-color 'red' 2>/dev/null || true
        now=$(date +%s)
        last=$(cat /tmp/saifdora-colors-last 2>/dev/null || echo 0)
        if [ $((now - last)) -ge 2 ]; then
            echo "$now" > /tmp/saifdora-colors-last
            /usr/bin/saifdora-colors >/dev/null 2>&1 &
        fi
    fi
done
