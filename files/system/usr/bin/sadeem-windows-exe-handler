#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Sadeem Windows App Runner (sadeem-windows-exe-handler)
Seamless, automatic launcher for Windows executables (.exe and .msi) in Sadeem OS.
Built with Python 3, GTK 4, and Libadwaita following GNOME Human Interface Guidelines.
"""

import os
import sys
import subprocess
import threading
import urllib.parse
import shutil
import time
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio, Gdk

BOTTLE_NAME = "Sadeem-Windows"
BOTTLE_DIR = os.path.expanduser(f"~/.var/app/com.usebottles.bottles/data/bottles/bottles/{BOTTLE_NAME}")

