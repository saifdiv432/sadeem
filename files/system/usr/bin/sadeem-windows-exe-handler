#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Sadeem Windows App Runner (sadeem-windows-exe-handler)
Seamless, automatic launcher for Windows executables (.exe and .msi) in Sadeem OS,
plus automatic GNOME .desktop shortcut & icon synchronization for installed Windows apps.
Built with Python 3, GTK 4, and Libadwaita following GNOME Human Interface Guidelines.
"""

import fcntl
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse

for _sync_dir in (
    os.path.abspath(
        os.path.join(
            os.path.dirname(os.path.realpath(__file__)), "..", "share", "sadeem-windows"
        )
    ),
    "/usr/share/sadeem-windows",
):
    if os.path.isdir(_sync_dir) and _sync_dir not in sys.path:
        sys.path.insert(0, _sync_dir)

import shortcut_sync  # noqa: E402

BOTTLE_NAME = "Sadeem-Windows"
BOTTLE_DIR = os.path.expanduser(
    f"~/.var/app/com.usebottles.bottles/data/bottles/bottles/{BOTTLE_NAME}"
)

