#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Sadeem Package Installer (sadeem-pkg-installer)
Graphical installer for external .rpm and .deb packages using Distrobox sandboxes.
Built with Python 3, GTK 4, and Libadwaita following GNOME Human Interface Guidelines.
"""

import sys
import os
import subprocess
import threading
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio, Gdk

