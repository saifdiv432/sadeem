def get_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG"):
        val = os.environ.get(var, "")
        if val:
            code = val.split(":")[0].split(".")[0].split("_")[0].split("@")[0].lower()
            if code in TRANSLATIONS:
                return code
    return "en"

LANG = get_language()
T = TRANSLATIONS[LANG]

def _t(key):
    return T.get(key, TRANSLATIONS["en"].get(key, key))


class SadeemPkgInstallerWindow(Adw.ApplicationWindow):
    def __init__(self, app, pkg_path=None):
        super().__init__(application=app)
        self.set_title(_t("app_title"))
        self.set_default_size(460, 320)
        self.set_resizable(False)

        self.pkg_path = os.path.abspath(pkg_path) if pkg_path else None
        self._is_installing = False

        self.apply_custom_css()

        self.toast_overlay = Adw.ToastOverlay()
        self.toolbar_view = Adw.ToolbarView()
        self.toast_overlay.set_child(self.toolbar_view)
        self.set_content(self.toast_overlay)

        # HeaderBar
        header_bar = Adw.HeaderBar()
        header_bar.set_title_widget(Adw.WindowTitle(title=_t("app_title")))
        self.toolbar_view.add_top_bar(header_bar)

        # Main Layout Box
        main_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=12,
            margin_top=16,
            margin_bottom=18,
            margin_start=24,
            margin_end=24,
            valign=Gtk.Align.CENTER
        )
        self.toolbar_view.set_content(main_box)

        # 1. Icon Badge
        badge = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        badge.set_halign(Gtk.Align.CENTER)
        badge.set_valign(Gtk.Align.CENTER)
        badge.set_size_request(68, 68)
        badge.add_css_class("icon-badge")

        icon_img = Gtk.Image.new_from_icon_name("system-software-install-symbolic")
        icon_img.set_pixel_size(36)
        icon_img.set_halign(Gtk.Align.CENTER)
        icon_img.set_valign(Gtk.Align.CENTER)
        icon_img.set_hexpand(True)
        icon_img.set_vexpand(True)
        badge.append(icon_img)
        main_box.append(badge)

        # 2. Package Name & Type
        self.name_label = Gtk.Label()
        self.name_label.add_css_class("title-3")
        self.name_label.set_wrap(True)
        self.name_label.set_justify(Gtk.Justification.CENTER)
        self.name_label.set_ellipsize(3) # PANGO_ELLIPSIZE_END
        main_box.append(self.name_label)

        self.info_label = Gtk.Label()
        self.info_label.add_css_class("body")
        self.info_label.add_css_class("dim-label")
        self.info_label.set_wrap(True)
        self.info_label.set_justify(Gtk.Justification.CENTER)
        main_box.append(self.info_label)

        # 3. Status area with spinner
        status_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8,
            halign=Gtk.Align.CENTER,
            margin_top=6,
            margin_bottom=4
        )
        self.spinner = Gtk.Spinner()
        self.spinner.set_visible(False)
        status_box.append(self.spinner)

        self.status_label = Gtk.Label(label=_t("status_ready"))
        self.status_label.set_wrap(True)
        self.status_label.set_justify(Gtk.Justification.CENTER)
        self.status_label.add_css_class("body")
        status_box.append(self.status_label)
        main_box.append(status_box)

        # 4. Action Buttons Box
        btn_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=12,
            halign=Gtk.Align.CENTER,
            margin_top=10
        )
        self.cancel_btn = Gtk.Button(label=_t("btn_cancel"))
        self.cancel_btn.set_size_request(110, 36)
        self.cancel_btn.connect("clicked", lambda b: self.close())
        btn_box.append(self.cancel_btn)

        self.install_btn = Gtk.Button(label=_t("btn_install"))
        self.install_btn.set_size_request(130, 36)
        self.install_btn.add_css_class("suggested-action")
        self.install_btn.connect("clicked", self.on_install_clicked)
        btn_box.append(self.install_btn)
        main_box.append(btn_box)

        self.inspect_package()

    def apply_custom_css(self):
        css = """
        button {
            border-radius: 10px;
        }
        .icon-badge {
            background-color: alpha(@accent_bg_color, 0.14);
            color: @accent_color;
            border-radius: 9999px;
        }
        .status-success {
            color: #2ec27e;
            font-weight: 600;
        }
        .status-error {
            color: #c01c28;
            font-size: 0.88em;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_string(css)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def inspect_package(self):
        if not self.pkg_path or not os.path.isfile(self.pkg_path):
            self.name_label.set_text(_t("err_no_file"))
            self.info_label.set_text("")
            self.install_btn.set_sensitive(False)
            self.status_label.set_text("")
            return

        filename = os.path.basename(self.pkg_path)
        self.name_label.set_text(filename)

        lower = filename.lower()
        if lower.endswith(".rpm"):
            pkg_type_str = _t("pkg_type_rpm")
        elif lower.endswith(".deb"):
            pkg_type_str = _t("pkg_type_deb")
        else:
            pkg_type_str = _t("pkg_type_unknown")
            self.install_btn.set_sensitive(False)
            self.status_label.set_text(_t("err_unsupported"))
            self.status_label.add_css_class("status-error")
            return

        try:
            size_mb = os.path.getsize(self.pkg_path) / (1024 * 1024)
            size_str = f"{size_mb:.1f} MB" if size_mb >= 1.0 else f"{int(size_mb * 1024)} KB"
            self.info_label.set_text(f"{pkg_type_str} • {size_str}")
        except Exception:
            self.info_label.set_text(pkg_type_str)

    def on_install_clicked(self, btn):
        if self._is_installing:
            return
        self._is_installing = True
        self.install_btn.set_sensitive(False)
        self.cancel_btn.set_sensitive(False)
        self.spinner.set_visible(True)
        self.spinner.start()
        self.status_label.remove_css_class("status-error")
        self.status_label.remove_css_class("status-success")

        threading.Thread(target=self._run_install_thread, daemon=True).start()

    def _update_status(self, text):
        self.status_label.set_text(text)

    def _on_finished(self, success, message):
        self._is_installing = False
        self.spinner.stop()
        self.spinner.set_visible(False)

        if success:
            self.status_label.set_text(message)
            self.status_label.add_css_class("status-success")
            self.install_btn.set_visible(False)
            self.cancel_btn.set_label(_t("btn_close"))
            self.cancel_btn.set_sensitive(True)
            self.cancel_btn.add_css_class("suggested-action")
            self.toast_overlay.add_toast(Adw.Toast.new(_t("status_success")))
        else:
            err_str = _t("status_error").format(error=message)
            self.status_label.set_text(err_str)
            self.status_label.add_css_class("status-error")
            self.install_btn.set_sensitive(True)
            self.cancel_btn.set_sensitive(True)

    def _run_install_thread(self):
        abs_pkg_path = self.pkg_path
        lower = abs_pkg_path.lower()
        is_rpm = lower.endswith(".rpm")
        is_deb = lower.endswith(".deb")

        if is_rpm:
            box_name = "sadeem-box"
            image_name = "registry.fedoraproject.org/fedora-toolbox:latest"
        elif is_deb:
            box_name = "sadeem-deb-box"
            image_name = "quay.io/toolbx-images/ubuntu-toolbox:latest"
        else:
            GLib.idle_add(self._on_finished, False, _t("err_unsupported"))
            return

        # 1. Check if container exists, create if not
        GLib.idle_add(self._update_status, _t("status_init_box").format(box=box_name))
        try:
            list_res = subprocess.run(["distrobox", "list"], capture_output=True, text=True, check=False)
            if box_name not in list_res.stdout:
                cr_res = subprocess.run(
                    ["distrobox", "create", "--name", box_name, "--image", image_name, "--yes"],
                    capture_output=True,
                    text=True,
                    check=False
                )
                if cr_res.returncode != 0:
                    err = cr_res.stderr.strip() or cr_res.stdout.strip() or "Container creation failed"
                    GLib.idle_add(self._on_finished, False, err)
                    return
        except Exception as e:
            GLib.idle_add(self._on_finished, False, str(e))
            return

        # 2. Get desktop files inside container before installation
        def get_container_desktops():
            cmd = ["distrobox", "enter", box_name, "--", "bash", "-c", "find /usr/share/applications /usr/local/share/applications -name '*.desktop' 2>/dev/null"]
            try:
                res = subprocess.run(cmd, capture_output=True, text=True, check=False)
                desks = set()
                for line in res.stdout.splitlines():
                    line = line.strip()
                    if line.endswith(".desktop"):
                        desks.add(os.path.basename(line))
                return desks
            except Exception:
                return set()

        pre_desktops = get_container_desktops()

        # 3. Run installation command
        GLib.idle_add(self._update_status, _t("status_installing"))
        try:
            if is_rpm:
                install_cmd = [
                    "distrobox", "enter", box_name, "--",
                    "sudo", "dnf", "install", "-y", abs_pkg_path
                ]
            else:
                install_cmd = [
                    "distrobox", "enter", box_name, "--",
                    "sudo", "bash", "-c",
                    'apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y "$1"',
                    "_", abs_pkg_path
                ]

            res = subprocess.run(install_cmd, capture_output=True, text=True, check=False)
            if res.returncode != 0:
                raw_err = res.stderr.strip() or res.stdout.strip()
                lines = raw_err.splitlines()
                err_summary = "\n".join(lines[-6:]) if len(lines) > 6 else raw_err
                GLib.idle_add(self._on_finished, False, err_summary or "Process exited with error")
                return
        except Exception as e:
            GLib.idle_add(self._on_finished, False, str(e))
            return

        # 4. Check for newly installed desktop files & export them
        GLib.idle_add(self._update_status, _t("status_exporting"))
        post_desktops = get_container_desktops()
        new_desktops = post_desktops - pre_desktops

        for desk in new_desktops:
            subprocess.run(
                ["distrobox", "enter", box_name, "--", "distrobox-export", "--app", desk],
                capture_output=True,
                text=True,
                check=False
            )

        # 5. Clean up package manager cache
        try:
            if is_rpm:
                subprocess.run(
                    ["distrobox", "enter", box_name, "--", "sudo", "dnf", "clean", "all"],
                    capture_output=True,
                    text=True,
                    check=False
                )
            else:
                subprocess.run(
                    ["distrobox", "enter", box_name, "--", "sudo", "apt-get", "clean"],
                    capture_output=True,
                    text=True,
                    check=False
                )
        except Exception:
            pass

        GLib.idle_add(self._on_finished, True, _t("status_success"))


class SadeemPkgInstallerApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="org.sadeem.PackageInstaller",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.pkg_arg = None
        self.window = None

    def do_command_line(self, command_line):
        args = command_line.get_arguments()
        # args[0] is executable name, args[1] is file if passed
        if len(args) > 1:
            self.pkg_arg = args[1]
        self.activate()
        return 0

    def do_activate(self):
        if LANG in ("ar", "ur"):
            Gtk.Widget.set_default_direction(Gtk.TextDirection.RTL)
        if not self.window:
            self.window = SadeemPkgInstallerWindow(self, pkg_path=self.pkg_arg)
        self.window.present()


def main():
    pkg_from_sys = sys.argv[1] if len(sys.argv) > 1 else None
    app = SadeemPkgInstallerApp()
    if pkg_from_sys:
        app.pkg_arg = pkg_from_sys
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
