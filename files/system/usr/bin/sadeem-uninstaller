#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Sadeem Uninstaller (أداة إلغاء التثبيت الموحدة لنظام سديم)
Unified uninstaller for Sadeem OS supporting Flatpak, user desktop apps/Distrobox/AppImage,
and layered rpm-ostree packages.
"""

import sys
import os
import re
import json
import subprocess
import threading
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio


def resolve_app_info(target):
    """
    Resolves target app id / desktop path into:
    (app_id, can_uninstall, app_type, display_name, icon_name, desktop_path)
    """
    clean_target = target.strip()
    desktop_name = os.path.basename(clean_target)
    if not desktop_name.endswith('.desktop'):
        desktop_name += '.desktop'
    app_id = desktop_name[:-8]

    can_uninstall = False
    app_type = 'system_core'
    display_name = app_id
    icon_name = 'application-x-executable'
    desktop_path = None

    # Search possible desktop paths
    potential_paths = [
        os.path.expanduser(f'~/.local/share/applications/{desktop_name}'),
        f'/var/lib/flatpak/exports/share/applications/{desktop_name}',
        os.path.expanduser(f'~/.local/share/flatpak/exports/share/applications/{desktop_name}'),
        f'/usr/share/applications/{desktop_name}',
    ]
    if os.path.isabs(clean_target) and os.path.exists(clean_target):
        potential_paths.insert(0, clean_target)

    for p in potential_paths:
        if os.path.exists(p):
            desktop_path = p
            break

    # Read desktop metadata if file exists
    if desktop_path and os.path.exists(desktop_path):
        try:
            kf = GLib.KeyFile()
            kf.load_from_file(desktop_path, GLib.KeyFileFlags.NONE)
            if kf.has_group('Desktop Entry'):
                # Try Arabic name first, then generic Name
                try:
                    display_name = kf.get_locale_string('Desktop Entry', 'Name', 'ar')
                except Exception:
                    display_name = kf.get_string('Desktop Entry', 'Name')
                try:
                    icon_name = kf.get_string('Desktop Entry', 'Icon')
                except Exception:
                    pass
        except Exception:
            pass

    # 1. Flatpak Check
    try:
        res = subprocess.run(
            ['flatpak', 'info', app_id],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        if res.returncode == 0:
            can_uninstall = True
            app_type = 'flatpak'
            return app_id, can_uninstall, app_type, display_name, icon_name, desktop_path
    except Exception:
        pass

    # 2. User local applications Check (~/.local/share/applications)
    user_apps_dir = os.path.expanduser('~/.local/share/applications')
    if desktop_path and desktop_path.startswith(user_apps_dir):
        can_uninstall = True
        app_type = 'user_app'
        return app_id, can_uninstall, app_type, display_name, icon_name, desktop_path

    # 3. Layered rpm-ostree Check
    try:
        out = subprocess.check_output(['rpm-ostree', 'status', '--json'], stderr=subprocess.DEVNULL)
        data = json.loads(out)
        deployments = data.get('deployments', [])
        if deployments:
            req_pkgs = set(deployments[0].get('requested-packages', [])) | set(deployments[0].get('layered-packages', []))
            if desktop_path and req_pkgs:
                rpm_res = subprocess.run(['rpm', '-qf', desktop_path], capture_output=True, text=True)
                if rpm_res.returncode == 0:
                    pkg_str = rpm_res.stdout.strip()
                    for p in req_pkgs:
                        if pkg_str.startswith(p):
                            can_uninstall = True
                            app_type = 'rpm_ostree_layered'
                            return app_id, can_uninstall, app_type, display_name, icon_name, desktop_path
    except Exception:
        pass

    # Core system app
    return app_id, False, 'system_core', display_name, icon_name, desktop_path


class SadeemUninstallerWindow(Adw.ApplicationWindow):
    def __init__(self, app, target_info):
        super().__init__(application=app, title="إلغاء التثبيت")
        self.target_info = target_info
        app_id, can_uninstall, app_type, display_name, icon_name, desktop_path = target_info

        self.set_default_size(440, 480)
        self.set_modal(True)

        # Main Layout Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        # Header Bar
        header = Adw.HeaderBar()
        header.set_show_end_title_buttons(True)
        main_box.append(header)

        # Clamp container
        clamp = Adw.Clamp(maximum_size=420)
        clamp.set_margin_top(16)
        clamp.set_margin_bottom(24)
        clamp.set_margin_start(16)
        clamp.set_margin_end(16)
        main_box.append(clamp)

        # Content Box
        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        clamp.set_child(self.content_box)

        # App Icon
        icon_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        icon_box.set_halign(Gtk.Align.CENTER)
        img = Gtk.Image()
        img.set_pixel_size(72)
        if Gtk.IconTheme.get_for_display(Gdk.Display.get_default() if 'Gdk' in globals() else Gtk.Widget.get_display(self)).has_icon(icon_name):
            img.set_from_icon_name(icon_name)
        elif os.path.exists(icon_name):
            img.set_from_file(icon_name)
        else:
            img.set_from_icon_name("application-x-executable")
        icon_box.append(img)

        # App Title & Subtitle
        title_label = Gtk.Label(label=display_name)
        title_label.add_css_class("title-2")
        title_label.set_halign(Gtk.Align.CENTER)
        icon_box.append(title_label)

        id_label = Gtk.Label(label=app_id)
        id_label.add_css_class("dim-label")
        id_label.add_css_class("caption")
        id_label.set_halign(Gtk.Align.CENTER)
        icon_box.append(id_label)

        self.content_box.append(icon_box)

        if not can_uninstall:
            # Cannot uninstall warning
            status_page = Adw.StatusPage()
            status_page.set_icon_name("dialog-warning-symbolic")
            status_page.set_title("تطبيق نظام أساسي")
            status_page.set_description("هذا التطبيق جزء لا يتجزأ من نظام سديم الأساسي ولا يمكن إزالته لحماية استقرار النظام.")
            self.content_box.append(status_page)

            close_btn = Gtk.Button(label="إغلاق")
            close_btn.set_halign(Gtk.Align.CENTER)
            close_btn.connect("clicked", lambda b: self.close())
            self.content_box.append(close_btn)
            return

        # Confirmation question
        prompt_label = Gtk.Label(
            label="هل أنت متأكد من رغبتك في إلغاء تثبيت هذا التطبيق نهائياً من نظامك؟"
        )
        prompt_label.set_wrap(True)
        prompt_label.set_justify(Gtk.Justification.CENTER)
        prompt_label.add_css_class("body")
        self.content_box.append(prompt_label)

        # Options group (for Flatpak: delete data)
        self.delete_data_switch = None
        if app_type == 'flatpak':
            pref_group = Adw.PreferencesGroup()
            self.delete_data_switch = Adw.SwitchRow()
            self.delete_data_switch.set_title("حذف بيانات التطبيق وإعداداته")
            self.delete_data_switch.set_subtitle("إزالة كافة الملفات المحفوظة والإعدادات من مجلدك الشخصي")
            self.delete_data_switch.set_active(False)
            pref_group.add(self.delete_data_switch)
            self.content_box.append(pref_group)

        # Progress / Status area (hidden initially)
        self.progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.progress_box.set_visible(False)
        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(32, 32)
        self.progress_box.append(self.spinner)
        self.progress_label = Gtk.Label(label="جاري إلغاء التثبيت...")
        self.progress_label.add_css_class("dim-label")
        self.progress_box.append(self.progress_label)
        self.content_box.append(self.progress_box)

        # Action Buttons
        self.btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.btn_box.set_halign(Gtk.Align.CENTER)
        self.btn_box.set_margin_top(12)

        self.cancel_btn = Gtk.Button(label="إلغاء")
        self.cancel_btn.set_size_request(120, -1)
        self.cancel_btn.connect("clicked", lambda b: self.close())
        self.btn_box.append(self.cancel_btn)

        self.uninstall_btn = Gtk.Button(label="إلغاء التثبيت")
        self.uninstall_btn.set_size_request(140, -1)
        self.uninstall_btn.add_css_class("destructive-action")
        self.uninstall_btn.connect("clicked", self.on_start_uninstall)
        self.btn_box.append(self.uninstall_btn)

        self.content_box.append(self.btn_box)

    def on_start_uninstall(self, btn):
        self.cancel_btn.set_sensitive(False)
        self.uninstall_btn.set_sensitive(False)
        self.uninstall_btn.set_visible(False)
        if self.delete_data_switch:
            self.delete_data_switch.set_sensitive(False)

        self.progress_box.set_visible(True)
        self.spinner.start()

        threading.Thread(target=self._run_uninstall_worker, daemon=True).start()

    def _run_uninstall_worker(self):
        app_id, can_uninstall, app_type, display_name, icon_name, desktop_path = self.target_info
        success = False
        error_msg = ""

        try:
            if app_type == 'flatpak':
                cmd = ['flatpak', 'uninstall', '-y']
                if self.delete_data_switch and self.delete_data_switch.get_active():
                    cmd.append('--delete-data')
                cmd.append(app_id)
                res = subprocess.run(cmd, capture_output=True, text=True)
                if res.returncode == 0:
                    success = True
                else:
                    error_msg = res.stderr or res.stdout or "فشلت عملية إزالة حزمة Flatpak"

            elif app_type == 'user_app':
                # Remove user desktop file and related files
                if desktop_path and os.path.exists(desktop_path):
                    os.remove(desktop_path)
                # If distrobox app
                subprocess.run(['distrobox-export', '--delete', app_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(['update-desktop-database', os.path.expanduser('~/.local/share/applications')], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                success = True

            elif app_type == 'rpm_ostree_layered':
                # Find package name
                rpm_res = subprocess.run(['rpm', '-qf', desktop_path], capture_output=True, text=True)
                if rpm_res.returncode == 0:
                    pkg = rpm_res.stdout.strip().split('-')[0]
                    res = subprocess.run(['pkexec', 'rpm-ostree', 'uninstall', pkg], capture_output=True, text=True)
                    if res.returncode == 0:
                        success = True
                    else:
                        error_msg = res.stderr or "فشلت عملية إزالة الحزمة عبر rpm-ostree"
                else:
                    error_msg = "تعذر تحديد الحزمة المسؤولة عن هذا التطبيق"

        except Exception as e:
            error_msg = str(e)

        GLib.idle_add(self._on_uninstall_finished, success, error_msg)

    def _on_uninstall_finished(self, success, error_msg):
        self.spinner.stop()
        self.progress_box.set_visible(False)

        if success:
            self.progress_label.set_text("تم إلغاء تثبيت التطبيق بنجاح ✓")
            self.progress_label.remove_css_class("dim-label")
            self.progress_label.add_css_class("success")
            self.progress_box.set_visible(True)

            self.cancel_btn.set_visible(False)
            done_btn = Gtk.Button(label="تم")
            done_btn.set_size_request(140, -1)
            done_btn.add_css_class("suggested-action")
            done_btn.connect("clicked", lambda b: self.close())
            self.btn_box.append(done_btn)
        else:
            self.progress_label.set_text(f"تعذر إلغاء التثبيت:\n{error_msg}")
            self.progress_label.remove_css_class("dim-label")
            self.progress_label.add_css_class("error")
            self.progress_box.set_visible(True)

            self.cancel_btn.set_sensitive(True)
            self.cancel_btn.set_label("إغلاق")


class SadeemUninstallerApp(Adw.Application):
    def __init__(self, target_info):
        super().__init__(application_id="os.sadeem.Uninstaller", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.target_info = target_info

    def do_activate(self):
        win = SadeemUninstallerWindow(self, self.target_info)
        win.present()


def main():
    if len(sys.argv) < 2:
        print("الاستخدام: sadeem-uninstaller <معرف-التطبيق أو مسار desktop>")
        print("الخيارات:  sadeem-uninstaller --can-uninstall <معرف-التطبيق>")
        sys.exit(2)

    if sys.argv[1] == '--can-uninstall':
        if len(sys.argv) < 3:
            sys.exit(1)
        target = sys.argv[2]
        app_id, can_uninstall, app_type, display_name, icon_name, desktop_path = resolve_app_info(target)
        sys.exit(0 if can_uninstall else 1)

    target = sys.argv[1]
    target_info = resolve_app_info(target)

    app = SadeemUninstallerApp(target_info)
    app.run(None)


if __name__ == '__main__':
    main()
